+#[test]
+fn current_can_change_after_start_and_be_cleared() {
+    let _guard = serial();
+    clear_current();
+    assert!(super::super::current().is_none());
+    super::super::set_current(AuthSession::new("First", 1, "token-one"));
+    super::super::set_current(AuthSession::new("Second", 2, "token-two"));
+    let current = super::super::current().unwrap();
+    assert_eq!((current.name.as_str(), current.uuid), ("Second", 2));
+    assert!(!format!("{current:?}").contains("token-two"));
+    super::super::clear_current();
+    assert!(super::super::current().is_none());
+}

+    };
+    let store = EncryptedStore::new(&dir, "1234").unwrap();
+    assert!(store.persistent());
+    save(&store, &signed).unwrap();
+
+    let bytes = fs::read(dir.join(AUTH_FILE)).unwrap();
+    for secret in ["ms-refresh-1", "mc-token", "Notch"] {
+        assert!(
+            !bytes
+                .windows(secret.len())
+                .any(|window| window == secret.as_bytes()),
+            "{secret} must not be readable on the SD card"
+        );
+    }
+    assert!(!store.get(STORE_KEY).unwrap().unwrap().is_empty());
+
+    // The same PIN and device key open it.
+    let reopened = EncryptedStore::new(&dir, "1234").unwrap();
+    let text = reopened.get(STORE_KEY).unwrap().unwrap();
+    let record: SavedRecord = serde_json::from_str(&text).unwrap();
+    assert_eq!(record.account, sample_account());
+    assert_eq!(record.secrets.refresh_token, "ms-refresh-1");
+
+    // Another PIN (or a record from another install) is refused, not ignored.
+    let wrong = EncryptedStore::new(&dir, "9999").unwrap();
+    assert!(wrong.get(STORE_KEY).unwrap_err().contains("wrong PIN"));
+
+    // No PIN means memory only, with the warning the UI shows.
+    let memory = open_store_in(&dir, None);
+    assert!(!memory.persistent());
+    assert!(NO_SECURE_STORAGE.contains("No PIN"));
+    let _ = fs::remove_dir_all(&dir);
+}

+#[test]
+fn sign_out_clears_the_session_and_the_file() {
+    let _guard = serial();
+    let dir = temp_dir("sign-out");
+    let store = EncryptedStore::new(&dir, "1234").unwrap();
+    let signed = SignedIn {
+        account: sample_account(),
+        secrets: sample_secrets(now() + 7200),
+    };
+    save(&store, &signed).unwrap();
+    load_saved_at(&store, Endpoints::live()).unwrap();
+    assert!(super::super::current().is_some());
+    sign_out(&store).unwrap();
+    assert!(super::super::current().is_none());
+    assert_eq!(store.get(STORE_KEY).unwrap(), None);
+    assert!(!dir.join(AUTH_FILE).exists());
+    let _ = fs::remove_dir_all(&dir);
+}

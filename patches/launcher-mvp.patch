+/// Where the launcher's dashboard cards sit, in GUI pixels. The panel grows
+/// with the screen up to 420 pixels so the cards stay readable on a TV and
+/// fit the 480x262 minimum the title screen is tested at.
+#[derive(Clone, Copy, Debug)]
+struct Dashboard {
+    panel: [f32; 4],
+    play: [f32; 4],
+    worlds: [f32; 4],
+    account: [f32; 4],
+    mods: [f32; 4],
+    settings: [f32; 4],
+    quit: [f32; 4],
+}
+fn dashboard(w: f32, h: f32) -> Dashboard {
+    let (w, h) = (w.ceil(), h.ceil());
+    let panel_w = (w * 0.56).clamp(300.0, 420.0).min((w - 16.0).max(280.0));
+    // Leave the bottom line for the version and the notice; never cover the
+    // logo and edition banner (they end at 81). On a very short window the
+    // cards get shorter instead of moving up over the logo.
+    let panel_h = (h - 84.0 - 14.0).clamp(144.0, 170.0);
+    let x = ((w - panel_w) / 2.0).floor();
+    let y = (h * 0.28)
+        .floor()
+        .clamp(84.0, (h - panel_h - 4.0).max(84.0));
+    let left = x + 10.0;
+    let inner = panel_w - 20.0;
+    let gap = 8.0;
+    let big = (inner * 0.63).floor();
+    let row1_y = y + 24.0;
+    let row1_h = if panel_h >= 168.0 {
+        44.0
+    } else if panel_h >= 150.0 {
+        38.0
+    } else {
+        34.0
+    };
+    let row2_y = row1_y + row1_h + gap;
+    let row2_h = if panel_h >= 168.0 {
+        32.0
+    } else if panel_h >= 150.0 {
+        28.0
+    } else {
+        24.0
+    };
+    let row2_w = ((inner - gap) / 2.0).floor();
+    let row3_y = row2_y + row2_h + 6.0;
+    let row3_h = row2_h;
+    Dashboard {
+        panel: [x, y, panel_w, panel_h],
+        play: [left, row1_y, big, row1_h],
+        worlds: [left + big + gap, row1_y, inner - big - gap, row1_h],
+        account: [left, row2_y, row2_w, row2_h],
+        mods: [left + row2_w + gap, row2_y, inner - row2_w - gap, row2_h],
+        settings: [left, row3_y, big, row3_h],
+        quit: [left + big + gap, row3_y, inner - big - gap, row3_h],
+    }
+}
+
+/// The settings screen's one text field (offline name).
+fn name_field_rect(w: f32) -> [f32; 4] {
+    [(w.ceil() / 2.0).floor() - 100.0, 86.0, 200.0, 20.0]
+}

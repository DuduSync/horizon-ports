+/// The name kept in `dir`, if the file exists and holds a valid one.
+pub fn load(dir: &Path) -> Option<String> {
+    fs::read_to_string(dir.join(FILE))
+        .ok()
+        .and_then(|text| parse(&text))
+}
+
+/// Keep `name` in `dir` for the next run. An invalid name is refused;
+/// the caller shows the reason instead of writing a name the game would
+/// silently replace.
+pub fn save(dir: &Path, name: &str) -> std::io::Result<()> {
+    if !is_valid(name) {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidInput,
+            "player names are 1 to 16 printable ASCII characters, without spaces",
+        ));
+    }
+    fs::write(dir.join(FILE), format!("{KEY}{name}\n"))
+}
+
 fn parse(text: &str) -> Option<String> {
     text.lines()
         .find_map(|line| line.trim_end_matches('\r').strip_prefix(KEY))

+//! The integrated launcher: the Switch dashboard's strings, its capability
+//! flags and the offline player name it edits.
+//!
+//! The dashboard itself is `title::Mode::Main`; it reuses the title screen's
+//! renderer and input rather than a second UI stack. Keeping the strings and
+//! paths here leaves `title.rs` about layout and lets the account screen
+//! (phase 2) and the mods page (phase 3) grow without touching it.
+use std::path::{Path, PathBuf};
+
+/// Whether this build links sound output (`--features audio`).
+pub const HAS_AUDIO: bool = cfg!(feature = "audio");
+/// Whether this build runs code mods (`--features mods`; wasmtime/cranelift).
+pub const HAS_MODS: bool = cfg!(feature = "mods");
+
+/// The one profile the MVP has. Profiles are a later phase: switching one
+/// takes a restart, so the dashboard only shows its name.
+pub const PROFILE: &str = "default";
+

+/// The launcher's own strings, in the language the game loaded.
+///
+/// The resource pack may lack some vanilla keys, but these are compiled in,
+/// so the dashboard is readable even before a pack is selected.
+pub fn tr(key: &'static str) -> &'static str {
+    let table = if is_pt_br() { PT_BR } else { EN_US };
+    table
+        .iter()
+        .find_map(|(k, v)| (*k == key).then_some(*v))
+        .unwrap_or(key)
+}
+
+/// Whether the current language is Brazilian Portuguese.
+pub fn is_pt_br() -> bool {
+    let code = crate::lang::code();
+    code.eq_ignore_ascii_case("pt_br") || code.eq_ignore_ascii_case("pt-br")
+}
+
+/// The language the launcher offers to switch to.
+pub fn other_language() -> &'static str {
+    if is_pt_br() { "en_us" } else { "pt_br" }
+}
+
+/// The language the game loads on first boot: the one `options.txt` keeps,
+/// or Brazilian Portuguese when it has none and the resources ship it, else
+/// English.
+pub fn preferred_language(root: &Path, configured: &str) -> String {
+    if !configured.is_empty() {
+        return configured.to_owned();
+    }
+    if root.join("assets/minecraft/lang/pt_br.json").is_file() {
+        "pt_br".to_owned()
+    } else {
+        crate::lang::DEFAULT.to_owned()
+    }
+}
+
+/// The offline player name file, next to `options.txt`.
+pub fn player_path(home: &Path) -> PathBuf {
+    home.join(crate::offline_name::FILE)
+}
+
+/// The name the game will join with, created on first use so the dashboard
+/// and the world agree on it.
+pub fn player_name(home: &Path) -> String {
+    crate::offline_name::load_or_create(home)
+}
+
+/// The name to show before the player starts a world: the one on disk, or a
+/// generated one that is only written when it is used.
+pub fn player_name_preview(home: &Path) -> String {
+    crate::offline_name::load(home).unwrap_or_else(|| crate::offline_name::generate(0))
+}
+
+/// Persist the name the game reads when it opens a world.
+pub fn save_player_name(home: &Path, name: &str) -> std::io::Result<()> {
+    crate::offline_name::save(home, name)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn every_key_has_both_translations() {
+        for (key, _) in PT_BR {
+            assert!(
+                EN_US.iter().any(|(k, _)| k == key),
+                "missing en_us for {key}"
+            );
+        }
+        for (key, _) in EN_US {
+            assert!(
+                PT_BR.iter().any(|(k, _)| k == key),
+                "missing pt_br for {key}"
+            );
+        }
+    }
+
+    #[test]
+    fn player_name_round_trips_through_the_file() {
+        let dir =
+            std::env::temp_dir().join(format!("horizon-launcher-name-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&dir);
+        std::fs::create_dir_all(&dir).unwrap();
+        save_player_name(&dir, "Dudu_2").unwrap();
+        assert_eq!(player_name(&dir), "Dudu_2");
+        assert_eq!(
+            std::fs::read_to_string(player_path(&dir)).unwrap(),
+            "name:Dudu_2\n"
+        );
+        assert!(save_player_name(&dir, "has space").is_err());
+        assert_eq!(player_name(&dir), "Dudu_2");
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+
+    #[test]
+    fn first_boot_prefers_pt_br_only_when_the_resources_ship_it() {
+        let dir =
+            std::env::temp_dir().join(format!("horizon-launcher-lang-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&dir);
+        std::fs::create_dir_all(dir.join("assets/minecraft/lang")).unwrap();
+        std::fs::write(dir.join("assets/minecraft/lang/pt_br.json"), "{}").unwrap();
+        assert_eq!(preferred_language(&dir, ""), "pt_br");
+        // An explicit setting always wins, even English over a pt-BR pack.
+        assert_eq!(preferred_language(&dir, "en_us"), "en_us");
+        let _ = std::fs::remove_dir_all(&dir);
+        assert_eq!(preferred_language(&dir, ""), crate::lang::DEFAULT);
+    }
+}

+/// A launcher card: a nine-slice button with a left-aligned label and, when
+/// there is room, a dim second line. It registers the same widget and focus
+/// target a vanilla button does, so the existing pad/mouse/touch paths work.
+fn draw_card(atlas: &HudAtlas, batch: &mut HudBatch, cursor: (f32, f32), b: &Button) {
+    crate::widgets::record(&b.label, [b.x, b.y, b.w, b.h], b.enabled);
+    let hover = b.enabled
+        && cursor.0 >= b.x
+        && cursor.0 < b.x + b.w
+        && cursor.1 >= b.y
+        && cursor.1 < b.y + b.h;
+    crate::widgets::widget_cursor(hover, b.enabled);
+    crate::widgets::target([b.x, b.y, b.w, b.h]);
+    let sprite = if !b.enabled {
+        "gui/sprites/widget/button_disabled"
+    } else if b.id == 1 || hover {
+        "gui/sprites/widget/button_highlighted"
+    } else {
+        "gui/sprites/widget/button"
+    };
+    crate::ui::nine_slice(batch, atlas, sprite, b.x, b.y, b.w, b.h, u32::MAX);
+    let color = if b.enabled {
+        rgba(255, 255, 255, 255)
+    } else {
+        rgba(160, 160, 160, 255)
+    };
+    let tall = b.h >= 40.0;
+    batch.text(
+        atlas,
+        &b.label,
+        b.x + 10.0,
+        b.y + if tall { 9.0 } else { 5.0 },
+        color,
+        true,
+    );
+    if let Some(subtitle) = &b.subtitle
+        && !subtitle.is_empty()
+    {
+        let subtitle = truncated(atlas, subtitle, b.w - 20.0);
+        batch.text(
+            atlas,
+            &subtitle,
+            b.x + 10.0,
+            b.y + if tall { 24.0 } else { 17.0 },
+            rgba(175, 175, 175, 255),
+            true,
+        );
+    }
+}
+/// `text` cut to `width` with an ellipsis (card subtitles are one line).
+fn truncated(atlas: &HudAtlas, text: &str, width: f32) -> String {
+    if HudBatch::text_width(atlas, text) <= width {
+        return text.to_owned();
+    }
+    let mut out = String::new();
+    for ch in text.chars() {
+        let mut candidate = out.clone();
+        candidate.push(ch);
+        candidate.push('…');
+        if HudBatch::text_width(atlas, &candidate) > width {
+            break;
+        }
+        out.push(ch);
+    }
+    out.push('…');
+    out
+}

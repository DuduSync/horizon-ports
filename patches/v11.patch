+    fn draw_mods(
+        &self,
+        atlas: &HudAtlas,
+        batch: &mut HudBatch,
+        cursor: (f32, f32),
+        w: f32,
+        h: f32,
+    ) {
+        let (x, cw) = content(w);
+        let over = |r: [f32; 4]| {
+            cursor.0 >= r[0]
+                && cursor.0 < r[0] + r[2]
+                && cursor.1 >= r[1]
+                && cursor.1 < r[1] + r[3]
+        };
+        let y = 232.0;
+        let warning = if cfg!(feature = "mods") {
+            tr("mods_shader")
+        } else {
+            tr("mods_warning")
+        };
+        for (i, line) in wrap(atlas, F_SMALL, warning, cw).iter().take(2).enumerate() {
+            draw_text_top(batch, atlas, F_SMALL, line, x, y + i as f32 * 18.0, WARN);
+        }
+        if self.mods_tab == ModsTab::Browse {
+            self.draw_search_field(atlas, batch, w);
+            let per = self.page_size(h);
+            let projects = self.filtered_projects();
+            if self.index.is_none() {
+                draw_text_top(batch, atlas, F_BODY, &self.index_status, x, 286.0, MUTED);
+            } else {
+                for (i, project) in projects.iter().skip(self.page * per).take(per).enumerate() {
+                    let row = mods_row_rect(x, cw, 286.0 + i as f32 * 80.0);
+                    // The pad focuses the whole row; A clicks it.
+                    crate::widgets::target_as(row, crate::widgets::Kind::Row);
+                    let hovered = over(row);
+                    panel(
+                        batch,
+                        atlas,
+                        row,
+                        if hovered { SURFACE_2 } else { SURFACE },
+                        if hovered { ACCENT } else { BORDER },
+                    );
+                    let version = project.versions.first();
+                    let title = format!(
+                        "{}  {}",
+                        project.name,
+                        version.map_or_else(|| "-".into(), |v| v.version.clone())
+                    );
+                    draw_text_top(
+                        batch,
+                        atlas,
+                        F_LABEL,
+                        &truncate(atlas, F_LABEL, &title, row[2] - 110.0),
+                        row[0] + 10.0,
+                        row[1] + 4.0,
+                        TEXT,
+                    );
+                    let meta = format!(
+                        "{} · {}",
+                        Self::kind_label(&project.kind),
+                        format_size(version.map_or(0, |v| v.file.size))
+                    );
+                    draw_text_top(
+                        batch,
+                        atlas,
+                        F_SMALL,
+                        &truncate(atlas, F_SMALL, &meta, row[2] - 120.0),
+                        row[0] + 10.0,
+                        row[1] + 30.0,
+                        MUTED,
+                    );
+                    draw_text_top(
+                        batch,
+                        atlas,
+                        F_SMALL,
+                        &truncate(atlas, F_SMALL, &project.summary, row[2] - 120.0),
+                        row[0] + 10.0,
+                        row[1] + 50.0,
+                        rgba(120, 132, 146, 255),
+                    );
+                }
+                if projects.is_empty() {
+                    draw_text_top(batch, atlas, F_BODY, tr("mods_no_items"), x, 286.0, MUTED);
+                }
+            }
+            draw_text_top(
+                batch,
+                atlas,
+                F_SMALL,
+                &self.index_status,
+                x,
+                h - 50.0,
+                MUTED,
+            );
+        } else {
+            let per = self.page_size(h);
+            if self.installed.is_empty() {
+                draw_text_top(batch, atlas, F_BODY, tr("mods_no_items"), x, 286.0, MUTED);
+            }
+            for (i, item) in self
+                .installed
+                .iter()
+                .skip(self.page * per)
+                .take(per)
+                .enumerate()
+            {
+                let row = mods_row_rect(x, cw, 286.0 + i as f32 * 80.0);
+                crate::widgets::target_as(row, crate::widgets::Kind::Row);
+                let hovered = over(row);
+                panel(
+                    batch,
+                    atlas,
+                    row,
+                    if hovered { SURFACE_2 } else { SURFACE },
+                    if hovered { ACCENT } else { BORDER },
+                );
+                draw_text_top(
+                    batch,
+                    atlas,
+                    F_LABEL,
+                    &truncate(atlas, F_LABEL, &item.title, row[2] - 200.0),
+                    row[0] + 10.0,
+                    row[1] + 4.0,
+                    TEXT,
+                );
+                let info = format!(
+                    "{} · {} {}",
+                    item.file,
+                    item.id,
+                    if item.version.is_empty() {
+                        String::new()
+                    } else {
+                        format!("v{}", item.version)
+                    }
+                );
+                draw_text_top(
+                    batch,
+                    atlas,
+                    F_SMALL,
+                    &truncate(atlas, F_SMALL, &info, row[2] - 200.0),
+                    row[0] + 10.0,
+                    row[1] + 30.0,
+                    MUTED,
+                );
+            }
+        }
+        if let Some((received, total)) = self.install_progress {
+            let frac = if total == 0 {
+                0.0
+            } else {
+                (received as f32 / total as f32).clamp(0.0, 1.0)
+            };
+            let bar = [x, h - 46.0, cw, 6.0];
+            batch.fill(atlas, bar[0], bar[1], bar[2], bar[3], SURFACE_2);
+            batch.fill(
+                atlas,
+                bar[0],
+                bar[1],
+                (bar[2] * frac).floor(),
+                bar[3],
+                ACCENT,
+            );
+        }
+        if let Some(status) = &self.install_status {
+            draw_text_top(
+                batch,
+                atlas,
+                F_SMALL,
+                &truncate(atlas, F_SMALL, status, cw),
+                x,
+                h - 34.0,
+                MUTED,
+            );
+        }
+    }
+
+    fn draw_search_field(&self, atlas: &HudAtlas, batch: &mut HudBatch, w: f32) {
+        let r = search_rect(w);
+        crate::widgets::target_as(r, crate::widgets::Kind::Field);
+        batch.fill(atlas, r[0], r[1], r[2], r[3], SURFACE_2);
+        border(
+            batch,
+            atlas,
+            r,
+            if self.search_focused { ACCENT } else { BORDER },
+        );
+        let shown = if self.query.is_empty() {
+            tr("mods_search").to_owned()
+        } else {
+            self.query.clone()
+        };
+        let color = if self.query.is_empty() { MUTED } else { TEXT };
+        draw_text_top(batch, atlas, F_BODY, &shown, r[0] + 8.0, r[1] + 6.0, color);
+        if self.search_focused {
+            let width = text_width(atlas, F_BODY, &self.query);
+            let on = (self.started.elapsed().as_millis() / 500).is_multiple_of(2);
+            if on {
+                batch.fill(atlas, r[0] + 9.0 + width, r[1] + 5.0, 1.0, 14.0, ACCENT);
+            }
+        }
+    }
+
+    fn draw_account(&self, atlas: &HudAtlas, batch: &mut HudBatch, w: f32, h: f32) {
+        let (left, right) = account_cards(w);
+        panel(batch, atlas, left, SURFACE, BORDER);
+        panel(batch, atlas, right, SURFACE, BORDER);
+        let lx = left[0] + 14.0;
+        let ly = left[1] + 12.0;
+        let rx = right[0] + 14.0;
+        let ry = right[1] + 12.0;
+        draw_text_top(batch, atlas, F_SMALL, tr("account_label"), lx, ly, MUTED);
+
+        match self.account.phase {
+            Phase::SignedIn => {
+                draw_text_top(batch, atlas, F_SMALL, tr("account_signed_in"), lx, ly + 20.0, OK);
+                draw_text_top(
+                    batch,
+                    atlas,
+                    F_TITLE,
+                    &truncate(atlas, F_TITLE, &self.account.account_name, left[2] - 28.0),
+                    lx,
+                    ly + 38.0,
+                    TEXT,
+                );
+                draw_text_top(
+                    batch,
+                    atlas,
+                    F_MONO,
+                    &truncate(atlas, F_MONO, &self.account.account_uuid, left[2] - 28.0),
+                    lx,
+                    ly + 78.0,
+                    MUTED,
+                );
+                if let Some(notice) = &self.account.notice {
+                    for (i, line) in wrap(atlas, F_SMALL, notice, left[2] - 28.0)
+                        .iter()
+                        .take(3)
+                        .enumerate()
+                    {
+                        draw_text_top(
+                            batch,
+                            atlas,
+                            F_SMALL,
+                            line,
+                            lx,
+                            ly + 106.0 + i as f32 * 18.0,
+                            WARN,
+                        );
+                    }
+                }
+                draw_text_top(
+                    batch,
+                    atlas,
+                    F_SMALL,
+                    tr("account_signed_in_help"),
+                    lx,
+                    left[1] + left[3] - 22.0,
+                    MUTED,
+                );
+                draw_text_top(batch, atlas, F_SMALL, tr("account_why"), rx, ry + 20.0, MUTED);
+                draw_text_top(batch, atlas, F_SMALL, tr("account_enter_hint"), rx, ry + 44.0, MUTED);
+            }
+            Phase::Starting | Phase::Waiting | Phase::Completing => {
+                draw_text_top(
+                    batch,
+                    atlas,
+                    F_TITLE,
+                    tr("home_account_off"),
+                    lx,
+                    ly + 18.0,
+                    TEXT,
+                );
+                for (i, line) in wrap(atlas, F_SMALL, tr("account_offline_note"), left[2] - 28.0)
+                    .iter()
+                    .take(3)
+                    .enumerate()
+                {
+                    draw_text_top(
+                        batch,
+                        atlas,
+                        F_SMALL,
+                        line,
+                        lx,
+                        ly + 58.0 + i as f32 * 18.0,
+                        MUTED,
+                    );
+                }
+                let status = match self.account.phase {
+                    Phase::Starting => tr("account_starting"),
+                    Phase::Waiting => tr("account_waiting"),
+                    _ => tr("account_completing"),
+                };
+                for (i, line) in wrap(atlas, F_SMALL, status, left[2] - 28.0)
+                    .iter()
+                    .take(2)
+                    .enumerate()
+                {
+                    draw_text_top(
+                        batch,
+                        atlas,
+                        F_SMALL,
+                        line,
+                        lx,
+                        ly + 114.0 + i as f32 * 18.0,
+                        WARN,
+                    );
+                }
+                draw_text_top(
+                    batch,
+                    atlas,
+                    F_SMALL,
+                    tr("account_enter_hint"),
+                    lx,
+                    left[1] + left[3] - 110.0,
+                    MUTED,
+                );
+
+                let side = 176.0;
+                let actual = self
+                    .account
+                    .qr
+                    .as_ref()
+                    .map_or(side, |qr| qr_extent(side, qr));
+                let qx = rx;
+                let qy = ry + 18.0;
+                draw_text_top(batch, atlas, F_SMALL, tr("account_sign_in"), rx, ry, ACCENT);
+                if let Some(qr) = &self.account.qr {
+                    draw_qr(batch, atlas, qx, qy, side, qr);
+                }
+                let tx = qx + actual + 16.0;
+                let tw = (right[0] + right[2] - tx - 12.0).max(100.0);
+                draw_text_top(batch, atlas, F_SMALL, tr("account_code_label"), tx, qy, MUTED);
+                let code = pretty_code(&self.account.user_code);
+                draw_text_top(batch, atlas, F_TITLE, &code, tx, qy + 16.0, ACCENT);
+                let uri = truncate(atlas, F_SMALL, &self.account.verification_uri, tw);
+                draw_text_top(batch, atlas, F_SMALL, &uri, tx, qy + 58.0, TEXT);
+                for (i, line) in wrap(atlas, F_SMALL, tr("account_qr_hint"), tw)
+                    .iter()
+                    .take(3)
+                    .enumerate()
+                {
+                    draw_text_top(
+                        batch,
+                        atlas,
+                        F_SMALL,
+                        line,
+                        tx,
+                        qy + 76.0 + i as f32 * 18.0,
+                        MUTED,
+                    );
+                }
+                let status = match self.account.phase {
+                    Phase::Starting => tr("account_starting"),
+                    Phase::Waiting => tr("account_waiting"),
+                    _ => tr("account_completing"),
+                };
+                for (i, line) in wrap(atlas, F_SMALL, status, right[2] - 28.0)
+                    .iter()
+                    .take(2)
+                    .enumerate()
+                {
+                    draw_text_top(
+                        batch,
+                        atlas,
+                        F_SMALL,
+                        line,
+                        rx,
+                        right[1] + right[3] - 32.0 + i as f32 * 18.0,
+                        WARN,
+                    );
+                }
+            }
+            Phase::SignedOut => {
+                draw_text_top(
+                    batch,
+                    atlas,
+                    F_TITLE,
+                    tr("home_account_off"),
+                    lx,
+                    ly + 18.0,
+                    TEXT,
+                );
+                for (i, line) in wrap(atlas, F_SMALL, tr("account_offline_note"), left[2] - 28.0)
+                    .iter()
+                    .take(3)
+                    .enumerate()
+                {
+                    draw_text_top(
+                        batch,
+                        atlas,
+                        F_SMALL,
+                        line,
+                        lx,
+                        ly + 58.0 + i as f32 * 18.0,
+                        MUTED,
+                    );
+                }
+                draw_text_top(batch, atlas, F_SMALL, tr("account_why"), lx, ly + 102.0, MUTED);
+                draw_text_top(batch, atlas, F_TITLE, "Microsoft", rx, ry + 18.0, TEXT);
+                draw_text_top(batch, atlas, F_SMALL, tr("account_why"), rx, ry + 58.0, MUTED);
+                for (i, line) in wrap(atlas, F_SMALL, tr("account_enter_hint"), right[2] - 28.0)
+                    .iter()
+                    .take(2)
+                    .enumerate()
+                {
+                    draw_text_top(
+                        batch,
+                        atlas,
+                        F_SMALL,
+                        line,
+                        rx,
+                        ry + 78.0 + i as f32 * 18.0,
+                        MUTED,
+                    );
+                }
+            }
+            Phase::Failed | Phase::Cancelled => {
+                let color = if self.account.phase == Phase::Failed {
+                    BAD
+                } else {
+                    WARN
+                };
+                for (i, line) in self
+                    .account_error_lines(atlas, left[2] - 28.0)
+                    .iter()
+                    .take(6)
+                    .enumerate()
+                {
+                    draw_text_top(
+                        batch,
+                        atlas,
+                        F_SMALL,
+                        line,
+                        lx,
+                        ly + 20.0 + i as f32 * 12.0,
+                        color,
+                    );
+                }
+                draw_text_top(batch, atlas, F_TITLE, "Microsoft", rx, ry + 18.0, TEXT);
+                for (i, line) in wrap(atlas, F_SMALL, tr("account_enter_hint"), right[2] - 28.0)
+                    .iter()
+                    .take(2)
+                    .enumerate()
+                {
+                    draw_text_top(
+                        batch,
+                        atlas,
+                        F_SMALL,
+                        line,
+                        rx,
+                        ry + 58.0 + i as f32 * 18.0,
+                        MUTED,
+                    );
+                }
+            }
+        }
+        self.draw_pin_field(atlas, batch, w, h);
+        if let Some(notice) = &self.account.notice
+            && self.account.phase != Phase::SignedIn
+        {
+            for (i, line) in wrap(atlas, F_SMALL, notice, left[2] - 28.0)
+                .iter()
+                .take(2)
+                .enumerate()
+            {
+                draw_text_top(
+                    batch,
+                    atlas,
+                    F_SMALL,
+                    line,
+                    lx,
+                    left[1] + left[3] + 72.0 + i as f32 * 18.0,
+                    WARN,
+                );
+            }
+        }
+    }

diff --git a/crates/horizon-client/examples/launcher_preview.rs b/crates/horizon-client/examples/launcher_preview.rs
new file mode 100644
index 0000000..4439317
--- /dev/null
+++ b/crates/horizon-client/examples/launcher_preview.rs
@@ -0,0 +1,204 @@
+//! Render the real launcher to PNG, without a window or GPU.
+//!
+//! This is the preview the Switch will draw: it builds the same `HudBatch`
+//! from `Launcher::draw`, then software-rasterizes its triangles and the
+//! font atlas patches. Run on a desktop host:
+//!
+//! ```sh
+//! cargo run -p horizon-client --example launcher_preview --no-default-features
+//! ```
+//!
+//! It writes `preview-out/{home,mods,account,settings}.png`.
+
+use horizon_client::{
+    account_ui::Phase,
+    hud::{HudAtlas, HudBatch, HudVertex},
+    launcher_v2::{Installed, InstalledKind, Launcher, Tab},
+    qr::Qr,
+};
+use std::{
+    fs,
+    path::Path,
+    time::{Duration, Instant, SystemTime},
+};
+
+const OUT_W: u32 = 1280;
+const OUT_H: u32 = 720;
+
+fn main() {
+    let root = std::env::temp_dir().join("horizon-launcher-preview");
+    let saves = root.join("saves");
+    let resources = root.join("resources");
+    let out = Path::new("preview-out");
+    fs::create_dir_all(&saves).unwrap();
+    fs::create_dir_all(&resources).unwrap();
+    fs::create_dir_all(out).unwrap();
+
+    horizon_client::lang::set(horizon_client::lang::Language::load(&[&resources], "pt_br"));
+    let atlas = HudAtlas::fonts(&resources).expect("font atlas");
+    // The game keeps one uploaded atlas for the process; keep the glyphs
+    // already uploaded between screens instead of resetting them per tab.
+    let mut atlas_pixels = vec![0u8; (atlas.width * atlas.height * 4) as usize];
+    let mut launcher = Launcher::new(&saves, &resources);
+    launcher.language = "pt_br".into();
+    launcher.installed.push(Installed {
+        path: root.join("horizon-mods/flesh_to_leather-1.0.0.hmod"),
+        file: "flesh_to_leather-1.0.0.hmod".into(),
+        id: "flesh_to_leather".into(),
+        title: "Flesh to Leather".into(),
+        version: "1.0.0".into(),
+        kind: InstalledKind::Mod,
+        enabled: true,
+    });
+    launcher.recent = Some(horizon_client::title::WorldEntry {
+        folder: "Meu Mundo".into(),
+        name: "Meu Mundo".into(),
+        creative: false,
+        modified: SystemTime::now() - Duration::from_secs(2 * 3600),
+        commands: false,
+        version: "26.3".into(),
+    });
+
+    let mut home = launcher;
+    home.tab = Tab::Home;
+    draw(&atlas, &mut atlas_pixels, &home, out, "home");
+
+    let mut mods = Launcher::new(&saves, &resources);
+    mods.language = "pt_br".into();
+    mods.tab = Tab::Mods;
+    draw(&atlas, &mut atlas_pixels, &mods, out, "mods");
+
+    let mut account = Launcher::new(&saves, &resources);
+    account.language = "pt_br".into();
+    account.tab = Tab::Account;
+    account.account.phase = Phase::Waiting;
+    account.account.user_code = "THGZSD8Y".into();
+    account.account.verification_uri = "https://www.microsoft.com/link".into();
+    account.account.qr = Qr::encode(&account.account.verification_uri);
+    draw(&atlas, &mut atlas_pixels, &account, out, "account");
+
+    let mut settings = Launcher::new(&saves, &resources);
+    settings.language = "pt_br".into();
+    settings.tab = Tab::Settings;
+    draw(&atlas, &mut atlas_pixels, &settings, out, "settings");
+}
+
+fn draw(
+    atlas: &HudAtlas,
+    atlas_pixels: &mut [u8],
+    launcher: &Launcher,
+    out: &Path,
+    name: &str,
+) {
+    let mut batch = HudBatch::launcher([OUT_W, OUT_H], 1.0);
+    launcher.draw(
+        atlas,
+        &mut batch,
+        (700.0, 300.0),
+        Instant::now() - Duration::from_millis(700),
+    );
+
+    // The real atlas starts with no uploaded pixels; the font patches are
+    // exactly what the renderer would upload before presenting. Glyphs stay
+    // in the atlas between screens, as they do in the game.
+    for patch in &batch.patches {
+        for row in 0..patch.height as usize {
+            let src = row * patch.width as usize * 4;
+            let dst = ((patch.y as usize + row) * atlas.width as usize + patch.x as usize) * 4;
+            let len = patch.width as usize * 4;
+            if dst + len <= atlas_pixels.len() && src + len <= patch.rgba.len() {
+                atlas_pixels[dst..dst + len].copy_from_slice(&patch.rgba[src..src + len]);
+            }
+        }
+    }
+
+    let image = rasterize(&batch, atlas_pixels, atlas.width, atlas.height);
+    let path = out.join(format!("{name}.png"));
+    let file = fs::File::create(&path).unwrap();
+    let mut encoder = png::Encoder::new(std::io::BufWriter::new(file), OUT_W, OUT_H);
+    encoder.set_color(png::ColorType::Rgba);
+    encoder.set_depth(png::BitDepth::Eight);
+    encoder.write_header().unwrap().write_image_data(&image).unwrap();
+    println!("wrote {}", path.display());
+}
+
+fn rasterize(batch: &HudBatch, atlas: &[u8], aw: u32, ah: u32) -> Vec<u8> {
+    let mut out = vec![0u8; (OUT_W * OUT_H * 4) as usize];
+    let scale = batch.scale;
+    for tri in batch.vertices.chunks_exact(3) {
+        if tri.len() != 3 {
+            break;
+        }
+        let p = [tri[0], tri[1], tri[2]].map(|v| [v.pos[0] * scale, v.pos[1] * scale]);
+        let min_x = p.iter().map(|v| v[0]).fold(f32::INFINITY, f32::min).floor().max(0.0) as i32;
+        let max_x = p.iter().map(|v| v[0]).fold(f32::NEG_INFINITY, f32::max).ceil().min(OUT_W as f32 - 1.0) as i32;
+        let min_y = p.iter().map(|v| v[1]).fold(f32::INFINITY, f32::min).floor().max(0.0) as i32;
+        let max_y = p.iter().map(|v| v[1]).fold(f32::NEG_INFINITY, f32::max).ceil().min(OUT_H as f32 - 1.0) as i32;
+        if min_x > max_x || min_y > max_y {
+            continue;
+        }
+        let area = edge(p[0], p[1], p[2]);
+        if area.abs() < f32::EPSILON {
+            continue;
+        }
+        let constant_uv = uv_eq(tri[0], tri[1]) && uv_eq(tri[1], tri[2]);
+        for y in min_y..=max_y {
+            for x in min_x..=max_x {
+                let q = [x as f32 + 0.5, y as f32 + 0.5];
+                let w0 = edge(p[1], p[2], q) / area;
+                let w1 = edge(p[2], p[0], q) / area;
+                let w2 = edge(p[0], p[1], q) / area;
+                if w0 < -0.0001 || w1 < -0.0001 || w2 < -0.0001 {
+                    continue;
+                }
+                let (mut sr, mut sg, mut sb, mut sa) = unpack(tri[0].color);
+                if !constant_uv {
+                    let u = tri[0].uv[0] * w0 + tri[1].uv[0] * w1 + tri[2].uv[0] * w2;
+                    let v = tri[0].uv[1] * w0 + tri[1].uv[1] * w1 + tri[2].uv[1] * w2;
+                    let (tr, tg, tb, ta) = sample(atlas, aw, ah, u, v);
+                    sr = (u32::from(sr) * u32::from(tr) / 255) as u8;
+                    sg = (u32::from(sg) * u32::from(tg) / 255) as u8;
+                    sb = (u32::from(sb) * u32::from(tb) / 255) as u8;
+                    sa = (u32::from(sa) * u32::from(ta) / 255) as u8;
+                }
+                if sa == 0 {
+                    continue;
+                }
+                let i = ((y as u32 * OUT_W + x as u32) * 4) as usize;
+                let a = f32::from(sa) / 255.0;
+                out[i] = (f32::from(sr) * a + f32::from(out[i]) * (1.0 - a)) as u8;
+                out[i + 1] = (f32::from(sg) * a + f32::from(out[i + 1]) * (1.0 - a)) as u8;
+                out[i + 2] = (f32::from(sb) * a + f32::from(out[i + 2]) * (1.0 - a)) as u8;
+                out[i + 3] = 255;
+            }
+        }
+    }
+    out
+}
+
+fn edge(a: [f32; 2], b: [f32; 2], c: [f32; 2]) -> f32 {
+    (c[0] - a[0]) * (b[1] - a[1]) - (c[1] - a[1]) * (b[0] - a[0])
+}
+
+fn uv_eq(a: HudVertex, b: HudVertex) -> bool {
+    (a.uv[0] - b.uv[0]).abs() < 1e-6 && (a.uv[1] - b.uv[1]).abs() < 1e-6
+}
+
+fn unpack(c: u32) -> (u8, u8, u8, u8) {
+    (
+        (c & 0xff) as u8,
+        ((c >> 8) & 0xff) as u8,
+        ((c >> 16) & 0xff) as u8,
+        ((c >> 24) & 0xff) as u8,
+    )
+}
+
+fn sample(atlas: &[u8], w: u32, h: u32, u: f32, v: f32) -> (u8, u8, u8, u8) {
+    let x = (u.clamp(0.0, 1.0) * (w.saturating_sub(1)) as f32).round() as u32;
+    let y = (v.clamp(0.0, 1.0) * (h.saturating_sub(1)) as f32).round() as u32;
+    let i = ((y * w + x) * 4) as usize;
+    if i + 3 >= atlas.len() {
+        return (255, 255, 255, 255);
+    }
+    (atlas[i], atlas[i + 1], atlas[i + 2], atlas[i + 3])
+}
diff --git a/crates/horizon-client/src/account_ui.rs b/crates/horizon-client/src/account_ui.rs
new file mode 100644
index 0000000..b1089e8
--- /dev/null
+++ b/crates/horizon-client/src/account_ui.rs
@@ -0,0 +1,498 @@
+//! The launcher's Account screen state: the Microsoft device-code flow runs on
+//! a worker thread, so the title screen keeps drawing and taking input while
+//! Microsoft, Xbox Live and the Minecraft services answer.
+//!
+//! No token reaches this module's `Debug`, the UI strings or a log line. When
+//! the flow finishes, [`crate::auth::complete`] installs the session with
+//! `set_current`; the screen only keeps the public name/UUID.
+use crate::auth::{self, Account, Poll};
+use crate::qr::Qr;
+use std::{
+    sync::{
+        Arc,
+        atomic::{AtomicBool, Ordering},
+        mpsc::{self, Receiver, Sender, TryRecvError},
+    },
+    time::{Duration, Instant},
+};
+
+/// What the screen is showing.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum Phase {
+    /// No session: offline play and the sign-in buttons.
+    #[default]
+    SignedOut,
+    /// Asking Microsoft for a device code.
+    Starting,
+    /// The code is on screen and the worker polls Microsoft.
+    Waiting,
+    /// Approved: Xbox Live, XSTS, Minecraft, entitlements and profile.
+    Completing,
+    /// A session is installed.
+    SignedIn,
+    /// The player cancelled, or the code was declined/expired.
+    Cancelled,
+    /// Anything that is not a plain cancellation.
+    Failed,
+}
+
+/// Worker -> UI messages. No tokens, no device code secret.
+#[derive(Clone, Debug)]
+pub enum Event {
+    Code {
+        user_code: String,
+        verification_uri: String,
+    },
+    Completing,
+    SignedIn {
+        account: Account,
+        persistent: bool,
+        save_error: Option<String>,
+    },
+    Cancelled,
+    Error(String),
+}
+
+/// The Account screen's state. `Title` owns one for the process.
+#[derive(Default)]
+pub struct AccountUi {
+    pub phase: Phase,
+    /// The code the player types at Microsoft's page.
+    pub user_code: String,
+    pub verification_uri: String,
+    /// The QR for `verification_uri`, built once when the code arrives.
+    pub qr: Option<Qr>,
+    /// A failure, shown in red. Never contains a token.
+    pub error: Option<String>,
+    /// A non-fatal warning: memory-only session, save failure, sign-out without
+    /// the PIN that would remove the encrypted record.
+    pub notice: Option<String>,
+    pub account_name: String,
+    pub account_uuid: String,
+    /// `Some(false)` means the session is memory-only.
+    pub persistent: Option<bool>,
+    /// The vault PIN, empty for memory-only. It is typed with the existing OSK.
+    pub pin: String,
+    pub pin_focused: bool,
+    receiver: Option<Receiver<Event>>,
+    cancel: Option<Arc<AtomicBool>>,
+}
+
+impl AccountUi {
+    pub fn is_busy(&self) -> bool {
+        matches!(
+            self.phase,
+            Phase::Starting | Phase::Waiting | Phase::Completing
+        )
+    }
+
+    /// Called when the dashboard opens the screen. A running flow is kept; an
+    /// idle screen re-reads `auth::current`, so a session installed by another
+    /// path (or a previous screen visit) shows up.
+    pub fn open(&mut self) {
+        self.pin_focused = false;
+        if self.is_busy() {
+            return;
+        }
+        self.refresh_from_current();
+        if self.phase != Phase::SignedIn {
+            self.phase = Phase::SignedOut;
+        }
+        self.error = None;
+        self.notice = None;
+    }
+
+    /// Update the public account from the process-wide session.
+    pub fn refresh_from_current(&mut self) {
+        match auth::current() {
+            Some(session) => {
+                self.phase = Phase::SignedIn;
+                self.account_name = session.name.clone();
+                self.account_uuid = horizon_protocol::crypto::uuid_string(session.uuid);
+            }
+            None => {
+                if self.phase == Phase::SignedIn {
+                    self.phase = Phase::SignedOut;
+                    self.account_name.clear();
+                    self.account_uuid.clear();
+                    self.persistent = None;
+                }
+            }
+        }
+    }
+
+    /// Begin the device-code flow. Returns false when the button should not
+    /// have been active or the worker could not start.
+    pub fn start_sign_in(&mut self) -> bool {
+        if self.is_busy() || self.phase == Phase::SignedIn {
+            return false;
+        }
+        let pin = self.pin.trim().to_owned();
+        let (sender, receiver) = mpsc::channel();
+        let cancel = Arc::new(AtomicBool::new(false));
+        let worker_cancel = cancel.clone();
+        let spawned = std::thread::Builder::new()
+            .name("Microsoft sign-in".into())
+            .spawn(move || sign_in_worker(sender, worker_cancel, pin));
+        match spawned {
+            Ok(_) => {
+                self.phase = Phase::Starting;
+                self.pin_focused = false;
+                self.error = None;
+                self.notice = None;
+                self.user_code.clear();
+                self.verification_uri.clear();
+                self.qr = None;
+                self.persistent = None;
+                self.receiver = Some(receiver);
+                self.cancel = Some(cancel);
+                true
+            }
+            Err(e) => {
+                self.phase = Phase::Failed;
+                self.error = Some(format!("Could not start the sign-in worker: {e}"));
+                false
+            }
+        }
+    }
+
+    /// Load the encrypted account for the PIN. It refreshes the Minecraft token
+    /// on the worker; an empty PIN cannot open the vault.
+    pub fn start_load_saved(&mut self) -> bool {
+        if self.is_busy() || self.phase == Phase::SignedIn {
+            return false;
+        }
+        let pin = self.pin.trim().to_owned();
+        if pin.is_empty() {
+            self.phase = Phase::Failed;
+            self.error = Some(crate::launcher_v2::tr("account_pin_required").to_owned());
+            self.notice = None;
+            return false;
+        }
+        let (sender, receiver) = mpsc::channel();
+        let spawned = std::thread::Builder::new()
+            .name("Microsoft saved account".into())
+            .spawn(move || load_worker(sender, pin));
+        match spawned {
+            Ok(_) => {
+                self.phase = Phase::Starting;
+                self.pin_focused = false;
+                self.error = None;
+                self.notice = None;
+                self.user_code.clear();
+                self.verification_uri.clear();
+                self.qr = None;
+                self.receiver = Some(receiver);
+                self.cancel = None;
+                true
+            }
+            Err(e) => {
+                self.phase = Phase::Failed;
+                self.error = Some(format!("Could not start the sign-in worker: {e}"));
+                false
+            }
+        }
+    }
+
+    /// Stop the worker. Events it sends after this point are dropped; if the
+    /// Xbox/Minecraft chain had already started, it may still finish and install
+    /// the session, which the next `open` shows.
+    pub fn cancel(&mut self) {
+        if let Some(flag) = &self.cancel {
+            flag.store(true, Ordering::Relaxed);
+        }
+        if self.is_busy() {
+            self.phase = Phase::Cancelled;
+            self.error = None;
+            self.notice = None;
+            self.user_code.clear();
+            self.verification_uri.clear();
+            self.qr = None;
+        }
+        self.receiver = None;
+        self.cancel = None;
+        self.pin_focused = false;
+    }
+
+    /// Drain worker messages; call once a frame from the title's draw path.
+    pub fn poll(&mut self) {
+        let Some(receiver) = self.receiver.take() else {
+            return;
+        };
+        let mut events = Vec::new();
+        let mut disconnected = false;
+        loop {
+            match receiver.try_recv() {
+                Ok(event) => events.push(event),
+                Err(TryRecvError::Empty) => break,
+                Err(TryRecvError::Disconnected) => {
+                    disconnected = true;
+                    break;
+                }
+            }
+        }
+        for event in events {
+            self.handle(event);
+        }
+        if disconnected && self.is_busy() {
+            self.phase = Phase::Failed;
+            self.error = Some("The sign-in worker stopped unexpectedly.".into());
+        }
+        if self.is_busy() {
+            self.receiver = Some(receiver);
+        } else {
+            self.cancel = None;
+        }
+    }
+
+    fn handle(&mut self, event: Event) {
+        match event {
+            Event::Code {
+                user_code,
+                verification_uri,
+            } => {
+                self.phase = Phase::Waiting;
+                self.user_code = user_code;
+                self.verification_uri = verification_uri;
+                self.qr = Qr::encode(&self.verification_uri);
+                self.error = None;
+                log::info!(
+                    "Horizon: Microsoft device code at {} (code {})",
+                    self.verification_uri,
+                    self.user_code
+                );
+            }
+            Event::Completing => {
+                self.phase = Phase::Completing;
+                self.error = None;
+            }
+            Event::SignedIn {
+                account,
+                persistent,
+                save_error,
+            } => {
+                self.phase = Phase::SignedIn;
+                self.pin_focused = false;
+                log::info!("Horizon: signed in as {}", account.name);
+                self.account_name = account.name;
+                self.account_uuid = auth::parse_uuid(&account.uuid)
+                    .map(horizon_protocol::crypto::uuid_string)
+                    .unwrap_or(account.uuid);
+                self.persistent = Some(persistent);
+                self.error = None;
+                self.notice = save_error.or_else(|| {
+                    (!persistent)
+                        .then(|| crate::launcher_v2::tr("account_memory_warning").to_owned())
+                });
+                self.user_code.clear();
+                self.verification_uri.clear();
+                self.qr = None;
+            }
+            Event::Cancelled => {
+                self.phase = Phase::Cancelled;
+                self.pin_focused = false;
+                self.error = None;
+                self.notice = None;
+                self.user_code.clear();
+                self.verification_uri.clear();
+                self.qr = None;
+            }
+            Event::Error(message) => {
+                log::warn!("Horizon: Microsoft sign-in failed: {message}");
+                self.phase = if message.to_lowercase().contains("cancel") {
+                    Phase::Cancelled
+                } else {
+                    Phase::Failed
+                };
+                self.pin_focused = false;
+                self.error = Some(message);
+                self.notice = None;
+                self.user_code.clear();
+                self.verification_uri.clear();
+                self.qr = None;
+            }
+        }
+    }
+
+    /// End the session and remove the encrypted record when the PIN can open
+    /// the store. Without a PIN the record on the SD card cannot be removed.
+    pub fn sign_out(&mut self) -> Result<(), String> {
+        let pin = self.pin.trim();
+        let store = auth::open_store((!pin.is_empty()).then_some(pin));
+        let persistent = store.persistent();
+        auth::sign_out(store.as_ref())?;
+        self.phase = Phase::SignedOut;
+        self.account_name.clear();
+        self.account_uuid.clear();
+        self.persistent = None;
+        self.error = None;
+        self.user_code.clear();
+        self.verification_uri.clear();
+        self.qr = None;
+        self.pin_focused = false;
+        self.notice =
+            (!persistent).then(|| crate::launcher_v2::tr("account_sign_out_no_pin").to_owned());
+        Ok(())
+    }
+}
+
+fn sign_in_worker(sender: Sender<Event>, cancel: Arc<AtomicBool>, pin: String) {
+    let mut flow = match auth::begin_device_code() {
+        Ok(flow) => flow,
+        Err(message) => {
+            let _ = sender.send(Event::Error(message));
+            return;
+        }
+    };
+    let code = Event::Code {
+        user_code: flow.device.user_code.clone(),
+        verification_uri: flow.device.verification_uri.clone(),
+    };
+    if sender.send(code).is_err() {
+        return;
+    }
+    let mut interval = flow.device.interval.max(1);
+    loop {
+        if !sleep_cancellable(&cancel, interval) {
+            let _ = sender.send(Event::Cancelled);
+            return;
+        }
+        match auth::poll(&mut flow) {
+            Ok(Poll::Pending) => {}
+            Ok(Poll::SlowDown) => interval += 5,
+            Ok(Poll::Authorized) => break,
+            Err(message) => {
+                let _ = sender.send(Event::Error(message));
+                return;
+            }
+        }
+    }
+    if cancel.load(Ordering::Relaxed) {
+        let _ = sender.send(Event::Cancelled);
+        return;
+    }
+    if sender.send(Event::Completing).is_err() {
+        return;
+    }
+    match auth::complete(flow) {
+        Ok(signed) => {
+            let pin = pin.trim();
+            let store = auth::open_store((!pin.is_empty()).then_some(pin));
+            let persistent = store.persistent();
+            let save_error = auth::save(store.as_ref(), &signed).err();
+            let _ = sender.send(Event::SignedIn {
+                account: signed.account,
+                persistent,
+                save_error,
+            });
+        }
+        Err(message) => {
+            let _ = sender.send(Event::Error(message));
+        }
+    }
+}
+
+fn load_worker(sender: Sender<Event>, pin: String) {
+    let store = auth::open_store(Some(pin.as_str()));
+    if !store.persistent() {
+        let _ = sender.send(Event::Error(
+            crate::launcher_v2::tr("account_vault_unavailable").to_owned(),
+        ));
+        return;
+    }
+    match auth::load_saved(store.as_ref()) {
+        Ok(Some(signed)) => {
+            let _ = sender.send(Event::SignedIn {
+                account: signed.account,
+                persistent: true,
+                save_error: None,
+            });
+        }
+        Ok(None) => {
+            let _ = sender.send(Event::Error(
+                crate::launcher_v2::tr("account_no_saved").to_owned(),
+            ));
+        }
+        Err(message) => {
+            let _ = sender.send(Event::Error(message));
+        }
+    }
+}
+
+/// Sleep in slices so cancellation is noticed quickly.
+fn sleep_cancellable(cancel: &AtomicBool, seconds: u64) -> bool {
+    let deadline = Instant::now() + Duration::from_secs(seconds);
+    while Instant::now() < deadline {
+        if cancel.load(Ordering::Relaxed) {
+            return false;
+        }
+        let left = deadline.saturating_duration_since(Instant::now());
+        std::thread::sleep(left.min(Duration::from_millis(100)));
+    }
+    !cancel.load(Ordering::Relaxed)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn account() -> Account {
+        Account {
+            uuid: "0123456789abcdef0123456789abcdef".into(),
+            name: "Steve".into(),
+            xuid: Some("123".into()),
+            skin_url: None,
+            skin_variant: None,
+            cape_url: None,
+        }
+    }
+
+    #[test]
+    fn the_device_code_is_shown_while_the_worker_waits() {
+        let mut ui = AccountUi::default();
+        ui.handle(Event::Code {
+            user_code: "ABCD1234".into(),
+            verification_uri: "https://www.microsoft.com/link".into(),
+        });
+        assert_eq!(ui.phase, Phase::Waiting);
+        assert_eq!(ui.user_code, "ABCD1234");
+        assert_eq!(ui.verification_uri, "https://www.microsoft.com/link");
+        assert!(ui.qr.is_some(), "the account screen shows a QR");
+        ui.handle(Event::Completing);
+        assert_eq!(ui.phase, Phase::Completing);
+    }
+
+    #[test]
+    fn a_signed_in_account_has_only_public_data() {
+        let mut ui = AccountUi::default();
+        ui.handle(Event::SignedIn {
+            account: account(),
+            persistent: false,
+            save_error: None,
+        });
+        assert_eq!(ui.phase, Phase::SignedIn);
+        assert_eq!(ui.account_name, "Steve");
+        assert_eq!(ui.account_uuid, "01234567-89ab-cdef-0123-456789abcdef");
+        assert_eq!(ui.persistent, Some(false));
+        assert!(ui.notice.is_some(), "memory-only sessions are warned about");
+    }
+
+    #[test]
+    fn cancellation_and_failures_are_distinct() {
+        let mut ui = AccountUi::default();
+        ui.handle(Event::Cancelled);
+        assert_eq!(ui.phase, Phase::Cancelled);
+        assert!(ui.error.is_none());
+        ui.handle(Event::Error(auth::NOT_CONFIGURED.into()));
+        assert_eq!(ui.phase, Phase::Failed);
+        assert_eq!(ui.error.as_deref(), Some(auth::NOT_CONFIGURED));
+    }
+
+    #[test]
+    fn loading_a_saved_account_needs_a_pin() {
+        let mut ui = AccountUi::default();
+        assert!(!ui.start_load_saved());
+        assert_eq!(ui.phase, Phase::Failed);
+        assert!(ui.error.as_deref().is_some_and(|e| e.contains("PIN")));
+    }
+}

+    fn draw_pin_field(&self, atlas: &HudAtlas, batch: &mut HudBatch, w: f32, h: f32) {
+        let r = pin_rect(w, h);
+        crate::widgets::target_as(r, crate::widgets::Kind::Field);
+        draw_text_top(
+            batch,
+            atlas,
+            F_SMALL,
+            tr("account_pin"),
+            r[0],
+            r[1] - 20.0,
+            MUTED,
+        );
+        batch.fill(atlas, r[0], r[1], r[2], r[3], SURFACE_2);
+        border(
+            batch,
+            atlas,
+            r,
+            if self.account.pin_focused {
+                ACCENT
+            } else {
+                BORDER
+            },
+        );
+        let shown = if self.account.pin.is_empty() {
+            if self.account.pin_focused {
+                String::new()
+            } else {
+                tr("account_pin_placeholder").to_owned()
+            }
+        } else {
+            "*".repeat(self.account.pin.chars().count())
+        };
+        let color = if self.account.pin.is_empty() {
+            MUTED
+        } else {
+            TEXT
+        };
+        draw_text_top(batch, atlas, F_BODY, &shown, r[0] + 8.0, r[1] + 5.0, color);
+        if self.account.pin_focused {
+            let on = (self.started.elapsed().as_millis() / 500).is_multiple_of(2);
+            if on {
+                let width = text_width(atlas, F_BODY, &shown);
+                batch.fill(atlas, r[0] + 9.0 + width, r[1] + 6.0, 1.0, 14.0, ACCENT);
+            }
+        }
+    }
+
+    fn draw_settings(&self, atlas: &HudAtlas, batch: &mut HudBatch, w: f32, h: f32) {
+        let (x, cw) = content(w);
+        let labels = [
+            tr("settings_language"),
+            tr("settings_name"),
+            tr("settings_resolution"),
+            tr("settings_audio"),
+            tr("settings_cursor"),
+            tr("settings_ui_scale"),
+        ];
+        for (i, label) in labels.iter().enumerate() {
+            let y = 160.0 + i as f32 * 64.0;
+            draw_text_top(batch, atlas, F_BODY, label, x, y + 7.0, MUTED);
+        }
+        let r = name_field_rect(w);
+        crate::widgets::target_as(r, crate::widgets::Kind::Field);
+        batch.fill(atlas, r[0], r[1], r[2], r[3], SURFACE_2);
+        border(
+            batch,
+            atlas,
+            r,
+            if self.name_focused { ACCENT } else { BORDER },
+        );
+        draw_text_top(
+            batch,
+            atlas,
+            F_BODY,
+            &self.offline_name,
+            r[0] + 8.0,
+            r[1] + 7.0,
+            TEXT,
+        );
+        if self.name_focused {
+            let width = text_width(atlas, F_BODY, &self.offline_name);
+            let on = (self.started.elapsed().as_millis() / 500).is_multiple_of(2);
+            if on {
+                batch.fill(atlas, r[0] + 9.0 + width, r[1] + 6.0, 1.0, 15.0, ACCENT);
+            }
+        }
+        let note_y = 520.0_f32.min(h - 54.0);
+        for (i, line) in wrap(atlas, F_SMALL, tr("settings_note"), cw)
+            .iter()
+            .take(2)
+            .enumerate()
+        {
+            draw_text_top(
+                batch,
+                atlas,
+                F_SMALL,
+                line,
+                x,
+                note_y + i as f32 * 18.0,
+                MUTED,
+            );
+        }
+        if let Some((message, error)) = &self.status {
+            draw_text_top(
+                batch,
+                atlas,
+                F_SMALL,
+                &truncate(atlas, F_SMALL, message, cw),
+                x,
+                h - 18.0,
+                if *error { BAD } else { OK },
+            );
+        }
+    }

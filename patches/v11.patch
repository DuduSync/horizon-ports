+}
+
+pub(super) struct PadFrame {
+    pub dx: f32,
+    pub dy: f32,
+    pub dpad: Option<[f32; 2]>,
+    pub click: bool,
+    pub back: bool,
+}
+
+impl MenuPad {
+    /// Forget held buttons after a focus change; the next report is a new
+    /// baseline, not a press.
+    pub fn reset(&mut self) {
+        #[cfg(target_os = "horizon")]
+        {
+            self.buttons = 0;
+            self.last = None;
+        }
+    }
+
+    /// One reading, in GUI pixels: stick movement, a D-pad step, A (click)
+    /// and B (back). `None` when no pad is connected.
+    pub fn read(&mut self, deadzone: f32) -> Option<PadFrame> {
+        #[cfg(not(target_os = "horizon"))]
+        {
+            let _ = deadzone;
+            None
+        }
+        #[cfg(target_os = "horizon")]
+        {
+            use horizon_nx::pad::button as nx;
+            let pad = self.pad.get_or_insert_with(horizon_nx::pad::Pad::new);
+            let snapshot = pad.update();
+            if !snapshot.connected {
+                self.buttons = 0;
+                self.last = None;
+                return None;
+            }
+            let now = Instant::now();
+            let seconds = self
+                .last
+                .map_or(0.0, |last| now.duration_since(last).as_secs_f32().min(0.05));
+            self.last = Some(now);
+            let (dx, dy) = horizon_client::gamepad::cursor_delta(
+                snapshot.sticks[0],
+                deadzone,
+                seconds,
+            );
+            let pressed = snapshot.buttons & !self.buttons;
+            self.buttons = snapshot.buttons;
+            let step = 34.0;
+            let dpad = if pressed & nx::UP != 0 {
+                Some([0.0, -step])
+            } else if pressed & nx::DOWN != 0 {
+                Some([0.0, step])
+            } else if pressed & nx::LEFT != 0 {
+                Some([-step, 0.0])
+            } else if pressed & nx::RIGHT != 0 {
+                Some([step, 0.0])
+            } else {
+                None
+            };
+            Some(PadFrame {
+                dx,
+                dy,
+                dpad,
+                click: pressed & nx::A != 0,
+                back: pressed & nx::B != 0,
+            })
+        }
+    }
+}

+/// Draw the menu pointer at `cursor` (batch units) at a fixed physical size:
+/// 24x36 pixels on the handheld screen and the TV, whatever the UI density.
+fn paint_mouse_cursor(atlas: &HudAtlas, batch: &mut HudBatch, cursor: (f32, f32), opacity: f32) {
+    if opacity <= 0.0 {
+        return;
+    }
+    let Some(rect) = atlas.sprites.get(horizon_client::hud::CURSOR_SPRITE).copied() else {
+        return;
+    };

+#[test]
+fn load_saved_reuses_a_good_token_and_refreshes_an_old_one() {
+    let _guard = serial();
+    clear_current();
+    let store = MemoryStore::default();
+    let account = sample_account();
+
+    save(
+        &store,
+        &SignedIn {
+            account: account.clone(),
+            secrets: sample_secrets(now() + 7200),
+        },
+    )
+    .unwrap();
+    let (first_mock, endpoints) = mock(|_| {});
+    let loaded = load_saved_at(&store, endpoints.clone()).unwrap().unwrap();
+    assert_eq!(loaded.secrets.minecraft_token, "old");
+    assert_eq!(
+        super::super::current().map(|session| session.name.clone()),
+        Some("Notch".into())
+    );
+    assert!(
+        paths(&first_mock).is_empty(),
+        "a fresh token needs no request"
+    );
+
+    save(
+        &store,
+        &SignedIn {
+            account,
+            secrets: sample_secrets(0),
+        },
+    )
+    .unwrap();
+    let loaded = load_saved_at(&store, endpoints).unwrap().unwrap();
+    assert_eq!(loaded.secrets.minecraft_token, "mc-token");
+    assert_eq!(loaded.secrets.refresh_token, "ms-refresh-2");
+    assert_eq!(
+        paths(&first_mock),
+        [
+            "/ms/token",
+            "/xbl",
+            "/xsts",
+            "/mc/authentication/login_with_xbox",
+            "/mc/entitlements/mcstore",
+            "/mc/minecraft/profile",
+        ]
+    );
+
+    // The renewed record was written back: a second load needs no request.
+    let (quiet, endpoints) = mock(|_| {});
+    let again = load_saved_at(&store, endpoints).unwrap().unwrap();
+    assert_eq!(again.secrets.minecraft_token, "mc-token");
+    assert!(paths(&quiet).is_empty());
+    clear_current();

+fn button(r: [f32; 4], label: &str, enabled: bool, id: u8, primary: bool) -> LauncherButton {
+    LauncherButton {
+        x: r[0],
+        y: r[1],
+        w: r[2],
+        h: r[3],
+        label: label.to_owned(),
+        enabled,
+        id,
+        primary,
+    }
+}
+
+fn sidebar_w(w: f32) -> f32 {
+    (w * 0.20).clamp(180.0, 252.0)
+}
+fn content(w: f32) -> (f32, f32) {
+    let x = sidebar_w(w) + 28.0;
+    (x, w - x - 24.0)
+}
+fn nav_rect(i: usize, w: f32) -> [f32; 4] {
+    [16.0, 118.0 + i as f32 * 46.0, sidebar_w(w) - 32.0, 40.0]
+}
+fn quit_rect(w: f32, h: f32) -> [f32; 4] {
+    [16.0, h - 44.0, sidebar_w(w) - 32.0, 28.0]
+}
+fn mods_row_rect(x: f32, cw: f32, y: f32) -> [f32; 4] {
+    [x, y, cw, 72.0]
+}
+fn search_rect(w: f32) -> [f32; 4] {
+    let (x, cw) = content(w);
+    [x + 260.0, 160.0, (cw - 268.0).max(180.0), 32.0]
+}
+fn name_field_rect(w: f32) -> [f32; 4] {
+    let (x, cw) = content(w);
+    [x + 158.0, 224.0, (cw - 254.0).max(120.0), 32.0]
+}
+fn account_cards(w: f32) -> ([f32; 4], [f32; 4]) {
+    let (x, cw) = content(w);
+    let left_w = (cw * 0.44).clamp(300.0, 420.0);
+    let left = [x, 160.0, left_w, 332.0];
+    let right = [
+        x + left_w + 16.0,
+        160.0,
+        (cw - left_w - 16.0).max(260.0),
+        332.0,
+    ];
+    (left, right)
+}
+fn pin_rect(w: f32, _h: f32) -> [f32; 4] {
+    let (x, _) = content(w);
+    [x, 530.0, 300.0, 28.0]
+}

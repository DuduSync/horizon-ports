+    let h = horizon_client::hud::CURSOR_SIZE.1 / batch.scale;
+    let x = cursor.0.clamp(0.0, (batch.width - w).max(0.0));
+    let y = cursor.1.clamp(0.0, (batch.height - h).max(0.0));
+    batch.rect_uv(
+        x,
+        y,
+        w,
+        h,
+        rect,
+        rgba(255, 255, 255, (opacity * 255.0) as u8),
+    );
+}

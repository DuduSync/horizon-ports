+pub const FIELD_NAME: crate::clipboard::FieldId = ("launcher.name", 0);
+pub const FIELD_SEARCH: crate::clipboard::FieldId = ("launcher.search", 0);
+pub const FIELD_PIN: crate::clipboard::FieldId = ("launcher.pin", 0);
+
+impl Launcher {
+    fn page_size(&self, h: f32) -> usize {
+        ((h - 320.0) / 80.0).clamp(2.0, 4.0) as usize
+    }
+
+    pub fn focused_field(&mut self) -> Option<(crate::clipboard::FieldId, &mut String, usize)> {
+        match self.tab {
+            Tab::Settings if self.name_focused => Some((FIELD_NAME, &mut self.offline_name, 16)),
+            Tab::Mods if self.mods_tab == ModsTab::Browse && self.search_focused => {
+                Some((FIELD_SEARCH, &mut self.query, 48))
+            }
+            Tab::Account if self.account.pin_focused => {
+                Some((FIELD_PIN, &mut self.account.pin, 64))
+            }
+            _ => None,
+        }
+    }
+
+    pub fn field_rect(&self, w: f32, h: f32) -> Option<[f32; 4]> {
+        match self.tab {
+            Tab::Settings if self.name_focused => Some(name_field_rect(w)),
+            Tab::Mods if self.mods_tab == ModsTab::Browse && self.search_focused => {
+                Some(search_rect(w))
+            }
+            Tab::Account if self.account.pin_focused => Some(pin_rect(w, h)),
+            _ => None,
+        }
+    }
+
+    pub fn toggle_focus(&mut self) {
+        match self.tab {
+            Tab::Settings => {
+                let next = !self.name_focused;
+                self.clear_focus();
+                self.name_focused = next;
+            }
+            Tab::Mods if self.mods_tab == ModsTab::Browse => {
+                let next = !self.search_focused;
+                self.clear_focus();
+                self.search_focused = next;
+            }
+            Tab::Account if !self.account.is_busy() && self.account.phase != Phase::SignedIn => {
+                let next = !self.account.pin_focused;
+                self.clear_focus();
+                self.account.pin_focused = next;
+            }
+            _ => {}
+        }
+    }
+
+    pub fn confirm_field(&mut self) {
+        match self.tab {
+            Tab::Settings if self.name_focused => {
+                self.save_name();
+                self.name_focused = false;
+            }
+            Tab::Mods if self.search_focused => self.search_focused = false,
+            _ => {}
+        }
+    }
+
+    pub fn escape(&mut self) {
+        self.clear_focus();
+        if self.tab != Tab::Home {
+            self.tab = Tab::Home;
+        }
+    }
+
+    fn clear_focus(&mut self) {
+        self.name_focused = false;
+        self.search_focused = false;
+        self.account.pin_focused = false;
+    }
+
+    pub fn background_click(&mut self, x: f32, y: f32, w: f32, h: f32) {
+        let mut focus = None;
+        let hit = |r: [f32; 4]| x >= r[0] && x < r[0] + r[2] && y >= r[1] && y < r[1] + r[3];
+        // The whole mod row is clickable, not only its right-hand button: this is also the
+        // target the pad's A press lands on when it focuses a row.
+        if self.tab == Tab::Mods {
+            let (x, cw) = content(w);
+            let per = self.page_size(h);
+            if self.mods_tab == ModsTab::Browse {
+                for i in 0..per {
+                    if hit(mods_row_rect(x, cw, 156.0 + i as f32 * 36.0)) {
+                        let project = self
+                            .filtered_projects()
+                            .get(self.page * per + i)
+                            .copied()
+                            .cloned();
+                        if let Some(project) = project
+                            && !self.index_busy
+                            && matches!(
+                                &project.kind,
+                                Kind::Mod | Kind::ResourcePack | Kind::Shader
+                            )
+                        {
+                            let _ = self.install(&project);
+                        }
+                        return;
+                    }
+                }
+            } else {
+                for i in 0..per {
+                    if hit(mods_row_rect(x, cw, 156.0 + i as f32 * 40.0)) {
+                        let _ = self.toggle_installed(self.page * per + i);
+                        return;
+                    }
+                }
+            }
+        }
+        if self.tab == Tab::Settings && hit(name_field_rect(w)) {
+            focus = Some(Field::Name);
+        } else if self.tab == Tab::Mods && self.mods_tab == ModsTab::Browse && hit(search_rect(w)) {
+            focus = Some(Field::Search);
+        } else if self.tab == Tab::Account
+            && !self.account.is_busy()
+            && self.account.phase != Phase::SignedIn
+            && hit(pin_rect(w, h))
+        {
+            focus = Some(Field::Pin);
+        }
+        self.clear_focus();
+        match focus {
+            Some(Field::Name) => self.name_focused = true,
+            Some(Field::Search) => self.search_focused = true,
+            Some(Field::Pin) => self.account.pin_focused = true,
+            None => {}
+        }
+    }
+
+    pub fn buttons(&self, w: f32, h: f32) -> Vec<LauncherButton> {
+        let mut buttons = Vec::new();
+        for (i, (label, id)) in [
+            (tr("nav_home"), 1),
+            (tr("nav_mods"), 2),
+            (tr("nav_account"), 3),
+            (tr("nav_settings"), 4),
+        ]
+        .into_iter()
+        .enumerate()
+        {
+            let r = nav_rect(i, w);
+            buttons.push(button(r, label, true, id, false));
+        }
+        let q = quit_rect(w, h);
+        buttons.push(button(q, tr("quit"), true, 5, false));
+        match self.tab {
+            Tab::Home => {
+                let (x, cw) = content(w);
+                // The hero's Play key, not a full-width bar: it reads as an
+                // action inside the card instead of a second title.
+                let r = [x + cw - 300.0, 134.0, 250.0, 78.0];
+                buttons.push(button(r, tr("home_play"), true, 10, true));
+                if self.recent.is_some() {
+                    buttons.push(button(
+                        [x + cw - 148.0, 514.0, 120.0, 46.0],
+                        tr("home_continue_play"),
+                        true,
+                        11,
+                        false,
+                    ));
+                }
+            }
+            Tab::Mods => {
+                let (x, cw) = content(w);
+                buttons.push(button(
+                    [x, 160.0, 120.0, 32.0],
+                    tr("mods_browse"),
+                    true,
+                    40,
+                    false,
+                ));
+                buttons.push(button(
+                    [x + 128.0, 160.0, 120.0, 32.0],
+                    tr("mods_installed"),
+                    true,
+                    41,
+                    false,
+                ));
+                buttons.push(button(
+                    [x + cw - 110.0, 160.0, 110.0, 32.0],
+                    tr("mods_update"),
+                    !self.index_busy,
+                    42,
+                    false,
+                ));
+                if self.mods_tab == ModsTab::Browse {
+                    buttons.push(button(
+                        [x, 196.0, 120.0, 26.0],
+                        &format!("{}: {}", tr("mods_filter"), self.filter_label()),
+                        true,
+                        43,
+                        false,
+                    ));
+                    let projects = self.filtered_projects();
+                    let pages = projects.len().div_ceil(self.page_size(h)).max(1);
+                    if pages > 1 {
+                        buttons.push(button(
+                            [x, h - 34.0, 78.0, 24.0],
+                            tr("mods_prev"),
+                            self.page > 0,
+                            44,
+                            false,
+                        ));
+                        buttons.push(button(
+                            [x + 84.0, h - 34.0, 78.0, 24.0],
+                            tr("mods_next"),
+                            self.page + 1 < pages,
+                            45,
+                            false,
+                        ));
+                    }
+                    let per = self.page_size(h);
+                    for (i, project) in projects.iter().skip(self.page * per).take(per).enumerate()
+                    {
+                        let row = mods_row_rect(x, cw, 286.0 + i as f32 * 80.0);
+                        let supported =
+                            matches!(&project.kind, Kind::Mod | Kind::ResourcePack | Kind::Shader);
+                        buttons.push(button(
+                            [row[0] + row[2] - 96.0, row[1] + 20.0, 88.0, 32.0],
+                            tr("mods_install"),
+                            supported && !self.install_busy && !self.index_busy,
+                            100 + i as u8,
+                            false,
+                        ));
+                    }
+                } else {
+                    let per = self.page_size(h);
+                    for (i, item) in self
+                        .installed
+                        .iter()
+                        .skip(self.page * per)
+                        .take(per)
+                        .enumerate()
+                    {
+                        let row = mods_row_rect(x, cw, 286.0 + i as f32 * 80.0);
+                        let toggle = match item.kind {
+                            InstalledKind::Mod => {
+                                if item.enabled {
+                                    tr("mods_on")
+                                } else {
+                                    tr("mods_off")
+                                }
+                            }
+                            InstalledKind::ResourcePack => {
+                                if item.enabled {
+                                    tr("mods_active")
+                                } else {
+                                    tr("mods_inactive")
+                                }
+                            }
+                            InstalledKind::Shader => tr("mods_shader"),
+                        };
+                        buttons.push(button(
+                            [row[0] + row[2] - 190.0, row[1] + 20.0, 86.0, 32.0],
+                            toggle,
+                            item.kind != InstalledKind::Shader,
+                            150 + i as u8,
+                            false,
+                        ));
+                        buttons.push(button(
+                            [row[0] + row[2] - 96.0, row[1] + 20.0, 88.0, 32.0],
+                            tr("mods_remove"),
+                            true,
+                            200 + i as u8,
+                            false,
+                        ));
+                    }
+                    let count = self.installed.len().div_ceil(per).max(1);
+                    if count > 1 {
+                        buttons.push(button(
+                            [x, h - 34.0, 78.0, 24.0],
+                            tr("mods_prev"),
+                            self.page > 0,
+                            44,
+                            false,
+                        ));
+                        buttons.push(button(
+                            [x + 84.0, h - 34.0, 78.0, 24.0],
+                            tr("mods_next"),
+                            self.page + 1 < count,
+                            45,
+                            false,
+                        ));
+                    }
+                }
+            }
+            Tab::Account => {
+                let (left, _) = account_cards(w);
+                let lx = left[0] + 14.0;
+                let lw = left[2] - 28.0;
+                let by = left[1] + 220.0;
+                match self.account.phase {
+                    Phase::SignedOut => {
+                        buttons.push(button(
+                            [lx, by, lw, 30.0],
+                            tr("account_sign_in"),
+                            true,
+                            20,
+                            true,
+                        ));
+                        buttons.push(button(
+                            [lx, by + 36.0, lw, 26.0],
+                            tr("account_load"),
+                            true,
+                            21,
+                            false,
+                        ));
+                    }
+                    Phase::Starting | Phase::Waiting | Phase::Completing => {
+                        buttons.push(button(
+                            [lx, by + 20.0, 120.0, 30.0],
+                            tr("account_cancel"),
+                            true,
+                            23,
+                            false,
+                        ));
+                    }
+                    Phase::SignedIn => {
+                        buttons.push(button(
+                            [lx, by, 120.0, 30.0],
+                            tr("account_sign_out"),
+                            true,
+                            22,
+                            false,
+                        ));
+                    }
+                    Phase::Failed | Phase::Cancelled => {
+                        let label = if self
+                            .account
+                            .error
+                            .as_deref()
+                            .is_some_and(|e| e.contains("expired"))
+                        {
+                            tr("account_new_code")
+                        } else {
+                            tr("account_retry")
+                        };
+                        buttons.push(button(
+                            [lx, by + 20.0, 112.0, 30.0],
+                            label,
+                            true,
+                            24,
+                            true,
+                        ));
+                        buttons.push(button(
+                            [lx + 120.0, by + 20.0, (lw - 120.0).max(80.0), 26.0],
+                            tr("account_load"),
+                            true,
+                            21,
+                            false,
+                        ));
+                    }
+                }
+            }
+            Tab::Settings => {
+                let (x, cw) = content(w);
+                let language = self.language_label();
+                buttons.push(button(
+                    [x + cw - 140.0, 160.0, 140.0, 32.0],
+                    &language,
+                    true,
+                    30,
+                    false,
+                ));
+                let resolution = format!("{}%", self.settings.horizon.resolution_scale);
+                buttons.push(button(
+                    [x + cw - 140.0, 288.0, 140.0, 32.0],
+                    &resolution,
+                    true,
+                    31,
+                    false,
+                ));
+                let audio = if cfg!(feature = "audio") {
+                    format!("{:.0}%", self.settings.master_volume * 100.0)
+                } else {
+                    tr("settings_audio_off").to_owned()
+                };
+                buttons.push(button(
+                    [x + cw - 140.0, 352.0, 140.0, 32.0],
+                    &audio,
+                    cfg!(feature = "audio"),
+                    32,
+                    false,
+                ));
+                let cursor = format!("{}%", self.settings.horizon.cursor_speed);
+                buttons.push(button(
+                    [x + cw - 140.0, 416.0, 140.0, 32.0],
+                    &cursor,
+                    true,
+                    34,
+                    false,
+                ));
+                let ui = format!("{}%", self.settings.horizon.launcher_scale);
+                buttons.push(button(
+                    [x + cw - 140.0, 480.0, 140.0, 32.0],
+                    &ui,
+                    true,
+                    35,
+                    false,
+                ));
+                buttons.push(button(
+                    [x + cw - 104.0, 256.0, 104.0, 30.0],
+                    tr("settings_save"),
+                    true,
+                    33,
+                    false,
+                ));
+            }
+        }
+        buttons
+    }
+
+    fn filter_label(&self) -> &'static str {
+        match self.filter {
+            KindFilter::All => tr("filter_all"),
+            KindFilter::Mod => tr("filter_mod"),
+            KindFilter::ResourcePack => tr("filter_pack"),
+            KindFilter::Shader => tr("filter_shader"),
+        }
+    }
+
+    pub fn click(
+        &mut self,
+        hit: Option<u8>,
+        x: f32,
+        y: f32,
+        w: f32,
+        h: f32,
+        _started: Instant,
+    ) -> Action {
+        let Some(id) = hit else {
+            self.background_click(x, y, w, h);
+            return Action::None;
+        };
+        match id {
+            1..=4 => {
+                self.clear_focus();
+                self.tab = match id {
+                    1 => Tab::Home,
+                    2 => Tab::Mods,
+                    3 => Tab::Account,
+                    _ => Tab::Settings,
+                };
+                self.page = 0;
+                if self.tab == Tab::Mods {
+                    self.refresh_installed();
+                } else if self.tab == Tab::Account {
+                    self.account.open();
+                }
+                Action::None
+            }
+            5 => Action::Quit,
+            10 => Action::LauncherPlay,
+            11 => self.recent.as_ref().map_or(Action::None, |world| Action::Play {
+                folder: world.folder.clone(),
+            }),
+            20 | 24 => {
+                self.account.pin_focused = false;
+                self.account.start_sign_in();
+                Action::None
+            }
+            21 => {
+                self.account.pin_focused = false;
+                self.account.start_load_saved();
+                Action::None
+            }
+            22 => {
+                self.account.pin_focused = false;
+                if let Err(e) = self.account.sign_out() {
+                    self.account.error = Some(e);
+                    self.account.phase = Phase::Failed;
+                }
+                Action::None
+            }
+            23 => {
+                self.account.cancel();
+                Action::None
+            }
+            30 => self.cycle_language(),
+            31 => self.cycle_resolution(),
+            32 => self.cycle_volume(),
+            34 => self.cycle_cursor_speed(),
+            35 => self.cycle_launcher_scale(),
+            33 => {
+                self.save_name();
+                Action::None
+            }
+            40 => {
+                self.mods_tab = ModsTab::Browse;
+                self.page = 0;
+                self.clear_focus();
+                Action::None
+            }
+            41 => {
+                self.mods_tab = ModsTab::Installed;
+                self.page = 0;
+                self.refresh_installed();
+                self.clear_focus();
+                Action::None
+            }
+            42 => {
+                self.refresh_index();
+                Action::None
+            }
+            43 => {
+                self.filter = match self.filter {
+                    KindFilter::All => KindFilter::Mod,
+                    KindFilter::Mod => KindFilter::ResourcePack,
+                    KindFilter::ResourcePack => KindFilter::Shader,
+                    KindFilter::Shader => KindFilter::All,
+                };
+                self.page = 0;
+                Action::None
+            }
+            44 => {
+                self.page = self.page.saturating_sub(1);
+                Action::None
+            }
+            45 => {
+                self.page += 1;
+                Action::None
+            }
+            100..=149 => {
+                let i = (id - 100) as usize;
+                let projects = self.filtered_projects();
+                let project = projects
+                    .get(self.page * self.page_size(h) + i)
+                    .copied()
+                    .cloned();
+                project.map_or(Action::None, |p| self.install(&p))
+            }
+            150..=199 => {
+                let i = (id - 150) as usize + self.page * self.page_size(h);
+                self.toggle_installed(i)
+            }
+            200..=249 => {
+                let i = (id - 200) as usize + self.page * self.page_size(h);
+                self.remove_installed(i)
+            }
+            _ => Action::None,
+        }
+    }
+}

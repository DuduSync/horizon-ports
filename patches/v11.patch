+    fn language_label(&self) -> String {
+        self.languages
+            .iter()
+            .find(|l| l.code == self.language)
+            .map(|l| l.label())
+            .unwrap_or_else(|| self.language.clone())
+    }
+
+    fn account_error_lines(&self, atlas: &HudAtlas, width: f32) -> Vec<String> {
+        let Some(error) = self.account.error.as_deref() else {
+            return if self.account.phase == Phase::Cancelled {
+                vec![tr("account_cancelled").to_owned()]
+            } else {
+                Vec::new()
+            };
+        };
+        let lines = if error == auth::NOT_CONFIGURED {
+            vec![
+                tr("account_not_configured").to_owned(),
+                tr("account_client_id_hint").to_owned(),
+            ]
+        } else if error == auth::SIGN_IN_AGAIN {
+            vec![tr("account_sign_in_again").to_owned()]
+        } else if error.contains("expired") {
+            vec![tr("account_expired").to_owned()]
+        } else if error.to_lowercase().contains("cancel") {
+            vec![tr("account_cancelled").to_owned()]
+        } else if error.contains("Could not unlock") {
+            vec![tr("account_wrong_pin").to_owned()]
+        } else if error.contains("worker stopped") {
+            vec![tr("account_worker_stopped").to_owned()]
+        } else {
+            vec![error.to_owned()]
+        };
+        lines
+            .iter()
+            .flat_map(|line| wrap(atlas, F_BODY, line, width))
+            .collect()
+    }
+
+    fn draw_button(
+        &self,
+        atlas: &HudAtlas,
+        batch: &mut HudBatch,
+        cursor: (f32, f32),
+        b: &LauncherButton,
+    ) {
+        crate::widgets::record(&b.label, [b.x, b.y, b.w, b.h], b.enabled);
+        crate::widgets::target([b.x, b.y, b.w, b.h]);
+        let hover = b.enabled && crate::ui::hovered(cursor, b.x, b.y, b.w, b.h);
+        crate::widgets::widget_cursor(hover, b.enabled);
+        let active = match b.id {
+            1 => self.tab == Tab::Home,
+            2 => self.tab == Tab::Mods,
+            3 => self.tab == Tab::Account,
+            4 => self.tab == Tab::Settings,
+            _ => false,
+        };
+        let fill = if !b.enabled {
+            SURFACE
+        } else if b.primary {
+            ACCENT
+        } else if active || hover {
+            SURFACE_2
+        } else {
+            SURFACE
+        };
+        fill_rounded(batch, atlas, [b.x, b.y, b.w, b.h], 10.0, BORDER);
+        fill_rounded(
+            batch,
+            atlas,
+            [b.x + 1.0, b.y + 1.0, b.w - 2.0, b.h - 2.0],
+            9.0,
+            fill,
+        );
+        if b.primary {
+            // A warm top edge, like light on a metal key.
+            batch.fill(
+                atlas,
+                b.x + 10.0,
+                b.y + 1.5,
+                b.w - 20.0,
+                1.5,
+                rgba(255, 238, 196, 190),
+            );
+        }
+        if (1..=4).contains(&b.id) {
+            if active {
+                batch.fill(atlas, b.x, b.y + 8.0, 3.0, b.h - 16.0, ACCENT);
+            }
+            let icon = if active {
+                ACCENT
+            } else if hover {
+                TEXT
+            } else {
+                MUTED
+            };
+            nav_icon(batch, atlas, b.id, b.x + 16.0, b.y + 12.0, icon);
+        }
+        if hover && !b.primary {
+            batch.fill(atlas, b.x + 1.0, b.y + 9.0, 2.0, b.h - 18.0, ACCENT);
+        }
+        let ink = if !b.enabled {
+            MUTED
+        } else if b.primary {
+            ACCENT_INK
+        } else if active {
+            ACCENT
+        } else {
+            TEXT
+        };
+        let font = if b.id == 10 {
+            F_PLAY
+        } else if (20..30).contains(&b.id) || b.id >= 100 {
+            F_SMALL
+        } else {
+            F_LABEL
+        };
+        let tw = text_width(atlas, font, &b.label);
+        let label = if tw > b.w - 10.0 {
+            truncate(atlas, font, &b.label, b.w - 10.0)
+        } else {
+            b.label.clone()
+        };
+        let tw = text_width(atlas, font, &label);
+        let nudge = match font {
+            F_PLAY => 15.0,
+            F_LABEL => 4.0,
+            F_SMALL => 3.0,
+            _ => 0.0,
+        };
+        let ty = b.y + (b.h - font_size(font)) / 2.0 + nudge;
+        let lx = if (1..=4).contains(&b.id) {
+            b.x + 42.0
+        } else {
+            b.x + ((b.w - tw) / 2.0).floor()
+        };
+        draw_text(batch, atlas, font, &label, lx, ty, ink);
+    }
+}
+
+fn nav_icon(batch: &mut HudBatch, atlas: &HudAtlas, id: u8, x: f32, y: f32, color: u32) {
+    match id {
+        1 => {
+            batch.fill_quad(
+                atlas,
+                [[x, y + 8.0], [x + 8.0, y], [x + 16.0, y + 8.0], [x + 8.0, y + 6.0]],
+                color,
+            );
+            batch.fill(atlas, x + 3.0, y + 8.0, 10.0, 8.0, color);
+        }
+        2 => {
+            for (dx, dy) in [(0.0, 0.0), (9.0, 0.0), (0.0, 9.0), (9.0, 9.0)] {
+                fill_rounded(batch, atlas, [x + dx, y + dy, 7.0, 7.0], 2.0, color);
+            }
+        }
+        3 => {
+            fill_rounded(batch, atlas, [x + 3.0, y + 1.0, 10.0, 10.0], 5.0, color);
+            fill_rounded(batch, atlas, [x + 1.0, y + 12.0, 14.0, 5.0], 2.5, color);
+        }
+        _ => {
+            for (dx, dy) in [
+                (0.0, 0.0), (6.0, 0.0), (12.0, 0.0),
+                (0.0, 6.0), (6.0, 6.0), (12.0, 6.0),
+                (0.0, 12.0), (6.0, 12.0), (12.0, 12.0),
+            ] {
+                batch.fill(atlas, x + dx, y + dy, 4.0, 4.0, color);
+            }
+        }
+    }
+}
+
+fn qr_extent(side: f32, qr: &Qr) -> f32 {
+    let margin = 4usize;
+    let total = qr.size() + margin * 2;
+    (side / total as f32).ceil().max(1.0) * total as f32
+}
+
+fn draw_qr(batch: &mut HudBatch, atlas: &HudAtlas, x: f32, y: f32, side: f32, qr: &Qr) -> f32 {
+    let margin = 4usize;
+    let total = qr.size() + margin * 2;
+    let cell = (side / total as f32).ceil().max(1.0);
+    let actual = cell * total as f32;
+    batch.fill(atlas, x, y, actual, actual, u32::MAX);
+    border(
+        batch,
+        atlas,
+        [x - 1.0, y - 1.0, actual + 2.0, actual + 2.0],
+        BORDER,
+    );
+    for yy in 0..qr.size() {
+        for xx in 0..qr.size() {
+            if qr.dark(xx, yy) {
+                batch.fill(
+                    atlas,
+                    x + (xx + margin) as f32 * cell,
+                    y + (yy + margin) as f32 * cell,
+                    cell,
+                    cell,
+                    rgba(8, 10, 14, 255),
+                );
+            }
+        }
+    }
+    actual
+}
+
+fn panel(batch: &mut HudBatch, atlas: &HudAtlas, r: [f32; 4], fill: u32, line: u32) {
+    // A 10 px radius reads as a card without looking like a phone app.
+    fill_rounded(batch, atlas, r, 10.0, line);
+    fill_rounded(
+        batch,
+        atlas,
+        [r[0] + 1.0, r[1] + 1.0, r[2] - 2.0, r[3] - 2.0],
+        9.0,
+        fill,
+    );
+    // A one-pixel top light keeps a flat card from reading as a hole.
+    if r[2] > 24.0 {
+        batch.fill(
+            atlas,
+            r[0] + 10.0,
+            r[1] + 1.0,
+            r[2] - 20.0,
+            1.0,
+            rgba(255, 255, 255, 12),
+        );
+    }
+}
+/// A filled rectangle with rounded corners, built from one-pixel spans so it
+/// works with the same `fill` the rest of the UI uses (no shader or mask).
+fn fill_rounded(batch: &mut HudBatch, atlas: &HudAtlas, r: [f32; 4], radius: f32, color: u32) {
+    let [x, y, w, h] = r;
+    let radius = radius.min(w / 2.0).min(h / 2.0).max(0.0);
+    if radius < 0.5 {
+        batch.fill(atlas, x, y, w, h, color);
+        return;
+    }
+    let steps = radius.ceil() as i32;
+    for i in 0..steps {
+        let dy = i as f32 + 0.5;
+        let dx = radius - (radius * radius - (radius - dy) * (radius - dy)).max(0.0).sqrt();
+        batch.fill(atlas, x + dx, y + i as f32, w - 2.0 * dx, 1.0, color);
+        batch.fill(
+            atlas,
+            x + dx,
+            y + h - 1.0 - i as f32,
+            w - 2.0 * dx,
+            1.0,
+            color,
+        );
+    }
+    batch.fill(
+        atlas,
+        x,
+        y + radius,
+        w,
+        (h - 2.0 * radius).max(0.0),
+        color,
+    );
+}
+/// A small capsule label, for the hero's status chips.
+fn pill(
+    batch: &mut HudBatch,
+    atlas: &HudAtlas,
+    x: f32,
+    y: f32,
+    label: &str,
+    ink: u32,
+    fill: u32,
+) -> f32 {
+    let width = text_width(atlas, F_SMALL, label) + 18.0;
+    fill_rounded(batch, atlas, [x, y, width, 20.0], 7.0, fill);
+    draw_text_top(batch, atlas, F_SMALL, label, x + 9.0, y + 4.0, ink);
+    width
+}
+fn border(batch: &mut HudBatch, atlas: &HudAtlas, r: [f32; 4], color: u32) {
+    batch.fill(atlas, r[0], r[1], r[2], 1.0, color);
+    batch.fill(atlas, r[0], r[1] + r[3] - 1.0, r[2], 1.0, color);
+    batch.fill(atlas, r[0], r[1], 1.0, r[3], color);
+    batch.fill(atlas, r[0] + r[2] - 1.0, r[1], 1.0, r[3], color);
+}
+/// The ascender of a launcher face, for laying out from the top edge.
+fn font_size(font: &str) -> f32 {
+    match font {
+        F_BIG => 58.0,
+        F_TITLE => 34.0,
+        F_CODE => 34.0,
+        F_CARD => 25.0,
+        F_PLAY => 30.0,
+        F_LABEL => 19.0,
+        F_BODY => 17.0,
+        F_SMALL => 15.0,
+        F_MONO => 13.0,
+        _ => 15.0,
+    }
+}
+
+fn ascent(font: &str) -> f32 {
+    // Calibrated against the software render of the real HudBatch: the
+    // small faces are laid out from their top, while the large faces carry
+    // their cap height above the origin.
+    match font {
+        F_BIG => 31.0,
+        F_TITLE => 16.0,
+        F_CODE => 16.0,
+        F_CARD => 13.0,
+        F_PLAY => 0.0,
+        F_LABEL => 0.0,
+        F_BODY => 0.0,
+        F_SMALL => 0.0,
+        F_MONO => 0.0,
+        _ => 0.0,
+    }
+}
+
+fn draw_text_top(
+    batch: &mut HudBatch,
+    atlas: &HudAtlas,
+    font: &str,
+    text: &str,
+    x: f32,
+    y: f32,
+    color: u32,
+) {
+    draw_text(batch, atlas, font, text, x, y + ascent(font), color);
+}
+
+fn draw_text(
+    batch: &mut HudBatch,
+    atlas: &HudAtlas,
+    font: &str,
+    text: &str,
+    x: f32,
+    y: f32,
+    color: u32,
+) {
+    if text.is_empty() {
+        return;
+    }
+    let text = Text::styled(
+        text,
+        Style {
+            font: Some(font.to_owned()),
+            ..Default::default()
+        },
+    );
+    batch.text_styled(atlas, &text, x, y, color, false);
+}
+fn text_width(atlas: &HudAtlas, font: &str, text: &str) -> f32 {
+    let text = Text::styled(
+        text,
+        Style {
+            font: Some(font.to_owned()),
+            ..Default::default()
+        },
+    );
+    atlas.font.width_text(&text)
+}
+fn wrap(atlas: &HudAtlas, font: &str, text: &str, width: f32) -> Vec<String> {
+    let text = Text::styled(
+        text,
+        Style {
+            font: Some(font.to_owned()),
+            ..Default::default()
+        },
+    );
+    atlas
+        .font
+        .split_lines(&text, width.max(40.0))
+        .iter()
+        .map(|(line, _)| line.plain())
+        .collect()
+}
+fn truncate(atlas: &HudAtlas, font: &str, text: &str, width: f32) -> String {
+    if text_width(atlas, font, text) <= width {
+        return text.to_owned();
+    }
+    let mut out = String::new();
+    for ch in text.chars() {
+        let mut candidate = out.clone();
+        candidate.push(ch);
+        candidate.push('…');
+        if text_width(atlas, font, &candidate) > width {
+            break;
+        }
+        out.push(ch);
+    }
+    out.push('…');
+    out
+}
+fn format_size(bytes: u64) -> String {
+    if bytes >= 1 << 20 {
+        format!("{:.1} MiB", bytes as f64 / (1 << 20) as f64)
+    } else if bytes >= 1 << 10 {
+        format!("{:.1} KiB", bytes as f64 / (1 << 10) as f64)
+    } else {
+        format!("{bytes} B")
+    }
+}
+fn pretty_code(code: &str) -> String {
+    let clean: String = code.chars().filter(|c| *c != '-').collect();
+    if clean.len() == 8 {
+        format!("{}-{}", &clean[..4], &clean[4..])
+    } else {

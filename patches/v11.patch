+// ----- Drawing -------------------------------------------------------------------------------------
+
+/// The launcher's Geist faces at the screen density. Idempotent per atlas and
+/// per density: the startup menu hands the title to the game with a new
+/// HudAtlas, and docking changes the density, so add the sets again then.
+fn ensure_launcher_fonts(font: &Font, density: f32) {
+    font.add_ttf_font(F_BODY, horizon_theme::fonts::GEIST_REGULAR, 17.0, density);
+    font.add_ttf_font(F_SMALL, horizon_theme::fonts::GEIST_REGULAR, 15.0, density);
+    font.add_ttf_font(F_LABEL, horizon_theme::fonts::GEIST_MEDIUM, 19.0, density);
+    font.add_ttf_font(F_TITLE, horizon_theme::fonts::GEIST_SEMIBOLD, 34.0, density);
+    font.add_ttf_font(F_BIG, horizon_theme::fonts::GEIST_SEMIBOLD, 58.0, density);
+    font.add_ttf_font(F_PLAY, horizon_theme::fonts::GEIST_SEMIBOLD, 30.0, density);
+    font.add_ttf_font(F_CARD, horizon_theme::fonts::GEIST_SEMIBOLD, 25.0, density);
+    font.add_ttf_font(F_CODE, horizon_theme::fonts::GEIST_SEMIBOLD, 34.0, density);
+    font.add_ttf_font(F_MONO, horizon_theme::fonts::GEIST_MONO, 13.0, density);
+}

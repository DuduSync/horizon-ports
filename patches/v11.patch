diff --git a/crates/horizon-client/src/version.rs b/crates/horizon-client/src/version.rs
new file mode 100644
index 0000000..8d179bd
--- /dev/null
+++ b/crates/horizon-client/src/version.rs
@@ -0,0 +1,18 @@
+//! One place for the launcher's identity. The Switch build reads `VERSION`
+//! from here for the NACP, and every screen that shows a version pulls the
+//! same constant, so a release changes this file only.
+//!
+//! Public naming: the title is `Horizon` with no version suffix; the version
+//! scheme is `0.1.N` for builds 1-8 and `0.2.(N-9)` from build 9 on. `v9` is
+//! therefore `0.2.0`.
+
+/// The application name shown by hbmenu and in the launcher.
+pub const NAME: &str = "Horizon";
+/// The NACP author field.
+pub const AUTHOR: &str = "Horizon";
+/// The release version; keep this the only line a release edits.
+pub const VERSION: &str = "0.2.2";
+/// The Minecraft: Java Edition line this port follows.
+pub const GAME: &str = "26.3";
+/// The edition banner under the launcher title.
+pub const EDITION: &str = "Java Edition 26.3";

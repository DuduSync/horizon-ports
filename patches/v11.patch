+                rgba(240, 190, 99, alpha),
+            );
+        }
+        panel(batch, atlas, [x, hero_y, cw, hero_h], SURFACE, BORDER);
+        batch.fill_gradient(
+            atlas,
+            (x + 12.0, hero_y + 12.0, cw - 24.0, hero_h - 24.0),
+            rgba(30, 40, 55, 255),
+            rgba(17, 23, 33, 255),
+        );
+        let pulse = 0.62 + 0.38 * (started.elapsed().as_secs_f32() * 2.2).sin().abs();
+        batch.fill(
+            atlas,
+            x + 1.0,
+            hero_y + 30.0,
+            3.0,
+            hero_h - 60.0,
+            rgba(240, 190, 99, (pulse * 255.0) as u8),

+/// The startup screen: the launcher's dark design, a brand mark and a
+/// determinate bar, drawn while the game's resources load.
+pub fn draw_loading(
+    atlas: &HudAtlas,
+    batch: &mut HudBatch,
+    line: &str,
+    progress: f32,
+    started: Instant,
+) {
+    ensure_launcher_fonts(&atlas.font, batch.scale);
+    let (w, h) = (batch.width, batch.height);
+    batch.fill(atlas, 0.0, 0.0, w, h, BG);
+    let x = (w * 0.08).max(28.0);
+    let pulse = 0.7 + 0.3 * ((started.elapsed().as_secs_f32() * 2.0).sin().abs());
+    draw_text(batch, atlas, F_BIG, "HORIZON", x, h * 0.14, ACCENT);
+    draw_text(
+        batch,
+        atlas,
+        F_SMALL,
+        &format!(
+            "NINTENDO SWITCH · {}",
+            crate::version::VERSION
+        ),
+        x + 2.0,
+        h * 0.14 + 46.0,
+        MUTED,
+    );
+    let bar_w = (w * 0.42).clamp(280.0, 520.0);
+    let bx = (w - bar_w) / 2.0;
+    let by = h * 0.60;
+    draw_text(batch, atlas, F_TITLE, tr("loading"), bx, by - 46.0, TEXT);
+    let status = truncate(atlas, F_SMALL, line, bar_w - 56.0);
+    draw_text(batch, atlas, F_SMALL, &status, bx, by + 12.0, MUTED);
+    let pct = format!("{}%", (progress.clamp(0.0, 1.0) * 100.0).round());
+    let pw = text_width(atlas, F_SMALL, &pct);
+    draw_text(batch, atlas, F_SMALL, &pct, bx + bar_w - pw, by + 12.0, MUTED);
+    batch.fill(atlas, bx, by, bar_w, 4.0, SURFACE_2);
+    batch.fill(
+        atlas,
+        bx,
+        by,
+        (bar_w * progress.clamp(0.0, 1.0)).floor(),
+        4.0,
+        rgba(224, 164, 58, (pulse * 255.0) as u8),
+    );
+    draw_text(batch, atlas, F_SMALL, tr("loading_hint"), x, h - 40.0, MUTED);
+}
+
+impl Launcher {
+    fn ensure_fonts(&self, font: &Font, density: f32) {
+        ensure_launcher_fonts(font, density);
+    }
+
+    pub fn draw(
+        &self,
+        atlas: &HudAtlas,
+        batch: &mut HudBatch,
+        cursor: (f32, f32),
+        started: Instant,
+    ) {
+        self.ensure_fonts(&atlas.font, batch.scale);
+        let (w, h) = (batch.width.ceil(), batch.height.ceil());
+        batch.fill_gradient(
+            atlas,
+            (0.0, 0.0, w, h),
+            rgba(7, 10, 16, 255),
+            rgba(10, 15, 23, 255),
+        );
+        batch.fill(atlas, 0.0, 0.0, sidebar_w(w), h, SIDEBAR);
+        batch.fill(atlas, sidebar_w(w) - 1.0, 0.0, 1.0, h, BORDER);
+        draw_text_top(batch, atlas, F_LABEL, tr("brand"), 18.0, 28.0, ACCENT);
+        draw_text_top(batch, atlas, F_SMALL, tr("brand_sub"), 18.0, 54.0, MUTED);
+        let version = format!(
+            "{} · {}",
+            crate::version::VERSION,
+            crate::version::GAME
+        );
+        let card_y = h - 112.0;
+        panel(
+            batch,
+            atlas,
+            [16.0, card_y, sidebar_w(w) - 32.0, 56.0],
+            SURFACE,
+            BORDER,
+        );
+        batch.fill(atlas, 28.0, card_y + 26.0, 6.0, 6.0, OK);
+        draw_text(
+            batch,
+            atlas,
+            F_SMALL,
+            tr("home_switch_status"),
+            40.0,
+            card_y + 32.0,
+            TEXT,
+        );
+        draw_text(batch, atlas, F_SMALL, &version, 28.0, card_y + 48.0, MUTED);
+        let ready = tr("home_ready_short");
+        let ready_w = text_width(atlas, F_SMALL, ready) + 18.0;
+        let _ = pill(
+            batch,
+            atlas,
+            w - 28.0 - ready_w,
+            28.0,
+            ready,
+            OK,
+            rgba(127, 211, 160, 28),
+        );
+        let active = match self.tab {
+            Tab::Home => 0,
+            Tab::Mods => 1,
+            Tab::Account => 2,
+            Tab::Settings => 3,
+        };
+        let [ax, ay, aw, ah] = nav_rect(active, w);
+        fill_rounded(batch, atlas, [ax, ay, aw, ah], 10.0, SURFACE_2);
+        batch.fill(atlas, ax, ay + 8.0, 3.0, ah - 16.0, ACCENT);
+        let x0 = sidebar_w(w) + 28.0;
+        draw_text_top(batch, atlas, F_SMALL, tr("breadcrumb_library"), x0, 26.0, MUTED);
+        draw_text_top(batch, atlas, F_SMALL, " / ", x0 + 78.0, 26.0, BORDER);
+        draw_text_top(
+            batch,
+            atlas,
+            F_SMALL,
+            match self.tab {
+                Tab::Home => tr("home_title"),
+                Tab::Mods => tr("mods_title"),
+                Tab::Account => tr("account_title"),
+                Tab::Settings => tr("settings_title"),
+            },
+            x0 + 98.0,
+            26.0,
+            TEXT,
+        );
+        if self.tab != Tab::Home {
+            let title = match self.tab {
+                Tab::Home => tr("home_title"),
+                Tab::Mods => tr("mods_title"),
+                Tab::Account => tr("account_title"),
+                Tab::Settings => tr("settings_title"),
+            };
+            let sub = match self.tab {
+                Tab::Home => tr("home_sub"),
+                Tab::Mods => tr("mods_sub"),
+                Tab::Account => tr("account_sub"),
+                Tab::Settings => tr("settings_sub"),
+            };
+            draw_text_top(batch, atlas, F_TITLE, title, x0, 72.0, TEXT);
+            draw_text_top(
+                batch,
+                atlas,
+                F_SMALL,
+                sub,
+                x0,
+                118.0,
+                if self.tab == Tab::Mods { WARN } else { MUTED },
+            );
+        }
+        match self.tab {
+            Tab::Home => self.draw_home(atlas, batch, w, h, started),
+            Tab::Mods => self.draw_mods(atlas, batch, cursor, w, h),
+            Tab::Account => self.draw_account(atlas, batch, w, h),
+            Tab::Settings => self.draw_settings(atlas, batch, w, h),
+        }
+        for b in self.buttons(w, h) {
+            // The pad navigates the same rectangles the mouse hits.
+            crate::widgets::record(&b.label, [b.x, b.y, b.w, b.h], b.enabled);
+            self.draw_button(atlas, batch, cursor, &b);
+        }
+        if let Some((message, error)) = &self.status {
+            let color = if *error { BAD } else { MUTED };
+            let message = truncate(atlas, F_SMALL, message, w - 36.0);
+            draw_text(batch, atlas, F_SMALL, &message, 18.0, h - 120.0, color);
+        }
+    }

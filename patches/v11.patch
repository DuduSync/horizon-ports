+/// The mouse pointer: a white arrow with a dark outline, rasterized at twice
+/// its drawing size with 4x4 supersampling. The tip is the top-left corner.
+fn cursor_image() -> Vec<u8> {
+    const W: u32 = 48;
+    const H: u32 = 72;
+    const ARROW: [(f32, f32); 7] = [
+        (4.0, 3.0),
+        (4.0, 60.0),
+        (16.0, 47.0),
+        (27.0, 70.0),
+        (38.0, 64.0),
+        (27.0, 41.0),
+        (44.0, 41.0),
+    ];
+    fn inside(px: f32, py: f32, arrow: &[(f32, f32)]) -> bool {
+        let mut hit = false;
+        let mut j = arrow.len() - 1;
+        for i in 0..arrow.len() {
+            let (xi, yi) = arrow[i];
+            let (xj, yj) = arrow[j];
+            if (yi > py) != (yj > py) && px < (xj - xi) * (py - yi) / (yj - yi) + xi {
+                hit = !hit;
+            }
+            j = i;
+        }
+        hit
+    }
+    let mut mask = vec![0u8; (W * H) as usize];
+    for y in 0..H {
+        for x in 0..W {
+            let mut hits = 0u32;
+            for sy in 0..4 {
+                for sx in 0..4 {
+                    let px = x as f32 + (sx as f32 + 0.5) / 4.0;
+                    let py = y as f32 + (sy as f32 + 0.5) / 4.0;
+                    if inside(px, py, &ARROW) {
+                        hits += 1;
+                    }
+                }
+            }
+            mask[(y * W + x) as usize] = (hits * 255 / 16) as u8;
+        }
+    }
+    let mut out = vec![0u8; (W * H * 4) as usize];
+    for y in 0..H {
+        for x in 0..W {
+            let i = (y * W + x) as usize;
+            let alpha = mask[i];
+            if alpha != 0 {
+                out[i * 4..i * 4 + 4].copy_from_slice(&[255, 255, 255, alpha]);
+                continue;
+            }
+            // A two-texel dark outline keeps the arrow readable on light plates.
+            let near = (y.saturating_sub(2)..=(y + 2).min(H - 1)).any(|ny| {
+                (x.saturating_sub(2)..=(x + 2).min(W - 1))
+                    .any(|nx| mask[(ny * W + nx) as usize] != 0)
+            });
+            if near {
+                out[i * 4..i * 4 + 4].copy_from_slice(&[8, 10, 14, 255]);
+            }
+        }
+    }
+    out
+}

+#[derive(Clone, Debug)]
+struct Request {
+    #[allow(dead_code)]
+    method: String,
+    path: String,
+    #[allow(dead_code)]
+    auth: String,
+    #[allow(dead_code)]
+    body: String,
+}
+
+/// What the mock answers and what it was asked.
+#[derive(Default)]
+struct Mock {
+    /// Polls left before the token endpoint stops saying authorization_pending.
+    pending: usize,
+    /// Polls that say slow_down first.
+    slow_downs: usize,
+    xerr: Option<u64>,
+    owns_game: bool,
+    no_profile: bool,
+    refuse_app: bool,
+    revoke_refresh: bool,
+    log: Vec<Request>,
+}
+
+fn reply(status: u16, body: Value) -> (u16, String) {
+    (status, body.to_string())
+}
+
+fn percent_decode(text: &str) -> String {
+    let bytes = text.as_bytes();
+    let mut out = Vec::with_capacity(bytes.len());
+    let mut i = 0;
+    while i < bytes.len() {
+        match bytes[i] {
+            b'+' => {
+                out.push(b' ');
+                i += 1;
+            }
+            b'%' if i + 2 < bytes.len() => match u8::from_str_radix(&text[i + 1..i + 3], 16) {
+                Ok(byte) => {
+                    out.push(byte);
+                    i += 3;
+                }
+                Err(_) => {
+                    out.push(bytes[i]);
+                    i += 1;
+                }
+            },
+            byte => {
+                out.push(byte);
+                i += 1;
+            }
+        }
+    }
+    String::from_utf8_lossy(&out).into_owned()
+}
+
+fn form(body: &str, key: &str) -> Option<String> {
+    body.split('&')
+        .filter_map(|pair| pair.split_once('='))
+        .find(|(name, _)| *name == key)
+        .map(|(_, value)| percent_decode(value))
+}
+
+fn route(mock: &mut Mock, method: &str, path: &str, auth: &str, body: &str) -> (u16, String) {
+    match (method, path) {
+        ("POST", "/ms/devicecode") => {
+            assert_eq!(form(body, "client_id").as_deref(), Some("test-client"));
+            assert_eq!(form(body, "scope").as_deref(), Some(SCOPE));
+            reply(
+                200,
+                json!({
+                    "user_code": "ABCD-EFGH",
+                    "device_code": "dev-1",
+                    "verification_uri": "https://www.microsoft.com/link",
+                    "expires_in": 900,
+                    "interval": 1,
+                }),
+            )
+        }
+        ("POST", "/ms/token") => match form(body, "grant_type").as_deref() {
+            Some("urn:ietf:params:oauth:grant-type:device_code") => {
+                if mock.slow_downs > 0 {
+                    mock.slow_downs -= 1;
+                    return reply(400, json!({"error": "slow_down"}));
+                }
+                if mock.pending > 0 {
+                    mock.pending -= 1;
+                    return reply(400, json!({"error": "authorization_pending"}));
+                }
+                assert_eq!(form(body, "device_code").as_deref(), Some("dev-1"));
+                assert_eq!(form(body, "client_id").as_deref(), Some("test-client"));
+                reply(
+                    200,
+                    json!({
+                        "access_token": "ms-access-1",
+                        "refresh_token": "ms-refresh-1",
+                        "expires_in": 3600,
+                    }),
+                )
+            }
+            Some("refresh_token") => {
+                if mock.revoke_refresh
+                    || form(body, "refresh_token").as_deref() != Some("ms-refresh-1")
+                {
+                    reply(400, json!({"error": "invalid_grant"}))
+                } else {
+                    reply(
+                        200,
+                        json!({
+                            "access_token": "ms-access-2",
+                            "refresh_token": "ms-refresh-2",
+                        }),
+                    )
+                }
+            }
+            _ => reply(400, json!({"error": "invalid_grant"})),
+        },
+        ("POST", "/xbl") => {
+            let value: Value = serde_json::from_str(body).unwrap();
+            assert!(
+                value["Properties"]["RpsTicket"]
+                    .as_str()
+                    .unwrap()
+                    .starts_with("d=ms-access-")
+            );
+            assert_eq!(value["RelyingParty"], "http://auth.xboxlive.com");
+            reply(
+                200,
+                json!({"Token": "xbl-token", "DisplayClaims": {"xui": [{"uhs": "uhs-1"}]}}),
+            )
+        }
+        ("POST", "/xsts") => {
+            let value: Value = serde_json::from_str(body).unwrap();
+            assert_eq!(value["Properties"]["UserTokens"][0], "xbl-token");
+            assert_eq!(value["RelyingParty"], "rp://api.minecraftservices.com/");
+            match mock.xerr {
+                Some(code) => reply(401, json!({"Identity": "0", "XErr": code, "Message": ""})),
+                None => reply(
+                    200,
+                    json!({
+                        "Token": "xsts-token",
+                        "DisplayClaims": {"xui": [{"uhs": "uhs-1", "xid": "2535400000000000"}]},
+                    }),
+                ),
+            }
+        }
+        ("POST", "/mc/authentication/login_with_xbox") => {
+            let value: Value = serde_json::from_str(body).unwrap();
+            assert_eq!(value["identityToken"], "XBL3.0 x=uhs-1;xsts-token");
+            if mock.refuse_app {
+                return reply(
+                    403,
+                    json!({"path": "/authentication/login_with_xbox", "errorType": "FORBIDDEN"}),
+                );
+            }
+            reply(
+                200,
+                json!({
+                    "username": "mock",
+                    "access_token": "mc-token",
+                    "token_type": "Bearer",
+                    "expires_in": 86400,
+                }),
+            )
+        }
+        ("GET", "/mc/entitlements/mcstore") => {
+            assert_eq!(auth, "Bearer mc-token");
+            let items = if mock.owns_game {
+                json!([
+                    {"name": "product_minecraft", "signature": "x"},
+                    {"name": "game_minecraft", "signature": "x"},
+                ])
+            } else {
+                json!([])
+            };
+            reply(200, json!({"items": items, "signature": "x", "keyId": "1"}))
+        }
+        ("GET", "/mc/minecraft/profile") if mock.no_profile => reply(
+            404,
+            json!({"path": "/minecraft/profile", "errorType": "NOT_FOUND", "error": "NOT_FOUND"}),
+        ),
+        ("GET", "/mc/minecraft/profile") => reply(
+            200,
+            json!({
+                "id": UUID,
+                "name": "Notch",
+                "skins": [{
+                    "id": "s1",
+                    "state": "ACTIVE",
+                    "url": "http://textures.minecraft.net/texture/abc",
+                    "variant": "SLIM",
+                }],
+                "capes": [
+                    {"id": "c1", "state": "INACTIVE", "url": "http://textures.minecraft.net/texture/cape1"},
+                    {"id": "c2", "state": "ACTIVE", "url": "http://textures.minecraft.net/texture/cape2"},
+                ],
+            }),
+        ),
+        _ => reply(404, json!({"error": "NotFound"})),
+    }
+}
+
+/// A one-thread HTTP/1.1 server: one request per connection.
+fn serve(mock: Arc<StdMutex<Mock>>) -> Endpoints {
+    let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+    let base = format!("http://{}", listener.local_addr().unwrap());
+    std::thread::spawn(move || {
+        for stream in listener.incoming() {
+            let Ok(mut stream) = stream else { continue };
+            let mut reader = BufReader::new(stream.try_clone().unwrap());
+            let mut line = String::new();
+            if reader.read_line(&mut line).is_err() {
+                continue;
+            }
+            let mut parts = line.split_whitespace();
+            let (method, path) = (
+                parts.next().unwrap_or("").to_owned(),
+                parts.next().unwrap_or("").to_owned(),
+            );
+            let (mut length, mut auth) = (0, String::new());
+            loop {
+                let mut header = String::new();
+                reader.read_line(&mut header).unwrap();
+                let header = header.trim_end();
+                if header.is_empty() {
+                    break;
+                }
+                let (key, value) = header.split_once(':').unwrap();
+                match key.to_ascii_lowercase().as_str() {
+                    "content-length" => length = value.trim().parse().unwrap(),
+                    "authorization" => auth = value.trim().to_owned(),
+                    _ => {}
+                }
+            }
+            let mut body = vec![0; length];
+            reader.read_exact(&mut body).unwrap();
+            let body = String::from_utf8(body).unwrap();
+            let (status, text) = {
+                let mut mock = mock.lock().unwrap();
+                mock.log.push(Request {
+                    method: method.clone(),
+                    path: path.clone(),
+                    auth: auth.clone(),
+                    body: body.clone(),
+                });
+                route(&mut mock, &method, &path, &auth, &body)
+            };
+            let _ = write!(
+                stream,
+                "HTTP/1.1 {status} X\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{text}",
+                text.len()
+            );
+        }
+    });
+    Endpoints {
+        microsoft: format!("{base}/ms"),
+        xbox_user: format!("{base}/xbl"),
+        xsts: format!("{base}/xsts"),
+        minecraft: format!("{base}/mc"),
+    }
+}
+
+fn mock(configure: impl FnOnce(&mut Mock)) -> (Arc<StdMutex<Mock>>, Endpoints) {
+    let mut mock = Mock {
+        owns_game: true,
+        ..Default::default()
+    };
+    configure(&mut mock);
+    let mock = Arc::new(StdMutex::new(mock));
+    let endpoints = serve(mock.clone());
+    (mock, endpoints)
+}
+
+fn paths(mock: &Arc<StdMutex<Mock>>) -> Vec<String> {
+    mock.lock()
+        .unwrap()
+        .log
+        .iter()
+        .map(|request| request.path.clone())
+        .collect()
+}

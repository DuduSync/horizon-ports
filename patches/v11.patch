+        for (i, alpha) in [(0u8, 10u8), (10, 8), (20, 6)] {
+            fill_rounded(
+                batch,
+                atlas,
+                [
+                    x + cw - 280.0 - i as f32,
+                    hero_y - 30.0 - i as f32,
+                    300.0 + i as f32 * 2.0,
+                    180.0 + i as f32 * 2.0,

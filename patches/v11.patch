+        panel(batch, atlas, [x, cards_y, card_w, 104.0], SURFACE, BORDER);
+        draw_text_top(
+            batch,
+            atlas,
+            F_SMALL,
+            tr("home_account"),
+            x + 18.0,
+            cards_y + 16.0,

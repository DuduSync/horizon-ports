+        let x2 = x + card_w + 16.0;
+        panel(batch, atlas, [x2, cards_y, card_w, 104.0], SURFACE, BORDER);
+        draw_text_top(
+            batch,
+            atlas,
+            F_SMALL,
+            tr("home_mods"),
+            x2 + 18.0,

+        // Continue: the most recent save, as a card with a tiny block icon.
+        draw_text_top(batch, atlas, F_TITLE, tr("home_continue"), x, 438.0, TEXT);
+        draw_text_top(
+            batch,
+            atlas,
+            F_SMALL,
+            tr("home_continue_sub"),
+            x + 170.0,
+            447.0,
+            MUTED,
+        );
+        let world_y = 480.0;
+        panel(batch, atlas, [x, world_y, cw, 116.0], SURFACE, BORDER);
+        let (tx, ty) = (x + 18.0, world_y + 18.0);
+        fill_rounded(batch, atlas, [tx, ty, 80.0, 80.0], 10.0, SURFACE_2);
+        batch.fill_quad(
+            atlas,
+            [
+                [tx + 40.0, ty + 14.0],
+                [tx + 68.0, ty + 30.0],
+                [tx + 40.0, ty + 46.0],
+                [tx + 12.0, ty + 30.0],

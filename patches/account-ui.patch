+#[test]
+fn account_screen_switches_buttons_with_the_sign_in_state() {
+    let mut f = Fixture::new();
+    f.title.mode = Mode::Account;
+    f.title.account.phase = crate::account_ui::Phase::SignedOut;
+    let labels = |f: &Fixture| -> Vec<String> {
+        f.title
+            .buttons(480.0, 262.0)
+            .into_iter()
+            .map(|b| b.label)
+            .collect()
+    };
+    let idle = labels(&f);
+    assert!(idle.contains(&launcher::tr("account_sign_in").to_owned()));
+    assert!(idle.contains(&launcher::tr("account_load").to_owned()));
+    assert!(idle.contains(&launcher::tr("back").to_owned()));
+
+    // The PIN field is a focus target only while it can be edited.
+    let field = account_field_rect(480.0);
+    f.title
+        .click(field[0] + 4.0, field[1] + 4.0, (480.0, 262.0));
+    assert!(f.title.account.pin_focused);
+    f.title.account.phase = crate::account_ui::Phase::Waiting;
+    f.title
+        .click(field[0] + 4.0, field[1] + 4.0, (480.0, 262.0));
+    assert!(
+        !f.title.account.pin_focused,
+        "the PIN is frozen while waiting"
+    );
+    let waiting = labels(&f);
+    assert!(waiting.contains(&launcher::tr("account_cancel").to_owned()));
+    assert!(!waiting.contains(&launcher::tr("account_sign_in").to_owned()));
+
+    f.title.account.phase = crate::account_ui::Phase::SignedIn;
+    let signed_in = labels(&f);
+    assert!(signed_in.contains(&launcher::tr("account_sign_out").to_owned()));
+    assert!(!signed_in.contains(&launcher::tr("account_sign_in").to_owned()));
+}

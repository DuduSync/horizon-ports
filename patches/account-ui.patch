+    /// The Account screen's error, with the messages the player can act on
+    /// translated. Unknown errors (network, OAuth) stay as the auth module
+    /// wrote them; none contains a token.
+    fn account_error_lines(&self, atlas: &HudAtlas, w: f32) -> Vec<String> {
+        let Some(error) = self.account.error.as_deref() else {
+            return if self.account.phase == account_ui::Phase::Cancelled {
+                vec![launcher::tr("account_cancelled").to_owned()]
+            } else {
+                Vec::new()
+            };
+        };
+        let lines = if error == crate::auth::NOT_CONFIGURED {
+            vec![
+                launcher::tr("account_not_configured").to_owned(),
+                launcher::tr("account_client_id_hint").to_owned(),
+            ]
+        } else if error == crate::auth::SIGN_IN_AGAIN {
+            vec![launcher::tr("account_sign_in_again").to_owned()]
+        } else if error.contains("expired") {
+            vec![launcher::tr("account_expired").to_owned()]
+        } else if error.to_lowercase().contains("cancel") {
+            vec![launcher::tr("account_cancelled").to_owned()]
+        } else if error.contains("Could not unlock") {
+            vec![launcher::tr("account_wrong_pin").to_owned()]
+        } else if error.contains("worker stopped") {
+            vec![launcher::tr("account_worker_stopped").to_owned()]
+        } else {
+            vec![error.to_owned()]
+        };
+        lines
+            .iter()
+            .flat_map(|line| wrapped(atlas, line, w - 60.0))
+            .collect()
+    }

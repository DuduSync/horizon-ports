+#[test]
+fn account_not_configured_points_at_the_client_id_file() {
+    let mut f = Fixture::new();
+    f.title.account.phase = crate::account_ui::Phase::Failed;
+    f.title.account.error = Some(crate::auth::NOT_CONFIGURED.to_owned());
+    let atlas = crate::hud::HudAtlas::build(Path::new("/nonexistent/horizon-test-assets")).unwrap();
+    let lines = f.title.account_error_lines(&atlas, 480.0);
+    assert!(
+        lines.iter().any(|line| line.contains("msa-client-id.txt")),
+        "the hint must point at the client ID file: {lines:?}"
+    );

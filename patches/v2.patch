+// ----- Drawing -------------------------------------------------------------------------------------
+
+impl Launcher {
+    fn ensure_fonts(&self, font: &Font) {
+        // Idempotent per atlas: the startup menu hands the title to the game
+        // with a new HudAtlas, so add the sets again when that happens.
+        font.add_ttf_font(F_BODY, horizon_theme::fonts::GEIST_REGULAR, 13.0);
+        font.add_ttf_font(F_SMALL, horizon_theme::fonts::GEIST_REGULAR, 11.0);
+        font.add_ttf_font(F_LABEL, horizon_theme::fonts::GEIST_MEDIUM, 15.0);
+        font.add_ttf_font(F_TITLE, horizon_theme::fonts::GEIST_SEMIBOLD, 28.0);
+        font.add_ttf_font(F_BIG, horizon_theme::fonts::GEIST_SEMIBOLD, 40.0);
+        font.add_ttf_font(F_CODE, horizon_theme::fonts::GEIST_SEMIBOLD, 34.0);
+        font.add_ttf_font(F_MONO, horizon_theme::fonts::GEIST_MONO, 12.0);
+    }
+
+    pub fn draw(
+        &self,
+        atlas: &HudAtlas,
+        batch: &mut HudBatch,
+        cursor: (f32, f32),
+        _started: Instant,
+    ) {
+        self.ensure_fonts(&atlas.font);
+        let (w, h) = (batch.width.ceil(), batch.height.ceil());
+        batch.fill(atlas, 0.0, 0.0, w, h, BG);
+        batch.fill(atlas, 0.0, 0.0, sidebar_w(w), h, SIDEBAR);
+        batch.fill(atlas, sidebar_w(w) - 1.0, 0.0, 1.0, h, BORDER);
+        draw_text(batch, atlas, F_LABEL, tr("brand"), 18.0, 34.0, ACCENT);
+        draw_text(batch, atlas, F_SMALL, tr("brand_sub"), 18.0, 54.0, MUTED);
+        let active = match self.tab {
+            Tab::Home => 0,
+            Tab::Mods => 1,
+            Tab::Account => 2,
+            Tab::Settings => 3,
+        };
+        let [ax, ay, aw, ah] = nav_rect(active, w);
+        batch.fill(atlas, ax, ay, aw, ah, SURFACE_2);
+        batch.fill(atlas, ax, ay, 3.0, ah, ACCENT);
+        let title = match self.tab {
+            Tab::Home => tr("home_title"),
+            Tab::Mods => tr("mods_title"),
+            Tab::Account => tr("account_title"),
+            Tab::Settings => tr("settings_title"),
+        };
+        draw_text(
+            batch,
+            atlas,
+            F_TITLE,
+            title,
+            sidebar_w(w) + 28.0,
+            38.0,
+            TEXT,
+        );
+        let sub = match self.tab {
+            Tab::Home => tr("home_sub"),
+            Tab::Mods => tr("mods_sub"),
+            Tab::Account => tr("account_sub"),
+            Tab::Settings => tr("settings_sub"),
+        };
+        draw_text(
+            batch,
+            atlas,
+            F_SMALL,
+            sub,
+            sidebar_w(w) + 28.0,
+            64.0,
+            if self.tab == Tab::Mods { WARN } else { MUTED },
+        );
+        match self.tab {
+            Tab::Home => self.draw_home(atlas, batch, w, h),
+            Tab::Mods => self.draw_mods(atlas, batch, w, h),
+            Tab::Account => self.draw_account(atlas, batch, w, h),
+            Tab::Settings => self.draw_settings(atlas, batch, w, h),
+        }
+        for b in self.buttons(w, h) {
+            self.draw_button(atlas, batch, cursor, &b);
+        }
+        if let Some((message, error)) = &self.status {
+            let color = if *error { BAD } else { MUTED };
+            let message = truncate(atlas, F_SMALL, message, w - 36.0);
+            draw_text(batch, atlas, F_SMALL, &message, 18.0, h - 16.0, color);
+        }
+    }

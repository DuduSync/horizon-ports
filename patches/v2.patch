+pub fn tr(key: &'static str) -> &'static str {
+    let table = if crate::lang::code().starts_with("pt_br") {
+        PT_BR
+    } else {
+        EN_US
+    };
+    table
+        .iter()
+        .find_map(|(k, v)| (*k == key).then_some(*v))
+        .unwrap_or(key)
+}

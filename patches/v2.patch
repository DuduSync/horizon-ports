+    fn draw_mods(&self, atlas: &HudAtlas, batch: &mut HudBatch, w: f32, h: f32) {
+        let (x, cw) = content(w);
+        let y = 134.0;
+        let warning = if cfg!(feature = "mods") {
+            tr("mods_shader")
+        } else {
+            tr("mods_warning")
+        };
+        for (i, line) in wrap(atlas, F_SMALL, warning, cw).iter().take(2).enumerate() {
+            draw_text(batch, atlas, F_SMALL, line, x, y + i as f32 * 10.0, WARN);
+        }
+        if self.mods_tab == ModsTab::Browse {
+            self.draw_search_field(atlas, batch, w);
+            let per = self.page_size(h);
+            let projects = self.filtered_projects();
+            if self.index.is_none() {
+                draw_text(batch, atlas, F_BODY, &self.index_status, x, 162.0, MUTED);
+            } else {
+                for (i, project) in projects.iter().skip(self.page * per).take(per).enumerate() {
+                    let row = mods_row_rect(x, cw, 156.0 + i as f32 * 36.0);
+                    panel(batch, atlas, row, SURFACE, BORDER);
+                    let version = project.versions.first();
+                    let title = format!(
+                        "{}  {}",
+                        project.name,
+                        version.map_or_else(|| "-".into(), |v| v.version.clone())
+                    );
+                    draw_text(
+                        batch,
+                        atlas,
+                        F_LABEL,
+                        &truncate(atlas, F_LABEL, &title, row[2] - 110.0),
+                        row[0] + 10.0,
+                        row[1] + 3.0,
+                        TEXT,
+                    );
+                    let info = format!(
+                        "{} · {} · {}",
+                        Self::kind_label(&project.kind),
+                        project.summary,
+                        format_size(version.map_or(0, |v| v.file.size))
+                    );
+                    draw_text(
+                        batch,
+                        atlas,
+                        F_SMALL,
+                        &truncate(atlas, F_SMALL, &info, row[2] - 110.0),
+                        row[0] + 10.0,
+                        row[1] + 17.0,
+                        MUTED,
+                    );
+                }
+                if projects.is_empty() {
+                    draw_text(batch, atlas, F_BODY, tr("mods_no_items"), x, 162.0, MUTED);
+                }
+            }
+            draw_text(
+                batch,
+                atlas,
+                F_SMALL,
+                &self.index_status,
+                x,
+                h - 50.0,
+                MUTED,
+            );
+        } else {
+            let per = self.page_size(h);
+            if self.installed.is_empty() {
+                draw_text(batch, atlas, F_BODY, tr("mods_no_items"), x, 162.0, MUTED);
+            }
+            for (i, item) in self
+                .installed
+                .iter()
+                .skip(self.page * per)
+                .take(per)
+                .enumerate()
+            {
+                let row = mods_row_rect(x, cw, 156.0 + i as f32 * 40.0);
+                panel(batch, atlas, row, SURFACE, BORDER);
+                draw_text(
+                    batch,
+                    atlas,
+                    F_LABEL,
+                    &truncate(atlas, F_LABEL, &item.title, row[2] - 200.0),
+                    row[0] + 10.0,
+                    row[1] + 5.0,
+                    TEXT,
+                );
+                let info = format!(
+                    "{} · {} {}",
+                    item.file,
+                    item.id,
+                    if item.version.is_empty() {
+                        String::new()
+                    } else {
+                        format!("v{}", item.version)
+                    }
+                );
+                draw_text(
+                    batch,
+                    atlas,
+                    F_SMALL,
+                    &truncate(atlas, F_SMALL, &info, row[2] - 200.0),
+                    row[0] + 10.0,
+                    row[1] + 19.0,
+                    MUTED,
+                );
+            }
+        }
+        if let Some((received, total)) = self.install_progress {
+            let frac = if total == 0 {
+                0.0
+            } else {
+                (received as f32 / total as f32).clamp(0.0, 1.0)
+            };
+            let bar = [x, h - 46.0, cw, 6.0];
+            batch.fill(atlas, bar[0], bar[1], bar[2], bar[3], SURFACE_2);
+            batch.fill(
+                atlas,
+                bar[0],
+                bar[1],
+                (bar[2] * frac).floor(),
+                bar[3],
+                ACCENT,
+            );
+        }
+        if let Some(status) = &self.install_status {
+            draw_text(
+                batch,
+                atlas,
+                F_SMALL,
+                &truncate(atlas, F_SMALL, status, cw),
+                x,
+                h - 34.0,
+                MUTED,
+            );
+        }
+    }

+#[test]
+fn device_code_poll_and_the_whole_chain() {
+    let _guard = serial();
+    clear_current();
+    let (mock, endpoints) = mock(|mock| {
+        mock.slow_downs = 1;
+        mock.pending = 1;
+    });
+    let mut flow = begin_device_code_at(endpoints, "test-client").unwrap();
+    assert_eq!(
+        (
+            flow.device.user_code.as_str(),
+            flow.device.verification_uri.as_str(),
+            flow.device.interval,
+        ),
+        ("ABCD-EFGH", "https://www.microsoft.com/link", 1)
+    );
+    // The device code itself is a secret: never in Debug.
+    assert!(!format!("{flow:?}").contains("dev-1"));
+
+    assert_eq!(poll(&mut flow).unwrap(), Poll::SlowDown);
+    assert_eq!(poll(&mut flow).unwrap(), Poll::Pending);
+    assert_eq!(poll(&mut flow).unwrap(), Poll::Authorized);
+    // Polling after approval is local and idempotent.
+    let before = paths(&mock).len();
+    assert_eq!(poll(&mut flow).unwrap(), Poll::Authorized);
+    assert_eq!(paths(&mock).len(), before);
+
+    let signed = complete(flow).unwrap();
+    assert_eq!(signed.account, sample_account());
+    let current = super::super::current().unwrap();
+    assert_eq!(
+        (current.name.as_str(), current.uuid, current.xuid.as_deref()),
+        (
+            "Notch",
+            0x069a79f444e94726a5befca90e38aaf5,
+            Some("2535400000000000")
+        )
+    );
+    assert_eq!(
+        paths(&mock),
+        [
+            "/ms/devicecode",
+            "/ms/token",
+            "/ms/token",
+            "/ms/token",
+            "/xbl",
+            "/xsts",
+            "/mc/authentication/login_with_xbox",
+            "/mc/entitlements/mcstore",
+            "/mc/minecraft/profile",
+        ]
+    );
+    // Neither the debug output nor the public account carries a token.
+    let debug = format!("{signed:?}");
+    assert!(!debug.contains("ms-refresh-1") && !debug.contains("mc-token"));
+    let json = serde_json::to_string(&signed.account).unwrap();
+    assert!(!json.contains("token"));
+    clear_current();
+}

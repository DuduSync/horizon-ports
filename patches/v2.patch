+    fn draw_account(&self, atlas: &HudAtlas, batch: &mut HudBatch, w: f32, h: f32) {
+        let (x, cw) = content(w);
+        let right_x = x + 240.0;
+        let right_w = (x + cw - right_x).max(120.0);
+        match self.account.phase {
+            Phase::SignedIn => {
+                panel(
+                    batch,
+                    atlas,
+                    [x, 96.0, cw.min(420.0), 96.0],
+                    SURFACE,
+                    BORDER,
+                );
+                draw_text(
+                    batch,
+                    atlas,
+                    F_SMALL,
+                    tr("account_signed_in"),
+                    x + 14.0,
+                    106.0,
+                    OK,
+                );
+                draw_text(
+                    batch,
+                    atlas,
+                    F_TITLE,
+                    &self.account.account_name,
+                    x + 14.0,
+                    126.0,
+                    TEXT,
+                );
+                draw_text(
+                    batch,
+                    atlas,
+                    F_MONO,
+                    &self.account.account_uuid,
+                    x + 14.0,
+                    164.0,
+                    MUTED,
+                );
+                if let Some(notice) = &self.account.notice {
+                    for (i, line) in wrap(atlas, F_SMALL, notice, cw.min(420.0) - 28.0)
+                        .iter()
+                        .take(2)
+                        .enumerate()
+                    {
+                        draw_text(
+                            batch,
+                            atlas,
+                            F_SMALL,
+                            line,
+                            x + 14.0,
+                            204.0 + i as f32 * 9.0,
+                            WARN,
+                        );
+                    }
+                }
+                draw_text(
+                    batch,
+                    atlas,
+                    F_SMALL,
+                    tr("account_signed_in_help"),
+                    x,
+                    260.0,
+                    MUTED,
+                );
+            }
+            Phase::Starting | Phase::Waiting | Phase::Completing => {
+                let side = 200.0;
+                if let Some(qr) = &self.account.qr {
+                    draw_qr(batch, atlas, x, 96.0, side, qr);
+                }
+                draw_text(
+                    batch,
+                    atlas,
+                    F_SMALL,
+                    tr("account_code_label"),
+                    right_x,
+                    96.0,
+                    MUTED,
+                );
+                let code = pretty_code(&self.account.user_code);
+                draw_text(batch, atlas, F_CODE, &code, right_x, 116.0, ACCENT);
+                let uri = truncate(atlas, F_SMALL, &self.account.verification_uri, right_w);
+                draw_text(batch, atlas, F_SMALL, &uri, right_x, 166.0, TEXT);
+                for (i, line) in wrap(atlas, F_SMALL, tr("account_qr_hint"), right_w)
+                    .iter()
+                    .take(3)
+                    .enumerate()
+                {
+                    draw_text(
+                        batch,
+                        atlas,
+                        F_SMALL,
+                        line,
+                        right_x,
+                        182.0 + i as f32 * 10.0,
+                        MUTED,
+                    );
+                }
+                let status = match self.account.phase {
+                    Phase::Starting => tr("account_starting"),
+                    Phase::Waiting => tr("account_waiting"),
+                    _ => tr("account_completing"),
+                };
+                draw_text(batch, atlas, F_SMALL, status, x, 282.0, WARN);
+            }
+            Phase::SignedOut => {
+                draw_text(batch, atlas, F_TITLE, tr("account_offline"), x, 106.0, TEXT);
+                for (i, line) in wrap(atlas, F_SMALL, tr("account_offline_note"), cw.min(420.0))
+                    .iter()
+                    .take(2)
+                    .enumerate()
+                {
+                    draw_text(
+                        batch,
+                        atlas,
+                        F_SMALL,
+                        line,
+                        x,
+                        146.0 + i as f32 * 10.0,
+                        MUTED,
+                    );
+                }
+            }
+            Phase::Failed | Phase::Cancelled => {
+                let color = if self.account.phase == Phase::Failed {
+                    BAD
+                } else {
+                    WARN
+                };
+                for (i, line) in self
+                    .account_error_lines(atlas, cw.min(420.0))
+                    .iter()
+                    .take(6)
+                    .enumerate()
+                {
+                    draw_text(
+                        batch,
+                        atlas,
+                        F_BODY,
+                        line,
+                        x,
+                        100.0 + i as f32 * 16.0,
+                        color,
+                    );
+                }
+            }
+        }
+        self.draw_pin_field(atlas, batch, w, h);
+        if let Some(notice) = &self.account.notice {
+            if self.account.phase != Phase::SignedIn {
+                draw_text(
+                    batch,
+                    atlas,
+                    F_SMALL,
+                    &truncate(atlas, F_SMALL, notice, cw),
+                    x,
+                    288.0,
+                    WARN,
+                );
+            }
+        }
+    }

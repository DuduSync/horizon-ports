new file mode 100644
index 0000000..6480f81
--- /dev/null
+++ b/crates/horizon-client/src/qr.rs
@@ -0,0 +1,55 @@
+//! A QR code for the account screen. `qrcodegen` does the encoding; this
+//! module only keeps the module matrix, so the launcher draws it with the
+//! HUD's own rectangles and needs no image dependency.
+use qrcodegen::{QrCode, QrCodeEcc};
+
+/// A square QR matrix, dark modules true.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Qr {
+    size: usize,
+    modules: Vec<bool>,
+}
+
+impl Qr {
+    /// Encode `text` at the lowest error correction: the device-code URL is
+    /// short and the screen is not a printed label.
+    pub fn encode(text: &str) -> Option<Self> {
+        let code = QrCode::encode_text(text, QrCodeEcc::Low).ok()?;
+        let size = code.size() as usize;
+        let mut modules = Vec::with_capacity(size * size);
+        for y in 0..size {
+            for x in 0..size {
+                modules.push(code.get_module(x as i32, y as i32));
+            }
+        }
+        Some(Self { size, modules })
+    }
+    pub fn size(&self) -> usize {
+        self.size
+    }
+    pub fn dark(&self, x: usize, y: usize) -> bool {
+        x < self.size
+            && y < self.size
+            && self
+                .modules
+                .get(y * self.size + x)
+                .copied()
+                .unwrap_or(false)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_device_code_url_encodes_with_finder_patterns() {
+        let qr = Qr::encode("https://www.microsoft.com/link").unwrap();
+        assert!(qr.size() >= 21);
+        // The three finder patterns start with a dark corner module.
+        for (x, y) in [(0, 0), (qr.size() - 1, 0), (0, qr.size() - 1)] {
+            assert!(qr.dark(x, y), "finder corner at {x},{y}");
+        }
+        assert!(!qr.dark(qr.size(), 0));
+    }
+}

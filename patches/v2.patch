+    pub fn buttons(&self, w: f32, h: f32) -> Vec<LauncherButton> {
+        let mut buttons = Vec::new();
+        for (i, (label, id)) in [
+            (tr("nav_home"), 1),
+            (tr("nav_mods"), 2),
+            (tr("nav_account"), 3),
+            (tr("nav_settings"), 4),
+        ]
+        .into_iter()
+        .enumerate()
+        {
+            let r = nav_rect(i, w);
+            buttons.push(button(r, label, true, id, false));
+        }
+        let q = quit_rect(w, h);
+        buttons.push(button(q, tr("quit"), true, 5, false));
+        match self.tab {
+            Tab::Home => {
+                let (x, cw) = content(w);
+                let r = [x, 96.0, cw.min(330.0), 64.0];
+                buttons.push(button(r, tr("home_play"), true, 10, true));
+            }
+            Tab::Mods => {
+                let (x, cw) = content(w);
+                buttons.push(button(
+                    [x, 76.0, 92.0, 24.0],
+                    tr("mods_browse"),
+                    true,
+                    40,
+                    false,
+                ));
+                buttons.push(button(
+                    [x + 98.0, 76.0, 92.0, 24.0],
+                    tr("mods_installed"),
+                    true,
+                    41,
+                    false,
+                ));
+                buttons.push(button(
+                    [x + cw - 102.0, 76.0, 102.0, 24.0],
+                    tr("mods_update"),
+                    !self.index_busy,
+                    42,
+                    false,
+                ));
+                if self.mods_tab == ModsTab::Browse {
+                    buttons.push(button(
+                        [x, 106.0, 120.0, 24.0],
+                        &format!("{}: {}", tr("mods_filter"), self.filter_label()),
+                        true,
+                        43,
+                        false,
+                    ));
+                    let projects = self.filtered_projects();
+                    let pages = projects.len().div_ceil(self.page_size(h)).max(1);
+                    if pages > 1 {
+                        buttons.push(button(
+                            [x, h - 34.0, 78.0, 24.0],
+                            tr("mods_prev"),
+                            self.page > 0,
+                            44,
+                            false,
+                        ));
+                        buttons.push(button(
+                            [x + 84.0, h - 34.0, 78.0, 24.0],
+                            tr("mods_next"),
+                            self.page + 1 < pages,
+                            45,
+                            false,
+                        ));
+                    }
+                    let per = self.page_size(h);
+                    for (i, project) in projects.iter().skip(self.page * per).take(per).enumerate()
+                    {
+                        let row = mods_row_rect(x, cw, 156.0 + i as f32 * 36.0);
+                        let supported =
+                            matches!(&project.kind, Kind::Mod | Kind::ResourcePack | Kind::Shader);
+                        buttons.push(button(
+                            [row[0] + row[2] - 88.0, row[1] + 4.0, 84.0, 26.0],
+                            tr("mods_install"),
+                            supported && !self.install_busy,
+                            100 + i as u8,
+                            false,
+                        ));
+                    }
+                } else {
+                    let per = self.page_size(h);
+                    for (i, item) in self
+                        .installed
+                        .iter()
+                        .skip(self.page * per)
+                        .take(per)
+                        .enumerate()
+                    {
+                        let row = mods_row_rect(x, cw, 156.0 + i as f32 * 40.0);
+                        let toggle = match item.kind {
+                            InstalledKind::Mod => {
+                                if item.enabled {
+                                    tr("mods_on")
+                                } else {
+                                    tr("mods_off")
+                                }
+                            }
+                            InstalledKind::ResourcePack => {
+                                if item.enabled {
+                                    tr("mods_active")
+                                } else {
+                                    tr("mods_inactive")
+                                }
+                            }
+                            InstalledKind::Shader => tr("mods_shader"),
+                        };
+                        buttons.push(button(
+                            [row[0] + row[2] - 176.0, row[1] + 6.0, 80.0, 26.0],
+                            toggle,
+                            item.kind != InstalledKind::Shader,
+                            150 + i as u8,
+                            false,
+                        ));
+                        buttons.push(button(
+                            [row[0] + row[2] - 90.0, row[1] + 6.0, 84.0, 26.0],
+                            tr("mods_remove"),
+                            true,
+                            200 + i as u8,
+                            false,
+                        ));
+                    }
+                    let count = self.installed.len().div_ceil(per).max(1);
+                    if count > 1 {
+                        buttons.push(button(
+                            [x, h - 34.0, 78.0, 24.0],
+                            tr("mods_prev"),
+                            self.page > 0,
+                            44,
+                            false,
+                        ));
+                        buttons.push(button(
+                            [x + 84.0, h - 34.0, 78.0, 24.0],
+                            tr("mods_next"),
+                            self.page + 1 < count,
+                            45,
+                            false,
+                        ));
+                    }
+                }
+            }
+            Tab::Account => {
+                let (x, cw) = content(w);
+                let right_x = x + 240.0;
+                let right_w = (x + cw - right_x).max(120.0);
+                match self.account.phase {
+                    Phase::SignedOut => {
+                        buttons.push(button(
+                            [right_x, 182.0, right_w, 30.0],
+                            tr("account_sign_in"),
+                            true,
+                            20,
+                            true,
+                        ));
+                        buttons.push(button(
+                            [right_x, 218.0, right_w, 26.0],
+                            tr("account_load"),
+                            true,
+                            21,
+                            false,
+                        ));
+                    }
+                    Phase::Starting | Phase::Waiting | Phase::Completing => {
+                        buttons.push(button(
+                            [right_x, 218.0, right_w, 28.0],
+                            tr("account_cancel"),
+                            true,
+                            23,
+                            false,
+                        ));
+                    }
+                    Phase::SignedIn => {
+                        buttons.push(button(
+                            [right_x, 218.0, right_w, 30.0],
+                            tr("account_sign_out"),
+                            true,
+                            22,
+                            false,
+                        ));
+                    }
+                    Phase::Failed | Phase::Cancelled => {
+                        let label = if self
+                            .account
+                            .error
+                            .as_deref()
+                            .is_some_and(|e| e.contains("expired"))
+                        {
+                            tr("account_new_code")
+                        } else {
+                            tr("account_retry")
+                        };
+                        buttons.push(button(
+                            [right_x, 182.0, right_w, 30.0],
+                            label,
+                            true,
+                            24,
+                            true,
+                        ));
+                        buttons.push(button(
+                            [right_x, 218.0, right_w, 26.0],
+                            tr("account_load"),
+                            true,
+                            21,
+                            false,
+                        ));
+                    }
+                }
+            }
+            Tab::Settings => {
+                let (x, cw) = content(w);
+                let language = self.language_label();
+                buttons.push(button(
+                    [x + cw - 124.0, 96.0, 124.0, 28.0],
+                    &language,
+                    true,
+                    30,
+                    false,
+                ));
+                let resolution = format!("{}%", self.settings.horizon.resolution_scale);
+                buttons.push(button(
+                    [x + cw - 124.0, 184.0, 124.0, 28.0],
+                    &resolution,
+                    true,
+                    31,
+                    false,
+                ));
+                let audio = if cfg!(feature = "audio") {
+                    format!("{:.0}%", self.settings.master_volume * 100.0)
+                } else {
+                    tr("settings_audio_off").to_owned()
+                };
+                buttons.push(button(
+                    [x + cw - 124.0, 228.0, 124.0, 28.0],
+                    &audio,
+                    cfg!(feature = "audio"),
+                    32,
+                    false,
+                ));
+                buttons.push(button(
+                    [x + cw - 84.0, 140.0, 84.0, 28.0],
+                    tr("settings_save"),
+                    true,
+                    33,
+                    false,
+                ));
+            }
+        }
+        buttons
+    }
+
+    fn filter_label(&self) -> &'static str {
+        match self.filter {
+            KindFilter::All => tr("filter_all"),
+            KindFilter::Mod => tr("filter_mod"),
+            KindFilter::ResourcePack => tr("filter_pack"),
+            KindFilter::Shader => tr("filter_shader"),
+        }
+    }
+
+    pub fn click(
+        &mut self,
+        hit: Option<u8>,
+        x: f32,
+        y: f32,
+        w: f32,
+        h: f32,
+        _started: Instant,
+    ) -> Action {
+        let Some(id) = hit else {
+            self.background_click(x, y, w, h);
+            return Action::None;
+        };
+        match id {
+            1..=4 => {
+                self.clear_focus();
+                self.tab = match id {
+                    1 => Tab::Home,
+                    2 => Tab::Mods,
+                    3 => Tab::Account,
+                    _ => Tab::Settings,
+                };
+                self.page = 0;
+                if self.tab == Tab::Mods {
+                    self.refresh_installed();
+                } else if self.tab == Tab::Account {
+                    self.account.open();
+                }
+                Action::None
+            }
+            5 => Action::Quit,
+            10 => Action::LauncherPlay,
+            20 | 24 => {
+                self.account.pin_focused = false;
+                self.account.start_sign_in();
+                Action::None
+            }
+            21 => {
+                self.account.pin_focused = false;
+                self.account.start_load_saved();
+                Action::None
+            }
+            22 => {
+                self.account.pin_focused = false;
+                if let Err(e) = self.account.sign_out() {
+                    self.account.error = Some(e);
+                    self.account.phase = Phase::Failed;
+                }
+                Action::None
+            }
+            23 => {
+                self.account.cancel();
+                Action::None
+            }
+            30 => self.cycle_language(),
+            31 => self.cycle_resolution(),
+            32 => self.cycle_volume(),
+            33 => {
+                self.save_name();
+                Action::None
+            }
+            40 => {
+                self.mods_tab = ModsTab::Browse;
+                self.page = 0;
+                self.clear_focus();
+                Action::None
+            }
+            41 => {
+                self.mods_tab = ModsTab::Installed;
+                self.page = 0;
+                self.refresh_installed();
+                self.clear_focus();
+                Action::None
+            }
+            42 => {
+                self.refresh_index();
+                Action::None
+            }
+            43 => {
+                self.filter = match self.filter {
+                    KindFilter::All => KindFilter::Mod,
+                    KindFilter::Mod => KindFilter::ResourcePack,
+                    KindFilter::ResourcePack => KindFilter::Shader,
+                    KindFilter::Shader => KindFilter::All,
+                };
+                self.page = 0;
+                Action::None
+            }
+            44 => {
+                self.page = self.page.saturating_sub(1);
+                Action::None
+            }
+            45 => {
+                self.page += 1;
+                Action::None
+            }
+            100..=149 => {
+                let i = (id - 100) as usize;
+                let projects = self.filtered_projects();
+                let project = projects
+                    .get(self.page * self.page_size(h) + i)
+                    .copied()
+                    .cloned();
+                project.map_or(Action::None, |p| self.install(&p))
+            }
+            150..=199 => {
+                let i = (id - 150) as usize + self.page * self.page_size(h);
+                self.toggle_installed(i)
+            }
+            200..=249 => {
+                let i = (id - 200) as usize + self.page * self.page_size(h);
+                self.remove_installed(i)
+            }
+            _ => Action::None,
+        }
+    }
+}

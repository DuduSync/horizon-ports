+    fn account_error_lines(&self, atlas: &HudAtlas, width: f32) -> Vec<String> {
+        let Some(error) = self.account.error.as_deref() else {
+            return if self.account.phase == Phase::Cancelled {
+                vec![tr("account_cancelled").to_owned()]
+            } else {
+                Vec::new()
+            };
+        };
+        let lines = if error == auth::NOT_CONFIGURED {
+            vec![
+                tr("account_not_configured").to_owned(),
+                tr("account_client_id_hint").to_owned(),
+            ]
+        } else if error == auth::SIGN_IN_AGAIN {
+            vec![tr("account_sign_in_again").to_owned()]
+        } else if error.contains("expired") {
+            vec![tr("account_expired").to_owned()]
+        } else if error.to_lowercase().contains("cancel") {
+            vec![tr("account_cancelled").to_owned()]
+        } else if error.contains("Could not unlock") {
+            vec![tr("account_wrong_pin").to_owned()]
+        } else if error.contains("worker stopped") {
+            vec![tr("account_worker_stopped").to_owned()]
+        } else {
+            vec![error.to_owned()]
+        };
+        lines
+            .iter()
+            .flat_map(|line| wrap(atlas, F_BODY, line, width))
+            .collect()
+    }
+
+    fn draw_button(
+        &self,
+        atlas: &HudAtlas,
+        batch: &mut HudBatch,
+        cursor: (f32, f32),
+        b: &LauncherButton,
+    ) {
+        crate::widgets::record(&b.label, [b.x, b.y, b.w, b.h], b.enabled);
+        crate::widgets::target([b.x, b.y, b.w, b.h]);
+        let hover = b.enabled && crate::ui::hovered(cursor, b.x, b.y, b.w, b.h);
+        crate::widgets::widget_cursor(hover, b.enabled);
+        let active = match b.id {
+            1 => self.tab == Tab::Home,
+            2 => self.tab == Tab::Mods,
+            3 => self.tab == Tab::Account,
+            4 => self.tab == Tab::Settings,
+            _ => false,
+        };
+        let fill = if !b.enabled {
+            SURFACE
+        } else if b.primary {
+            ACCENT
+        } else if active || hover {
+            SURFACE_2
+        } else {
+            SURFACE
+        };
+        batch.fill(atlas, b.x, b.y, b.w, b.h, fill);
+        border(
+            batch,
+            atlas,
+            [b.x, b.y, b.w, b.h],
+            if active {
+                ACCENT
+            } else if hover {
+                rgba(224, 164, 58, 160)
+            } else {
+                BORDER
+            },
+        );
+        let ink = if !b.enabled {
+            MUTED
+        } else if b.primary {
+            ACCENT_INK
+        } else if active {
+            ACCENT
+        } else {
+            TEXT
+        };
+        let font = if b.id == 10 {
+            F_BIG
+        } else if (20..30).contains(&b.id) || b.id >= 100 {
+            F_SMALL
+        } else {
+            F_LABEL
+        };
+        let tw = text_width(atlas, font, &b.label);
+        let label = if tw > b.w - 10.0 {
+            truncate(atlas, font, &b.label, b.w - 10.0)
+        } else {
+            b.label.clone()
+        };
+        let tw = text_width(atlas, font, &label);
+        let ty = if b.id == 10 {
+            b.y + b.h / 2.0 - 7.0
+        } else {
+            b.y + (b.h - 13.0) / 2.0
+        };
+        draw_text(
+            batch,
+            atlas,
+            font,
+            &label,
+            b.x + ((b.w - tw) / 2.0).floor(),
+            ty,
+            ink,
+        );
+    }
+}
+
+fn draw_qr(batch: &mut HudBatch, atlas: &HudAtlas, x: f32, y: f32, side: f32, qr: &Qr) {
+    let margin = 4usize;
+    let total = qr.size() + margin * 2;
+    let cell = (side / total as f32).ceil().max(1.0);
+    let actual = cell * total as f32;
+    batch.fill(atlas, x, y, actual, actual, u32::MAX);
+    border(
+        batch,
+        atlas,
+        [x - 1.0, y - 1.0, actual + 2.0, actual + 2.0],
+        BORDER,
+    );
+    for yy in 0..qr.size() {
+        for xx in 0..qr.size() {
+            if qr.dark(xx, yy) {
+                batch.fill(
+                    atlas,
+                    x + (xx + margin) as f32 * cell,
+                    y + (yy + margin) as f32 * cell,
+                    cell,
+                    cell,
+                    rgba(8, 10, 14, 255),
+                );
+            }
+        }
+    }
+}
+
+fn panel(batch: &mut HudBatch, atlas: &HudAtlas, r: [f32; 4], fill: u32, line: u32) {
+    batch.fill(atlas, r[0], r[1], r[2], r[3], fill);
+    border(batch, atlas, r, line);
+}
+fn border(batch: &mut HudBatch, atlas: &HudAtlas, r: [f32; 4], color: u32) {
+    batch.fill(atlas, r[0], r[1], r[2], 1.0, color);
+    batch.fill(atlas, r[0], r[1] + r[3] - 1.0, r[2], 1.0, color);
+    batch.fill(atlas, r[0], r[1], 1.0, r[3], color);
+    batch.fill(atlas, r[0] + r[2] - 1.0, r[1], 1.0, r[3], color);
+}
+fn draw_text(
+    batch: &mut HudBatch,
+    atlas: &HudAtlas,
+    font: &str,
+    text: &str,
+    x: f32,
+    y: f32,
+    color: u32,
+) {
+    if text.is_empty() {
+        return;
+    }
+    let text = Text::styled(
+        text,
+        Style {
+            font: Some(font.to_owned()),
+            ..Default::default()
+        },
+    );
+    batch.text_styled(atlas, &text, x, y, color, false);
+}
+fn text_width(atlas: &HudAtlas, font: &str, text: &str) -> f32 {
+    let text = Text::styled(
+        text,
+        Style {
+            font: Some(font.to_owned()),
+            ..Default::default()
+        },
+    );
+    atlas.font.width_text(&text)
+}
+fn wrap(atlas: &HudAtlas, font: &str, text: &str, width: f32) -> Vec<String> {
+    let text = Text::styled(
+        text,
+        Style {
+            font: Some(font.to_owned()),
+            ..Default::default()
+        },
+    );
+    atlas
+        .font
+        .split_lines(&text, width.max(40.0))
+        .iter()
+        .map(|(line, _)| line.plain())
+        .collect()
+}
+fn truncate(atlas: &HudAtlas, font: &str, text: &str, width: f32) -> String {
+    if text_width(atlas, font, text) <= width {
+        return text.to_owned();
+    }
+    let mut out = String::new();
+    for ch in text.chars() {
+        let mut candidate = out.clone();
+        candidate.push(ch);
+        candidate.push('…');
+        if text_width(atlas, font, &candidate) > width {
+            break;
+        }
+        out.push(ch);
+    }
+    out.push('…');
+    out
+}
+fn format_size(bytes: u64) -> String {
+    if bytes >= 1 << 20 {
+        format!("{:.1} MiB", bytes as f64 / (1 << 20) as f64)
+    } else if bytes >= 1 << 10 {
+        format!("{:.1} KiB", bytes as f64 / (1 << 10) as f64)
+    } else {
+        format!("{bytes} B")
+    }
+}
+fn pretty_code(code: &str) -> String {
+    let clean: String = code.chars().filter(|c| *c != '-').collect();
+    if clean.len() == 8 {
+        format!("{}-{}", &clean[..4], &clean[4..])
+    } else {
+        clean
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn device_codes_are_split_for_reading() {
+        assert_eq!(pretty_code("ABCD1234"), "ABCD-1234");
+        assert_eq!(pretty_code("ABCD-1234"), "ABCD-1234");
+        assert_eq!(pretty_code("AB12"), "AB12");
+    }
+
+    #[test]
+    fn both_languages_have_the_same_keys() {
+        for (key, _) in PT_BR {
+            assert!(
+                EN_US.iter().any(|(other, _)| other == key),
+                "missing en_us for {key}"
+            );
+        }
+        for (key, _) in EN_US {
+            assert!(
+                PT_BR.iter().any(|(other, _)| other == key),
+                "missing pt_br for {key}"
+            );
+        }
+    }
+}

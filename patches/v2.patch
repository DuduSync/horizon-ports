+    /// Add a TrueType font from memory under a new font id (the launcher's
+    /// Geist faces). It shares the reserved atlas region with the resource
+    /// fonts, so its glyphs upload through the same HudBatch patches.
+    pub fn add_ttf_font(&self, id: &str, data: &[u8], size: f32) {
+        if self.cache.borrow().sets.iter().any(|(known, _)| known == id) {
+            return;
+        }
+        let Ok(font) = ab_glyph::FontVec::try_from_vec(data.to_vec()) else {
+            log::warn!("Horizon: could not read the launcher font {id}");
+            return;
+        };
+        let ids = font
+            .codepoint_ids()
+            .filter(|(glyph, _)| glyph.0 != 0)
+            .map(|(glyph, ch)| (ch, glyph))
+            .collect();
+        let pixels_per_em = size.round().max(1.0);
+        let units = font.units_per_em().unwrap_or(1000.0);
+        let scale = ab_glyph::PxScale::from(pixels_per_em * font.height_unscaled() / units);
+        let set = FontSet {
+            providers: vec![Provider::TrueType(
+                Filter::default(),
+                Box::new(TrueType {
+                    font,
+                    ids,
+                    scale,
+                    oversample: 1.0,
+                    shift: (0.0, 0.0),
+                }),
+            )],
+            glyphs: Default::default(),
+            by_width: None,
+        };
+        self.cache.borrow_mut().sets.push((id.to_owned(), set));

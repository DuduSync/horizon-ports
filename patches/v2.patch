diff --git a/crates/horizon-client/src/launcher_v2.rs b/crates/horizon-client/src/launcher_v2.rs
new file mode 100644
index 0000000..932c422
--- /dev/null
+++ b/crates/horizon-client/src/launcher_v2.rs
@@ -0,0 +1,2477 @@
+//! The Switch launcher: a separate, dark screen shown before the Minecraft
+//! title. Pressing Play changes `Title::Mode::Launcher` to the original
+//! `Title::Mode::Main`; the game's own title is untouched.
+//!
+//! The launcher uses the existing HUD renderer with a Geist font set added to
+//! `HudAtlas::font` (`Font::add_ttf_font`). Its registry browser downloads the
+//! official index on a worker thread and verifies size and SHA-256 before it
+//! writes anything. No file explorer is needed: every action is a button.
+use crate::{
+    account_ui::{AccountUi, Phase},
+    auth,
+    font::Font,
+    hud::{HudAtlas, HudBatch, rgba},
+    mod_list::{DIR as MOD_DIR, ModList},
+    qr::Qr,
+    settings::Settings,
+    text::{Style, Text},
+    title::Action,
+};
+use horizon_mods::index::{self, Index, Kind, Project, Version};
+use std::{
+    io::Read,
+    path::{Path, PathBuf},
+    sync::mpsc::{self, Receiver, TryRecvError},
+    time::{Duration, Instant},
+};
+
+pub const INDEX_URL: &str = "https://ludovic111.github.io/horizon-mods/index.json";
+const INDEX_CACHE: &str = "launcher/mod-index.json";
+const MAX_INDEX: u64 = 8 << 20;
+
+// Geist faces; ids are namespaced so they cannot collide with resource fonts.
+const F_BODY: &str = "horizon:ui13";
+const F_SMALL: &str = "horizon:ui11";
+const F_LABEL: &str = "horizon:ui15";
+const F_TITLE: &str = "horizon:ui28";
+const F_BIG: &str = "horizon:ui40";
+const F_CODE: &str = "horizon:ui34";
+const F_MONO: &str = "horizon:ui_mono12";
+
+// The launcher's palette: cool dark neutrals, one sober amber accent.
+const BG: u32 = 0xff0a0d12;
+const SIDEBAR: u32 = 0xff0e1218;
+const SURFACE: u32 = 0xff151a22;
+const SURFACE_2: u32 = 0xff1b222c;
+const BORDER: u32 = 0xff2a323d;
+const TEXT: u32 = 0xffe8eaed;
+const MUTED: u32 = 0xff98a1ad;
+const ACCENT: u32 = 0xffe0a43a;
+const ACCENT_INK: u32 = 0xff16120a;
+const OK: u32 = 0xff7fd3a0;
+const BAD: u32 = 0xfff0a0a0;
+const WARN: u32 = 0xffe6c76a;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Tab {
+    Home,
+    Mods,
+    Account,
+    Settings,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ModsTab {
+    Browse,
+    Installed,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum KindFilter {
+    All,
+    Mod,
+    ResourcePack,
+    Shader,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum InstalledKind {
+    Mod,
+    ResourcePack,
+    Shader,
+}
+#[derive(Clone, Debug)]
+pub struct Installed {
+    pub path: PathBuf,
+    pub file: String,
+    pub id: String,
+    pub title: String,
+    pub version: String,
+    pub kind: InstalledKind,
+    pub enabled: bool,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Field {
+    Search,
+    Name,
+    Pin,
+}
+
+/// A button the launcher draws itself; `Title` only uses the rects for hit
+/// testing and focus registration.
+#[derive(Clone, Debug)]
+pub struct LauncherButton {
+    pub x: f32,
+    pub y: f32,
+    pub w: f32,
+    pub h: f32,
+    pub label: String,
+    pub enabled: bool,
+    pub id: u8,
+    /// Amber primary action; otherwise a dark surface button.
+    pub primary: bool,
+}
+
+enum IndexEvent {
+    Loaded(Index),
+    Error(String),
+}
+
+enum InstallEvent {
+    Progress { received: u64, total: u64 },
+    Done { kind: Kind, file: String },
+    Error(String),
+}
+
+pub struct Launcher {
+    pub tab: Tab,
+    pub mods_tab: ModsTab,
+    pub account: AccountUi,
+    home: PathBuf,
+    settings: Settings,
+    languages: Vec<crate::lang::LanguageInfo>,
+    pub language: String,
+    pub offline_name: String,
+    pub name_focused: bool,
+    pub search_focused: bool,
+    pub query: String,
+    pub filter: KindFilter,
+    pub page: usize,
+    pub installed: Vec<Installed>,
+    mod_list: ModList,
+    index: Option<Index>,
+    pub index_status: String,
+    index_busy: bool,
+    install_busy: bool,
+    install_progress: Option<(u64, u64)>,
+    install_status: Option<String>,
+    status: Option<(String, bool)>,
+    index_rx: Option<Receiver<IndexEvent>>,
+    install_rx: Option<Receiver<InstallEvent>>,
+    started: Instant,
+}
+
+impl Launcher {
+    pub fn new(saves: &Path, resources: &Path) -> Self {
+        let home = saves
+            .parent()
+            .filter(|p| !p.as_os_str().is_empty())
+            .unwrap_or_else(|| Path::new("."))
+            .to_path_buf();
+        let settings = Settings::load(&home.join("options.txt"));
+        let languages = crate::lang::available(&[&resources.to_path_buf()]);
+        let language = if settings.language.is_empty() {
+            crate::lang::code()
+        } else {
+            settings.language.clone()
+        };
+        let offline_name = crate::offline_name::load_or_create(&home);
+        let mod_list = ModList::load(&home);
+        let mut launcher = Self {
+            tab: Tab::Home,
+            mods_tab: ModsTab::Browse,
+            account: AccountUi::default(),
+            home,
+            settings,
+            languages,
+            language,
+            offline_name,
+            name_focused: false,
+            search_focused: false,
+            query: String::new(),
+            filter: KindFilter::All,
+            page: 0,
+            installed: Vec::new(),
+            mod_list,
+            index: None,
+            index_status: String::new(),
+            index_busy: false,
+            install_busy: false,
+            install_progress: None,
+            install_status: None,
+            status: None,
+            index_rx: None,
+            install_rx: None,
+            started: Instant::now(),
+        };
+        launcher.load_cached_index();
+        launcher.refresh_installed();
+        launcher
+    }
+
+    pub fn set_language(&mut self, code: &str) {
+        self.language = code.to_owned();
+    }
+    pub fn set_packs(&mut self, packs: Vec<String>) {
+        self.settings.resource_packs = packs;
+    }
+    pub fn set_resolution(&mut self, scale: u32) {
+        self.settings.horizon.resolution_scale = scale;
+    }
+    pub fn set_volume(&mut self, value: f32) {
+        self.settings.master_volume = value;
+    }
+
+    pub fn poll(&mut self) {
+        if let Some(rx) = self.index_rx.take() {
+            let mut loaded = None;
+            let mut error = None;
+            loop {
+                match rx.try_recv() {
+                    Ok(IndexEvent::Loaded(index)) => loaded = Some(index),
+                    Ok(IndexEvent::Error(e)) => error = Some(e),
+                    Err(TryRecvError::Empty) => break,
+                    Err(TryRecvError::Disconnected) => break,
+                }
+            }
+            if let Some(index) = loaded {
+                self.index = Some(index);
+                self.index_status = tr("mods_index_ok").to_owned();
+                self.page = 0;
+                self.index_busy = false;
+            } else if let Some(error) = error {
+                self.index_status = error;
+                self.index_busy = false;
+                self.index_rx = None;
+            } else if self.index_busy {
+                self.index_rx = Some(rx);
+            }
+        }
+        if let Some(rx) = self.install_rx.take() {
+            let mut done = None;
+            let mut error = None;
+            loop {
+                match rx.try_recv() {
+                    Ok(InstallEvent::Progress { received, total }) => {
+                        self.install_progress = Some((received, total));
+                    }
+                    Ok(InstallEvent::Done { kind, file }) => done = Some((kind, file)),
+                    Ok(InstallEvent::Error(e)) => error = Some(e),
+                    Err(TryRecvError::Empty) => break,
+                    Err(TryRecvError::Disconnected) => break,
+                }
+            }
+            if let Some((kind, file)) = done {
+                self.install_busy = false;
+                self.install_progress = None;
+                self.install_status = Some(format!("{} {file}", tr("mods_installed_ok")));
+                let _ = kind;
+                self.refresh_installed();
+            } else if let Some(error) = error {
+                self.install_busy = false;
+                self.install_progress = None;
+                self.install_status = Some(error);
+                self.install_rx = None;
+            } else if self.install_busy {
+                self.install_rx = Some(rx);
+            }
+        }
+        self.account.poll();
+    }
+
+    fn load_cached_index(&mut self) {
+        let path = self.home.join(INDEX_CACHE);
+        match std::fs::read_to_string(&path) {
+            Ok(text) => match Index::parse(&text) {
+                Ok(index) => {
+                    self.index = Some(index);
+                    self.index_status = tr("mods_index_cache").to_owned();
+                }
+                Err(e) => self.index_status = format!("{}: {e}", tr("mods_index_bad")),
+            },
+            Err(_) => self.index_status = tr("mods_index_none").to_owned(),
+        }
+    }
+
+    pub fn refresh_index(&mut self) {
+        if self.index_busy {
+            return;
+        }
+        let (tx, rx) = mpsc::channel();
+        let path = self.home.join(INDEX_CACHE);
+        self.index_busy = true;
+        self.index_status = tr("mods_index_loading").to_owned();
+        self.index_rx = Some(rx);
+        std::thread::Builder::new()
+            .name("Horizon mod index".into())
+            .spawn(move || fetch_index(tx, path))
+            .ok();
+    }
+
+    pub fn refresh_installed(&mut self) {
+        self.mod_list = ModList::load(&self.home);
+        let mut installed = Vec::new();
+        for path in horizon_mods::find(&self.home.join(MOD_DIR)) {
+            let package = horizon_mods::Package::read(&path).ok();
+            let file = path.file_name().map_or_else(
+                || path.display().to_string(),
+                |n| n.to_string_lossy().into_owned(),
+            );
+            let (id, title, version) = package.map_or_else(
+                || (file.clone(), file.clone(), String::new()),
+                |p| {
+                    (
+                        p.manifest.id.clone(),
+                        p.manifest.name.clone(),
+                        p.manifest.version.clone(),
+                    )
+                },
+            );
+            let enabled = self.mod_list.enabled.contains(&id);
+            installed.push(Installed {
+                path,
+                file,
+                id,
+                title,
+                version,
+                kind: InstalledKind::Mod,
+                enabled,
+            });
+        }
+        for path in scan_dir(&self.home.join("resourcepacks"), "zip") {
+            let file = path.file_name().map_or_else(
+                || path.display().to_string(),
+                |n| n.to_string_lossy().into_owned(),
+            );
+            let enabled = self
+                .settings
+                .resource_packs
+                .iter()
+                .any(|p| p == &file || p == &format!("file/{file}"));
+            installed.push(Installed {
+                path,
+                id: file.clone(),
+                title: file.clone(),
+                file,
+                version: String::new(),
+                kind: InstalledKind::ResourcePack,
+                enabled,
+            });
+        }
+        if let Ok(entries) = std::fs::read_dir(self.home.join("resourcepacks")) {
+            for path in entries.flatten().map(|e| e.path()) {
+                if !path.is_dir() || !path.join("pack.mcmeta").is_file() {
+                    continue;
+                }
+                let file = path.file_name().map_or_else(
+                    || path.display().to_string(),
+                    |n| n.to_string_lossy().into_owned(),
+                );
+                let enabled = self
+                    .settings
+                    .resource_packs
+                    .iter()
+                    .any(|p| p == &file || p == &format!("file/{file}"));
+                installed.push(Installed {
+                    path,
+                    id: file.clone(),
+                    title: file.clone(),
+                    file,
+                    version: String::new(),
+                    kind: InstalledKind::ResourcePack,
+                    enabled,
+                });
+            }
+        }
+        for path in scan_dir(&self.home.join("shaders"), "hshader") {
+            let file = path.file_name().map_or_else(
+                || path.display().to_string(),
+                |n| n.to_string_lossy().into_owned(),
+            );
+            installed.push(Installed {
+                path,
+                id: file.clone(),
+                title: file.clone(),
+                file,
+                version: String::new(),
+                kind: InstalledKind::Shader,
+                enabled: false,
+            });
+        }
+        installed.sort_by(|a, b| a.title.to_lowercase().cmp(&b.title.to_lowercase()));
+        self.installed = installed;
+    }
+
+    fn cycle_language(&mut self) -> Action {
+        if self.languages.is_empty() {
+            return Action::None;
+        }
+        let current = self
+            .languages
+            .iter()
+            .position(|l| l.code == self.language)
+            .unwrap_or(0);
+        let next = &self.languages[(current + 1) % self.languages.len()];
+        self.language.clone_from(&next.code);
+        Action::SetLanguage {
+            code: next.code.clone(),
+        }
+    }
+    fn cycle_resolution(&mut self) -> Action {
+        const STEPS: [u32; 6] = [50, 75, 100, 125, 150, 200];
+        let current = self.settings.horizon.resolution_scale;
+        let next = *STEPS.iter().find(|&&s| s > current).unwrap_or(&STEPS[0]);
+        self.settings.horizon.resolution_scale = next;
+        Action::SetResolution { scale: next }
+    }
+    fn cycle_volume(&mut self) -> Action {
+        let next = if self.settings.master_volume >= 0.99 {
+            0.0
+        } else if self.settings.master_volume >= 0.49 {
+            1.0
+        } else {
+            0.5
+        };
+        self.settings.master_volume = next;
+        Action::SetVolume { value: next }
+    }
+    fn save_name(&mut self) {
+        let name = self.offline_name.trim().to_owned();
+        self.offline_name = name.clone();
+        let path = self.home.join(crate::offline_name::FILE);
+        if !crate::offline_name::is_valid(&name) {
+            self.status = Some((tr("name_invalid").to_owned(), true));
+            return;
+        }
+        match std::fs::write(&path, format!("name:{name}\n")) {
+            Ok(()) => self.status = Some((tr("name_saved").to_owned(), false)),
+            Err(e) => self.status = Some((format!("{e}"), true)),
+        }
+    }
+
+    fn toggle_installed(&mut self, index: usize) -> Action {
+        let Some(item) = self.installed.get(index).cloned() else {
+            return Action::None;
+        };
+        match item.kind {
+            InstalledKind::Mod => {
+                if !self.mod_list.enabled.remove(&item.id) {
+                    self.mod_list.enabled.insert(item.id.clone());
+                }
+                self.mod_list.save(&self.home);
+                if let Some(row) = self.installed.get_mut(index) {
+                    row.enabled = !row.enabled;
+                }
+                if cfg!(feature = "mods") {
+                    Action::ReloadMods
+                } else {
+                    self.status = Some((tr("mods_no_runtime").to_owned(), false));
+                    Action::None
+                }
+            }
+            InstalledKind::ResourcePack => {
+                let enabled = !item.enabled;
+                if enabled {
+                    self.settings
+                        .resource_packs
+                        .push(format!("file/{}", item.file));
+                } else {
+                    let want = format!("file/{}", item.file);
+                    self.settings
+                        .resource_packs
+                        .retain(|p| p != &want && p != &item.file);
+                }
+                if let Some(row) = self.installed.get_mut(index) {
+                    row.enabled = enabled;
+                }
+                Action::SetPacks {
+                    packs: self.settings.resource_packs.clone(),
+                }
+            }
+            InstalledKind::Shader => Action::None,
+        }
+    }
+
+    fn remove_installed(&mut self, index: usize) -> Action {
+        let Some(item) = self.installed.get(index).cloned() else {
+            return Action::None;
+        };
+        let result = if item.path.is_dir() {
+            std::fs::remove_dir_all(&item.path)
+        } else {
+            std::fs::remove_file(&item.path)
+        };
+        if let Err(e) = result {
+            self.status = Some((format!("{e}"), true));
+            return Action::None;
+        }
+        if item.kind == InstalledKind::Mod {
+            self.mod_list.enabled.remove(&item.id);
+            self.mod_list.save(&self.home);
+        }
+        let mut action = Action::None;
+        if item.kind == InstalledKind::ResourcePack {
+            self.settings
+                .resource_packs
+                .retain(|p| p != &item.file && p != &format!("file/{}", item.file));
+            action = Action::SetPacks {
+                packs: self.settings.resource_packs.clone(),
+            };
+        }
+        self.refresh_installed();
+        self.status = Some((tr("mods_removed").to_owned(), false));
+        action
+    }
+
+    fn install(&mut self, project: &Project) -> Action {
+        if self.install_busy {
+            return Action::None;
+        }
+        let Some(index) = &self.index else {
+            self.install_status = Some(tr("mods_index_none").to_owned());
+            return Action::None;
+        };
+        let Some(version) = index.installable(project, "26.3", 2) else {
+            self.install_status = Some(tr("mods_not_installable").to_owned());
+            return Action::None;
+        };
+        let Some(dir) = self.destination(&project.kind) else {
+            self.install_status = Some(format!(
+                "{} {}",
+                tr("mods_unsupported"),
+                project.kind.name()
+            ));
+            return Action::None;
+        };
+        let (tx, rx) = mpsc::channel();
+        let index = index.clone();
+        let project = project.clone();
+        let version = version.clone();
+        let home = self.home.clone();
+        let dir = dir.clone();
+        self.install_busy = true;
+        self.install_progress = Some((0, version.file.size));
+        self.install_status = Some(format!("{} {}", tr("mods_installing"), project.name));
+        self.install_rx = Some(rx);
+        std::thread::Builder::new()
+            .name("Horizon mod install".into())
+            .spawn(move || install_worker(tx, index, project, version, home, dir))
+            .ok();
+        Action::None
+    }
+
+    fn destination(&self, kind: &Kind) -> Option<PathBuf> {
+        match kind {
+            Kind::Mod => Some(self.home.join(MOD_DIR)),
+            Kind::ResourcePack => Some(self.home.join("resourcepacks")),
+            Kind::Shader => Some(self.home.join("shaders")),
+            _ => None,
+        }
+    }
+
+    fn filtered_projects(&self) -> Vec<&Project> {
+        let query = self.query.to_lowercase();
+        self.index
+            .as_ref()
+            .map(|index| {
+                index
+                    .projects
+                    .iter()
+                    .filter(|p| match self.filter {
+                        KindFilter::All => true,
+                        KindFilter::Mod => p.kind == Kind::Mod,
+                        KindFilter::ResourcePack => p.kind == Kind::ResourcePack,
+                        KindFilter::Shader => p.kind == Kind::Shader,
+                    })
+                    .filter(|p| {
+                        query.is_empty()
+                            || p.name.to_lowercase().contains(&query)
+                            || p.id.to_lowercase().contains(&query)
+                            || p.summary.to_lowercase().contains(&query)
+                    })
+                    .collect()
+            })
+            .unwrap_or_default()
+    }
+
+    fn kind_label(kind: &Kind) -> &'static str {
+        match kind {
+            Kind::Mod => "mod",
+            Kind::ResourcePack => "resource pack",
+            Kind::Shader => "shader",
+            Kind::Modpack => "modpack",
+            Kind::Other(name) if name == "native-mod" => "native-mod",
+            Kind::Other(_) => "outro",
+        }
+    }
+}
+
+fn scan_dir(dir: &Path, extension: &str) -> Vec<PathBuf> {
+    let Ok(entries) = std::fs::read_dir(dir) else {
+        return Vec::new();
+    };
+    let mut out: Vec<PathBuf> = entries
+        .flatten()
+        .map(|e| e.path())
+        .filter(|p| {
+            p.extension()
+                .is_some_and(|e| e.eq_ignore_ascii_case(extension))
+        })
+        .collect();
+    out.sort();
+    out
+}
+
+fn fetch_index(tx: mpsc::Sender<IndexEvent>, cache: PathBuf) {
+    let response = match ureq::get(INDEX_URL).timeout(Duration::from_secs(20)).call() {
+        Ok(response) => response,
+        Err(e) => {
+            let _ = tx.send(IndexEvent::Error(format!("{}: {e}", tr("mods_no_net"))));
+            return;
+        }
+    };
+    let mut text = String::new();
+    if let Err(e) = response
+        .into_reader()
+        .take(MAX_INDEX + 1)
+        .read_to_string(&mut text)
+    {
+        let _ = tx.send(IndexEvent::Error(format!("{}: {e}", tr("mods_no_net"))));
+        return;
+    }
+    if text.len() as u64 > MAX_INDEX {
+        let _ = tx.send(IndexEvent::Error(tr("mods_index_big").to_owned()));
+        return;
+    }
+    let index = match Index::parse(&text) {
+        Ok(index) => index,
+        Err(e) => {
+            let _ = tx.send(IndexEvent::Error(e));
+            return;
+        }
+    };
+    if let Some(dir) = cache.parent() {
+        let _ = std::fs::create_dir_all(dir);
+    }
+    let tmp = cache.with_extension("json.part");
+    if std::fs::write(&tmp, &text).is_ok() {
+        let _ = std::fs::rename(&tmp, &cache);
+    }
+    let _ = tx.send(IndexEvent::Loaded(index));
+}
+
+fn install_worker(
+    tx: mpsc::Sender<InstallEvent>,
+    index: Index,
+    project: Project,
+    version: Version,
+    home: PathBuf,
+    dir: PathBuf,
+) {
+    let send = |event| {
+        let _ = tx.send(event);
+    };
+    if let Err(e) = std::fs::create_dir_all(&dir) {
+        send(InstallEvent::Error(format!("{}: {e}", tr("mods_no_space"))));
+        return;
+    }
+    let temp = dir.join(format!(".{}.part", version.file.name));
+    let result = download(&tx, &version, &temp)
+        .and_then(|()| index::check_file(&index, &project, &version, &temp).map(|_| ()));
+    if let Err(e) = result {
+        let _ = std::fs::remove_file(&temp);
+        send(InstallEvent::Error(e));
+        return;
+    }
+    let dest = dir.join(&version.file.name);
+    if std::fs::rename(&temp, &dest).is_err() {
+        let _ = std::fs::remove_file(&dest);
+        if let Err(e) = std::fs::rename(&temp, &dest) {
+            let _ = std::fs::remove_file(&temp);
+            send(InstallEvent::Error(format!("{}: {e}", tr("mods_no_space"))));
+            return;
+        }
+    }
+    if project.kind == Kind::Mod {
+        let mut list = ModList::load(&home);
+        list.enabled.insert(project.id.clone());
+        list.save(&home);
+    }
+    send(InstallEvent::Done {
+        kind: project.kind,
+        file: version.file.name,
+    });
+}
+
+fn download(tx: &mpsc::Sender<InstallEvent>, version: &Version, temp: &Path) -> Result<(), String> {
+    use sha2::{Digest, Sha256};
+    let response = ureq::get(&version.file.url)
+        .timeout(Duration::from_secs(60))
+        .call()
+        .map_err(|e| format!("{}: {e}", tr("mods_no_net")))?;
+    let mut reader = response.into_reader();
+    let mut file =
+        std::fs::File::create(temp).map_err(|e| format!("{}: {e}", tr("mods_no_space")))?;
+    let mut hasher = Sha256::new();
+    let mut received = 0u64;
+    let mut buf = [0u8; 64 * 1024];
+    loop {
+        let n = reader
+            .read(&mut buf)
+            .map_err(|e| format!("{}: {e}", tr("mods_no_net")))?;
+        if n == 0 {
+            break;
+        }
+        received += n as u64;
+        if received > index::MAX_FILE {
+            return Err(tr("mods_too_big").to_owned());
+        }
+        use std::io::Write as _;
+        file.write_all(&buf[..n])
+            .map_err(|e| format!("{}: {e}", tr("mods_no_space")))?;
+        hasher.update(&buf[..n]);
+        let _ = tx.send(InstallEvent::Progress {
+            received,
+            total: version.file.size,
+        });
+    }
+    if received != version.file.size {
+        return Err(format!(
+            "{}: {} != {}",
+            tr("mods_bad_size"),
+            received,
+            version.file.size
+        ));
+    }
+    let hash = format!("{:x}", hasher.finalize());
+    if hash != version.file.sha256.to_lowercase() {
+        return Err(tr("mods_bad_hash").to_owned());
+    }
+    Ok(())
+}

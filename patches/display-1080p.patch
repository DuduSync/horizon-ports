+/// The console screen's size in handheld mode.
+pub(crate) const HANDHELD_SIZE: PhysicalSize<u32> = PhysicalSize::new(1280, 720);
+/// The TV's size in docked mode: rendering at 1080p lets the system present the frame unscaled,
+/// where a 720p frame is stretched by the TV.
+pub(crate) const DOCKED_SIZE: PhysicalSize<u32> = PhysicalSize::new(1920, 1080);
+
+/// `appletGetOperationMode` (`HANDHELD` or `CONSOLE`); libnx refreshes it from the system's
+/// messages in `appletMainLoop`.
+pub(crate) fn operation_mode() -> u32 {
+    // SAFETY: a plain applet query, valid once libnx has initialized the applet (before `main`).
+    unsafe { ffi::appletGetOperationMode() }
+}
+
+/// The size the game draws at: the TV's 1080p when docked, the console screen's 720p otherwise.
+pub(crate) fn current_size() -> PhysicalSize<u32> {
+    if operation_mode() == ffi::OPERATION_MODE_CONSOLE {
+        DOCKED_SIZE
+    } else {
+        HANDHELD_SIZE
+    }
+}
 

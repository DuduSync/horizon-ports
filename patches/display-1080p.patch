+/// Applies `size` to the console's default `NWindow`, the surface the system presents.
+///
+/// libnx refuses new dimensions while buffer slots are registered, which is the case while a
+/// swapchain is live. That is expected on a hot dock or undock: the `Resized` emitted next makes
+/// the renderer reconfigure the surface, and NVK's swapchain recreate releases the old slots and
+/// sizes the new images from their extent (`wsi_switch_surface_create_swapchain` in mesa-switch).
+fn apply_window_size(size: PhysicalSize<u32>) {
+    // SAFETY: libnx keeps the default window for the whole process.
+    let nw = unsafe { ffi::nwindowGetDefault() };
+    if nw.is_null() {
+        return;
+    }
+    // SAFETY: a valid NWindow; an error just means a swapchain still owns the slots.
+    let _ = unsafe { ffi::nwindowSetDimensions(nw, size.width, size.height) };
+}

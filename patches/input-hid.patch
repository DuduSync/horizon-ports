+fn named(usage: u8) -> Option<N> {
+    const FUNCTIONS: [N; 24] = [
+        N::F1,
+        N::F2,
+        N::F3,
+        N::F4,
+        N::F5,
+        N::F6,
+        N::F7,
+        N::F8,
+        N::F9,
+        N::F10,
+        N::F11,
+        N::F12,
+        N::F13,
+        N::F14,
+        N::F15,
+        N::F16,
+        N::F17,
+        N::F18,
+        N::F19,
+        N::F20,
+        N::F21,
+        N::F22,
+        N::F23,
+        N::F24,
+    ];
+    Some(match usage {
+        40 | 88 => N::Enter,
+        41 => N::Escape,
+        42 => N::Backspace,
+        43 => N::Tab,
+        57 => N::CapsLock,
+        58..=69 => FUNCTIONS[usize::from(usage - 58)],
+        70 => N::PrintScreen,
+        71 => N::ScrollLock,
+        72 => N::Pause,
+        73 => N::Insert,
+        74 => N::Home,
+        75 => N::PageUp,
+        76 => N::Delete,
+        77 => N::End,
+        78 => N::PageDown,
+        79 => N::ArrowRight,
+        80 => N::ArrowLeft,
+        81 => N::ArrowDown,
+        82 => N::ArrowUp,
+        83 => N::NumLock,
+        // With Num Lock off, these numpad keys are navigation instead of characters.
+        89 => N::End,
+        90 => N::ArrowDown,
+        91 => N::PageDown,
+        92 => N::ArrowLeft,
+        93 => N::Clear,
+        94 => N::ArrowRight,
+        95 => N::Home,
+        96 => N::ArrowUp,
+        97 => N::PageUp,
+        98 => N::Insert,
+        99 => N::Delete,
+        101 => N::ContextMenu,
+        102 => N::Power,
+        104..=115 => FUNCTIONS[usize::from(usage - 104 + 12)],
+        224 | 228 => N::Control,
+        225 | 229 => N::Shift,
+        226 => N::Alt,
+        230 => N::AltGraph,
+        227 | 231 => N::Super,
+        _ => return None,
+    })
+}

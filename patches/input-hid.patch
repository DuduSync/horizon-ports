--- /dev/null
+++ b/switch/patches/winit-0.30.13/src/platform_impl/nx/native_inputs.rs
@@ -0,0 +1,840 @@
+//! USB and Bluetooth keyboards and mice as winit events.
+//!
+//! libnx's HID service keeps a 17-report LIFO per device with the newest report first. Each
+//! keyboard report is the full state of every held key at one sampling instant, so this module
+//! diffs consecutive reports; each mouse report carries raw motion, the pointer position and the
+//! button bits. Text is US HID/ASCII: physical `KeyCode`s are layout-independent, characters
+//! are not.
+
+use std::time::{Duration, Instant};
+
+use crate::event::{
+    DeviceEvent, ElementState, KeyEvent, Modifiers, MouseButton, MouseScrollDelta, TouchPhase,
+    WindowEvent,
+};
+use crate::keyboard::{
+    Key, KeyCode as K, KeyLocation, ModifiersState, NamedKey as N, NativeKey, PhysicalKey, SmolStr,
+};
+
+use super::{ffi, KeyEventExtra, Pending, PendingEvents, HEIGHT, WIDTH};
+
+/// The LIFO depth libnx reports (hid.h) and the most history a single frame can drain.
+const REPORTS: usize = 17;
+const REPEAT_DELAY: Duration = Duration::from_millis(400);
+const REPEAT_INTERVAL: Duration = Duration::from_millis(33);
+
+pub(crate) struct NativeInputs {
+    keyboard: ffi::HidKeyboardState,
+    mouse: ffi::HidMouseState,
+    /// Last effective button bits (zero while no mouse is connected).
+    buttons: u32,
+    connected: bool,
+    modifiers: ModifiersState,
+    /// The key whose auto-repeat is running and when its next event is due.
+    repeat: Option<(u8, Instant)>,
+    /// Skip the backlog and the first raw motion after gaining focus: a stale report would
+    /// otherwise move the camera by however long the console was away.
+    resync: bool,
+}
+
+impl NativeInputs {
+    pub(crate) fn new() -> Self {
+        Self {
+            keyboard: ffi::HidKeyboardState::default(),
+            mouse: ffi::HidMouseState::default(),
+            buttons: 0,
+            connected: false,
+            modifiers: ModifiersState::empty(),
+            repeat: None,
+            resync: true,
+        }
+    }
+
+    /// Drops every held key and button without emitting releases. The application clears its own
+    /// state from `WindowEvent::Focused(false)`; the next poll starts from the newest report only.
+    pub(crate) fn reset_focus(&mut self) {
+        self.keyboard = ffi::HidKeyboardState::default();
+        self.mouse = ffi::HidMouseState::default();
+        self.buttons = 0;
+        self.connected = false;
+        self.modifiers = ModifiersState::empty();
+        self.repeat = None;
+        self.resync = true;
+    }
+
+    /// Turns the reports sampled since the last call into winit events, and fires a due key
+    /// repeat. Called once per frame while the window has focus.
+    pub(crate) fn poll(
+        &mut self,
+        keyboard_id: crate::event::DeviceId,
+        mouse_id: crate::event::DeviceId,
+        grabbed: bool,
+        out: &mut PendingEvents,
+    ) {
+        let mut keys = [ffi::HidKeyboardState::default(); REPORTS];
+        let mut mice = [ffi::HidMouseState::default(); REPORTS];
+        // SAFETY: both arrays have `REPORTS` entries and libnx writes at most `count`.
+        let key_count =
+            unsafe { ffi::hidGetKeyboardStates(keys.as_mut_ptr(), REPORTS) }.min(REPORTS);
+        let mouse_count =
+            unsafe { ffi::hidGetMouseStates(mice.as_mut_ptr(), REPORTS) }.min(REPORTS);
+        // After a focus switch only the newest report describes the keys held now; replaying the
+        // backlog would report presses that already ended while the console was away.
+        let key_count = if self.resync {
+            key_count.min(1)
+        } else {
+            key_count
+        };
+        let mouse_count = if self.resync {
+            mouse_count.min(1)
+        } else {
+            mouse_count
+        };
+
+        // libnx fills the array newest first; older reports come first for the state diff.
+        for report in keys[..key_count].iter().rev() {
+            if report.sampling_number > self.keyboard.sampling_number {
+                self.keyboard_report(keyboard_id, out, *report);
+            }
+        }
+        for report in mice[..mouse_count].iter().rev() {
+            if report.sampling_number > self.mouse.sampling_number {
+                self.mouse_report(mouse_id, grabbed, out, *report);
+            }
+        }
+        self.resync = false;
+
+        if let Some((usage, next)) = self.repeat {
+            if Instant::now() >= next {
+                if held(&self.keyboard, usage) {
+                    if let Some(code) = key_code(usage) {
+                        self.key_event(keyboard_id, out, usage, true, true, code);
+                    }
+                    self.repeat = Some((usage, Instant::now() + REPEAT_INTERVAL));
+                } else {
+                    self.repeat = None;
+                }
+            }
+        }
+    }
+
+    fn keyboard_report(
+        &mut self,
+        keyboard_id: crate::event::DeviceId,
+        out: &mut PendingEvents,
+        report: ffi::HidKeyboardState,
+    ) {
+        let modifiers = modifiers(report.modifiers);
+        if self.modifiers != modifiers {
+            self.modifiers = modifiers;
+            out.push_back(Pending::Window(WindowEvent::ModifiersChanged(
+                Modifiers::from(modifiers),
+            )));
+        }
+        let previous = self.keyboard;
+        self.keyboard = report;
+        for usage in 4u8..=231 {
+            let was = held(&previous, usage);
+            let now = held(&report, usage);
+            if was == now {
+                continue;
+            }
+            let Some(code) = key_code(usage) else {
+                continue;
+            };
+            self.key_event(keyboard_id, out, usage, now, false, code);
+            if now && usage < 224 && !matches!(usage, 57 | 71 | 83) {
+                // Caps Lock, Scroll Lock and Num Lock latch instead of repeating.
+                self.repeat = Some((usage, Instant::now() + REPEAT_DELAY));
+            } else if !now && self.repeat.is_some_and(|(key, _)| key == usage) {
+                self.repeat = None;
+            }
+        }
+    }
+
+    fn key_event(
+        &self,
+        keyboard_id: crate::event::DeviceId,
+        out: &mut PendingEvents,
+        usage: u8,
+        down: bool,
+        repeat: bool,
+        code: K,
+    ) {
+        let character = printable(usage, self.keyboard.modifiers);
+        let logical_key = logical(usage, character.as_deref());
+        let text = if down
+            && !self.modifiers.control_key()
+            && !self.modifiers.super_key()
+            && !self.modifiers.alt_key()
+        {
+            character.clone().map(SmolStr::from)
+        } else {
+            None
+        };
+        let location = match usage {
+            224..=227 => KeyLocation::Left,
+            228..=231 => KeyLocation::Right,
+            83..=99 | 103 | 133 => KeyLocation::Numpad,
+            _ => KeyLocation::Standard,
+        };
+        // "Without modifiers" means Shift and Caps Lock released, as on the desktop backends.
+        let unshifted = printable(usage, self.keyboard.modifiers & !(2 | (1 << 8)));
+        let key_without_modifiers = logical(usage, unshifted.as_deref());
+        out.push_back(Pending::Window(WindowEvent::KeyboardInput {
+            device_id: keyboard_id,
+            event: KeyEvent {
+                physical_key: PhysicalKey::Code(code),
+                logical_key,
+                text,
+                location,
+                state: if down {
+                    ElementState::Pressed
+                } else {
+                    ElementState::Released
+                },
+                repeat,
+                platform_specific: KeyEventExtra {
+                    key_without_modifiers,
+                    text_with_all_modifiers: character.map(SmolStr::from),
+                },
+            },
+            is_synthetic: false,
+        }));
+    }
+
+    fn mouse_report(
+        &mut self,
+        mouse_id: crate::event::DeviceId,
+        grabbed: bool,
+        out: &mut PendingEvents,
+        report: ffi::HidMouseState,
+    ) {
+        let connected = report.attributes & ffi::HID_MOUSE_ATTRIBUTE_CONNECTED != 0;
+        if connected && !self.connected {
+            // A newly connected mouse may have accumulated motion before its first report.
+            self.resync = true;
+        }
+        let previous_buttons = self.buttons;
+        self.mouse = report;
+        self.connected = connected;
+        let buttons = if connected { report.buttons } else { 0 };
+        self.buttons = buttons;
+        let mut cursor_sent = false;
+
+        if connected && !self.resync {
+            let dx = f64::from(report.delta_x);
+            let dy = f64::from(report.delta_y);
+            if dx != 0.0 || dy != 0.0 {
+                // Raw motion keeps the game's existing sensitivity and camera code in control.
+                out.push_back(Pending::Device(
+                    mouse_id,
+                    DeviceEvent::MouseMotion { delta: (dx, dy) },
+                ));
+                if !grabbed {
+                    out.push_back(Pending::Window(WindowEvent::CursorMoved {
+                        device_id: mouse_id,
+                        position: cursor(&report),
+                    }));
+                    cursor_sent = true;
+                }
+            }
+            if report.wheel_delta_x != 0 || report.wheel_delta_y != 0 {
+                out.push_back(Pending::Window(WindowEvent::MouseWheel {
+                    device_id: mouse_id,
+                    delta: MouseScrollDelta::LineDelta(
+                        report.wheel_delta_x as f32,
+                        report.wheel_delta_y as f32,
+                    ),
+                    phase: TouchPhase::Moved,
+                }));
+            }
+        }
+        if connected && !grabbed && !cursor_sent && (self.resync || buttons != previous_buttons) {
+            out.push_back(Pending::Window(WindowEvent::CursorMoved {
+                device_id: mouse_id,
+                position: cursor(&report),
+            }));
+        }
+        for (bit, button) in [
+            (0, MouseButton::Left),
+            (1, MouseButton::Right),
+            (2, MouseButton::Middle),
+            (3, MouseButton::Forward),
+            (4, MouseButton::Back),
+        ] {
+            if (buttons ^ previous_buttons) & (1 << bit) == 0 {
+                continue;
+            }
+            out.push_back(Pending::Window(WindowEvent::MouseInput {
+                device_id: mouse_id,
+                state: if buttons & (1 << bit) != 0 {
+                    ElementState::Pressed
+                } else {
+                    ElementState::Released
+                },
+                button,
+            }));
+        }
+    }
+}
+
+/// The pointer position clamped to the window; libnx's virtual screen is the same 1280x720.
+fn cursor(report: &ffi::HidMouseState) -> crate::dpi::PhysicalPosition<f64> {
+    let x = report.x.clamp(0, WIDTH as i32 - 1);
+    let y = report.y.clamp(0, HEIGHT as i32 - 1);
+    crate::dpi::PhysicalPosition::new(f64::from(x), f64::from(y))
+}
+
+fn logical(usage: u8, character: Option<&str>) -> Key {
+    if matches!(usage, 40 | 43 | 88) {
+        Key::Named(named(usage).expect("Enter and Tab are named keys"))
+    } else {
+        character.map_or_else(
+            || named(usage).map_or(Key::Unidentified(NativeKey::Unidentified), Key::Named),
+            |text| Key::Character(SmolStr::new(text)),
+        )
+    }
+}
+
+fn held(state: &ffi::HidKeyboardState, usage: u8) -> bool {
+    state.keys[usize::from(usage) / 64] & (1u64 << (usage & 63)) != 0
+}
+
+/// `HidKeyboardModifier` bits: Control, Shift, left/right Alt, GUI, Caps Lock (bit 8).
+fn modifiers(raw: u64) -> ModifiersState {
+    let mut result = ModifiersState::empty();
+    result.set(ModifiersState::CONTROL, raw & 1 != 0);
+    result.set(ModifiersState::SHIFT, raw & 2 != 0);
+    result.set(ModifiersState::ALT, raw & 12 != 0);
+    result.set(ModifiersState::SUPER, raw & 16 != 0);
+    result
+}
+
+fn key_code(usage: u8) -> Option<K> {
+    const LETTERS: [K; 26] = [
+        K::KeyA,
+        K::KeyB,
+        K::KeyC,
+        K::KeyD,
+        K::KeyE,
+        K::KeyF,
+        K::KeyG,
+        K::KeyH,
+        K::KeyI,
+        K::KeyJ,
+        K::KeyK,
+        K::KeyL,
+        K::KeyM,
+        K::KeyN,
+        K::KeyO,
+        K::KeyP,
+        K::KeyQ,
+        K::KeyR,
+        K::KeyS,
+        K::KeyT,
+        K::KeyU,
+        K::KeyV,
+        K::KeyW,
+        K::KeyX,
+        K::KeyY,
+        K::KeyZ,
+    ];
+    const DIGITS: [K; 10] = [
+        K::Digit1,
+        K::Digit2,
+        K::Digit3,
+        K::Digit4,
+        K::Digit5,
+        K::Digit6,
+        K::Digit7,
+        K::Digit8,
+        K::Digit9,
+        K::Digit0,
+    ];
+    const FUNCTIONS: [K; 24] = [
+        K::F1,
+        K::F2,
+        K::F3,
+        K::F4,
+        K::F5,
+        K::F6,
+        K::F7,
+        K::F8,

+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::event::{MouseButton, WindowEvent};
+
+    fn mouse(buttons: u32, dx: i32, dy: i32, sampling: u64, connected: bool) -> ffi::HidMouseState {
+        ffi::HidMouseState {
+            sampling_number: sampling,
+            x: 100,
+            y: 60,
+            delta_x: dx,
+            delta_y: dy,
+            buttons,
+            attributes: if connected { ffi::HID_MOUSE_ATTRIBUTE_CONNECTED } else { 0 },
+            ..Default::default()
+        }
+    }
+
+    fn key_bits(usage: u8) -> [u64; 4] {
+        let mut keys = [0; 4];
+        keys[usize::from(usage) / 64] |= 1u64 << (usage & 63);
+        keys
+    }
+
+    #[test]
+    fn letters_follow_shift_and_caps() {
+        assert_eq!(printable(4, 0).as_deref(), Some("a"));
+        assert_eq!(printable(4, 2).as_deref(), Some("A"));
+        assert_eq!(printable(4, 1 << 8).as_deref(), Some("A"));
+        assert_eq!(printable(4, 2 | (1 << 8)).as_deref(), Some("a"));
+    }
+
+    #[test]
+    fn shifted_symbols() {
+        assert_eq!(printable(30, 2).as_deref(), Some("!"));
+        assert_eq!(printable(45, 2).as_deref(), Some("_"));
+        assert_eq!(printable(56, 2).as_deref(), Some("?"));
+    }
+
+    #[test]
+    fn numpad_digits_need_num_lock() {
+        assert_eq!(printable(89, 1 << 10).as_deref(), Some("1"));
+        assert_eq!(printable(89, 0), None);
+        assert_eq!(named(89), Some(N::End));
+    }
+
+    #[test]
+    fn modifiers_match_libnx_bits() {
+        assert_eq!(modifiers(1), ModifiersState::CONTROL);
+        assert_eq!(modifiers(2), ModifiersState::SHIFT);
+        assert_eq!(modifiers(4), ModifiersState::ALT);
+        assert_eq!(modifiers(8), ModifiersState::ALT);
+        assert_eq!(modifiers(16), ModifiersState::SUPER);
+    }
+
+    #[test]
+    fn first_mouse_report_resyncs_then_motion_and_clicks_flow() {
+        let id = crate::event::DeviceId::dummy();
+        let mut inputs = NativeInputs::new();
+        let mut out = PendingEvents::new();
+
+        inputs.mouse_report(id, false, &mut out, mouse(0, 0, 0, 1, true));
+        assert!(matches!(
+            out.pop_front(),
+            Some(Pending::Window(WindowEvent::CursorMoved { .. }))
+        ));
+        assert!(out.is_empty());
+        inputs.resync = false;
+
+        inputs.mouse_report(id, false, &mut out, mouse(1, 3, -2, 2, true));
+        assert!(matches!(
+            out.pop_front(),
+            Some(Pending::Device(_, DeviceEvent::MouseMotion { delta }))
+                if delta == (3.0, -2.0)
+        ));
+        assert!(matches!(
+            out.pop_front(),
+            Some(Pending::Window(WindowEvent::CursorMoved { .. }))
+        ));
+        assert!(matches!(
+            out.pop_front(),
+            Some(Pending::Window(WindowEvent::MouseInput {
+                state: ElementState::Pressed,
+                button: MouseButton::Left,
+                ..
+            }))
+        ));
+        assert!(out.is_empty());
+    }
+
+    #[test]
+    fn grabbed_mouse_keeps_raw_motion_but_not_the_cursor() {
+        let id = crate::event::DeviceId::dummy();
+        let mut inputs = NativeInputs::new();
+        inputs.connected = true;
+        inputs.resync = false;
+        let mut out = PendingEvents::new();
+
+        inputs.mouse_report(id, true, &mut out, mouse(0, 5, 5, 2, true));
+        assert!(matches!(
+            out.pop_front(),
+            Some(Pending::Device(_, DeviceEvent::MouseMotion { .. }))
+        ));
+        assert!(out.is_empty());
+    }
+
+    #[test]
+    fn disconnecting_a_held_mouse_releases_its_buttons() {
+        let id = crate::event::DeviceId::dummy();
+        let mut inputs = NativeInputs::new();
+        inputs.connected = true;
+        inputs.resync = false;
+        let mut out = PendingEvents::new();
+
+        inputs.mouse_report(id, false, &mut out, mouse(1, 0, 0, 2, true));
+        out.clear();
+        inputs.mouse_report(id, false, &mut out, mouse(0, 0, 0, 3, false));
+        assert!(matches!(
+            out.pop_front(),
+            Some(Pending::Window(WindowEvent::MouseInput {
+                state: ElementState::Released,
+                button: MouseButton::Left,
+                ..
+            }))
+        ));
+        assert!(out.is_empty());
+    }
+
+    #[test]
+    fn keyboard_press_and_release_carry_text_and_code() {
+        let id = crate::event::DeviceId::dummy();
+        let mut inputs = NativeInputs::new();
+        let mut out = PendingEvents::new();
+        let mut report = ffi::HidKeyboardState { sampling_number: 1, ..Default::default() };
+
+        report.keys = key_bits(26); // W
+        inputs.keyboard_report(id, &mut out, report);
+        match out.pop_front() {
+            Some(Pending::Window(WindowEvent::KeyboardInput { event, .. })) => {
+                assert_eq!(event.physical_key, PhysicalKey::Code(K::KeyW));
+                assert_eq!(event.state, ElementState::Pressed);
+                assert_eq!(event.text.as_deref(), Some("w"));
+                assert!(!event.repeat);
+                assert_eq!(event.logical_key, Key::Character(SmolStr::new("w")));
+            },
+            _ => panic!("expected a key press"),
+        }
+        assert!(out.is_empty());
+
+        report.sampling_number = 2;
+        report.keys = [0; 4];
+        inputs.keyboard_report(id, &mut out, report);
+        match out.pop_front() {
+            Some(Pending::Window(WindowEvent::KeyboardInput { event, .. })) => {
+                assert_eq!(event.physical_key, PhysicalKey::Code(K::KeyW));
+                assert_eq!(event.state, ElementState::Released);
+                assert_eq!(event.text, None);
+            },
+            _ => panic!("expected a key release"),
+        }
+    }
+
+    #[test]
+    fn shift_is_reported_before_its_key() {
+        let id = crate::event::DeviceId::dummy();
+        let mut inputs = NativeInputs::new();
+        let mut out = PendingEvents::new();
+        let mut report = ffi::HidKeyboardState {
+            sampling_number: 1,
+            modifiers: 2,
+            keys: key_bits(26), // Shift+W
+        };
+
+        inputs.keyboard_report(id, &mut out, report);
+        assert!(matches!(
+            out.pop_front(),
+            Some(Pending::Window(WindowEvent::ModifiersChanged(m)))
+                if m.state() == ModifiersState::SHIFT
+        ));
+        match out.pop_front() {
+            Some(Pending::Window(WindowEvent::KeyboardInput { event, .. })) => {
+                assert_eq!(event.text.as_deref(), Some("W"));
+                assert_eq!(event.logical_key, Key::Character(SmolStr::new("W")));
+                assert_eq!(
+                    event.platform_specific.key_without_modifiers,
+                    Key::Character(SmolStr::new("w"))
+                );
+            },
+            _ => panic!("expected Shift+W"),
+        }
+
+        report.sampling_number = 2;
+        report.modifiers = 0;
+        report.keys = [0; 4];
+        inputs.keyboard_report(id, &mut out, report);
+        assert!(matches!(
+            out.pop_front(),
+            Some(Pending::Window(WindowEvent::ModifiersChanged(m))) if m.state().is_empty()
+        ));
+    }
+}

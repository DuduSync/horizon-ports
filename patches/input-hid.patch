+        99 => K::NumpadDecimal,
+        100 => K::IntlBackslash,
+        101 => K::ContextMenu,
+        102 => K::Power,
+        103 => K::NumpadEqual,
+        104..=115 => FUNCTIONS[usize::from(usage - 104 + 12)],
+        133 => K::NumpadComma,
+        135 => K::IntlRo,
+        137 => K::IntlYen,
+        224 => K::ControlLeft,

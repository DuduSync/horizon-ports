+        84 => K::NumpadDivide,
+        85 => K::NumpadMultiply,
+        86 => K::NumpadSubtract,
+        87 => K::NumpadAdd,
+        88 => K::NumpadEnter,
+        89 => K::Numpad1,
+        90 => K::Numpad2,
+        91 => K::Numpad3,
